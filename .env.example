OPENAI_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
GTOP_GUILD_ID=
GTOP_MEMBER_ROLE_ID=
GTOP_OWNER_USER_ID=
GBOP_LIVE_MODEL=
GBOP_LIVE_VOICE=
GBOP_VOICE_BACKEND_MODEL=

# Read-only MT5 ingestion; leave blank until Windows bridge is configured.
GBOP_MARKET_BRIDGE_TOKEN=
## Emergency owner-only override. 0 leaves GBOP_ACCESS_MODE in control.
## Set to 1 only for the approved lockdown; uses GTOP_OWNER_USER_ID.
GBOP_OWNER_ONLY=0
# Rollout gate: existing (normal entitlement), owner, or pilot.
# Pilot IDs narrow existing role/activation/consent checks; they never grant access.
GBOP_ACCESS_MODE=existing
GBOP_PILOT_USER_IDS=
