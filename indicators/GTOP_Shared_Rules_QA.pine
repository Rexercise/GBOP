//@version=6
indicator("GTOP Shared Rules QA", overlay=true)
// Generated. Uses the actual Butterfly lifecycle functions and shared cases.
int historyKeep = 24
int autoLookback = 120
// BEGIN GENERATED GTOP RULES
// Generated from rules/gtop_rules.json. Do not edit this block.
string GTOP_RULESET_VERSION = "1.3.0"
string GTOP_RULESET_SHA256 = "2a9f4ec9b85b58f1c8103d8782ac4e696cee4277237195578148bc59a0af9980"

// GTOP-EVIDENCE-005; caller establishes confirmed timeframe and coverage.
f_gtop_chart_contiguous(int expected, int starts, int previous_close, int projected_open) =>
    (((starts == expected)) or (((previous_close == expected)) and ((projected_open == starts)) and ((starts > previous_close))))

// GTOP-RANGE-002; caller establishes confirmed timeframe and coverage.
f_gtop_inside(float c, float hi, float lo) =>
    ((lo < c) and (c < hi))

// GTOP-RANGE-003; caller establishes confirmed timeframe and coverage.
f_gtop_outside(float c, float hi, float lo) =>
    (((c > hi)) or ((c < lo)))

// GTOP-RANGE-002; caller establishes confirmed timeframe and coverage.
f_gtop_at_boundary(float c, float hi, float lo) =>
    (((c == hi)) or ((c == lo)))

// GTOP-RANGE-001; caller establishes confirmed timeframe and coverage.
f_gtop_purged(float h, float l, float level, bool buy_side) =>
    (buy_side ? ((h > level)) : ((l < level)))

// GTOP-MODEL1-001; caller establishes confirmed timeframe and coverage.
f_gtop_body_purge(float o, float h, float l, float c, float level, bool buy_side) =>
    (buy_side ? (((o <= level) and (level < c)) or ((l < level) and (level < o) and (o < c))) : (((c < level) and (level <= o)) or ((c < o) and (o < level) and (level < h))))

// GTOP-CISD-001; caller establishes confirmed timeframe and coverage.
f_gtop_cisd(float c, float model_hi, float model_lo, bool bearish) =>
    (bearish ? ((c < model_lo)) : ((c > model_hi)))

// GTOP-VARIANT-004; caller establishes confirmed timeframe and coverage.
f_gtop_inside_bar(float h, float l, float hi, float lo) =>
    (((h <= hi)) and ((l >= lo)))

// GTOP-VARIANT-V6-EXCLUSIVE; caller establishes confirmed timeframe and coverage.
f_gtop_v6_before_full(bool initial_return, bool swept_extreme, bool full_before, bool full_same_bar) =>
    (initial_return and swept_extreme and (not full_before) and (not full_same_bar))

// GTOP-SOUP-001; caller establishes confirmed timeframe and coverage.
f_gtop_soup_confirmation(float o, float h, float l, float c, float hi, float lo, bool bearish) =>
    (bearish ? (((h > hi)) and ((((lo < c) and (c < hi)) and ((l >= lo))) or (((lo < o) and (o < hi)) and ((c < lo))))) : (((l < lo)) and ((((lo < c) and (c < hi)) and ((h <= hi))) or (((lo < o) and (o < hi)) and ((c > hi))))))

// GTOP-SOUP-003; caller establishes confirmed timeframe and coverage.
f_gtop_adverse_extension(float h, float l, float hi, float lo, bool bearish) =>
    (bearish ? (((h > hi)) ? (h - hi) : 0.0) : (((l < lo)) ? (lo - l) : 0.0))

// GTOP-SOUP-003; caller establishes confirmed timeframe and coverage.
f_gtop_extension_percent(float points, float hi, float lo) =>
    (((hi > lo)) ? ((100.0 * points) / (hi - lo)) : 0.0)

f_gtop_assigned_tf(string sourceTF) =>
    switch sourceTF
        "1M" => "1D"
        "1W" => "240"
        "1D" => "60"
        "240" => "15"
        "60" => "5"
        => ""
// END GENERATED GTOP RULES

type ActiveRange
    float hi
    float lo
    int begins
    int ends
    int born
    string title
    bool highTaken = false
    bool lowTaken = false
    bool upperPurged = false
    bool lowerPurged = false
    bool closedBackInside = false
    string sourceTF = ""
    int retiredReason = 0
    int retiredAt = na
    bool objectiveAtRetirement = false
    bool outsideCloseAtRetirement = false
    int observedCandles = 1
    int insideBefore = 0
    int manipulationNumber = 0
    float manipulationHigh = na
    float manipulationLow = na
    bool manipulationInside = false
    bool midpointTaken = false
    bool resoup = false
    bool resoupPending = false
    bool deliverySourceClosed = true
    bool sameCandleV2 = false
    int doublePurgeAt = na
    bool oppositePurgePending = false
    int returnObjectiveAt = na
    bool followStopped = false
    bool h1Delivery = false
    bool forming = false
    int purgeOpen = na
    int purgeClose = na
    int returnOpen = na
    int returnClose = na
    float returnPrice = na
    int lastSourceOpen = na
    int lastSourceClose = na
    float lastSourcePrice = na
    int objectiveObservedAt = na
    string objectiveEvidenceTF = ""
    int invalidOpen = na
    int invalidAt = na

f_copy_range(ActiveRange r) =>
    // ActiveRange contains only scalar fields. Native copy preserves every
    // value in a new independent object; no nested reference can be shared.
    r.copy()

// Candle-ordered CRT structure. This never changes box eligibility. It does
// not infer intrabar event order, Model1/CSD, a Super Soup, or an entry.
f_variant_observe(ActiveRange r, float h, float l, float c) =>
    r.observedCandles += 1
    bool firstPurge = not r.upperPurged and not r.lowerPurged and (h > r.hi or l < r.lo)
    bool insideClose = f_gtop_inside(c, r.hi, r.lo)
    float middle = math.avg(r.hi, r.lo)
    if firstPurge
        r.manipulationNumber := r.observedCandles
        r.manipulationHigh := h
        r.manipulationLow := l
        r.manipulationInside := insideClose
        r.midpointTaken := h > r.hi ? l <= middle : h >= middle
    else if r.manipulationNumber == 0
        if f_gtop_inside_bar(h, l, r.hi, r.lo)
            r.insideBefore += 1
    else
        bool midNow = r.upperPurged ? l <= middle : h >= middle
        bool sweptManipulation = r.upperPurged ? h > r.manipulationHigh : l < r.manipulationLow
        bool objectiveTaken = r.upperPurged ? r.lowTaken : r.highTaken
        bool objectiveNow = r.upperPurged ? l <= r.lo : h >= r.hi
        // Midpoint is not the full objective. Same-bar re-purge + full objective
        // has unknown order, so it cannot newly qualify V6.
        if not r.resoup and f_gtop_v6_before_full(r.manipulationInside, sweptManipulation, objectiveTaken, objectiveNow)
            r.resoupPending := true
        if r.resoupPending and insideClose and not objectiveTaken and not objectiveNow
            r.resoup := true
            r.resoupPending := false
        r.midpointTaken := r.midpointTaken or midNow
    0

f_variant_codes(ActiveRange r, bool completed, bool firstFormingPurge = false) =>
    string codes = ""
    int observed = r.observedCandles + (firstFormingPurge ? 1 : 0)
    int manipulation = firstFormingPurge ? observed : r.manipulationNumber
    if r.sameCandleV2 and completed
        codes := "V2"
    else if r.manipulationInside or firstFormingPurge
        if r.insideBefore == 1
            codes := "V4"
        else if r.insideBefore >= 2
            codes := "V5"
        else if manipulation == 2
            codes := completed ? (observed == 3 ? "V1" : observed > 3 ? "V3" : "") : observed < 3 ? "V1/V3" : "V3"
        if r.resoup or r.resoupPending
            // An evidenced second purge makes only V6 eligible.
            codes := "V6"
    completed and r.resoupPending ? "" : codes

// Narrow OHLC proof for V2: candle 2 OPENS strictly inside, purges one edge,
// and CLOSES beyond the opposing target. The purge necessarily precedes that
// closing delivery. Gap opens and inside-closing two-sided bars stay unknown.
// V2 is completed history only; it never fabricates an active inside-close box.
f_v2_delivery(ActiveRange r, float o, float h, float l, float c) =>
    bool startsInside = o > r.lo and o < r.hi
    bool early = r.observedCandles == 1 and r.manipulationNumber == 0
    early and startsInside and ((h > r.hi and c < r.lo) or (l < r.lo and c > r.hi))

// 0 = remains (waiting or relevant), 1 = source-close invalidation,
// 2 = objective delivered or both sides reached in the activation candle.
// Objective tracking starts at the first strict purge, not before it.
// Equal-edge touches alone do not activate relevance. Same-bar two-sided
// action has no provably pending DOL; suppress it without inferring event order.
f_active_reason(ActiveRange r, float h, float l, float c) =>
    int reason = 0
    bool objectiveReached = r.closedBackInside and ((r.upperPurged and l <= r.lo) or (r.lowerPurged and h >= r.hi))
    if objectiveReached
        r.lowTaken := r.lowTaken or r.upperPurged
        r.highTaken := r.highTaken or r.lowerPurged
        reason := 2
    else if f_gtop_outside(c, r.hi, r.lo)
        reason := 1
    else if r.upperPurged
        r.lowTaken := r.lowTaken or l <= r.lo
        reason := r.lowTaken ? 2 : 0
    else if r.lowerPurged
        r.highTaken := r.highTaken or h >= r.hi
        reason := r.highTaken ? 2 : 0
    else if h > r.hi
        r.upperPurged := true
        r.highTaken := true
        r.lowTaken := l <= r.lo
        r.lowerPurged := l < r.lo
        reason := r.lowTaken ? 2 : 0
    else if l < r.lo
        r.lowerPurged := true
        r.lowTaken := true
        r.highTaken := h >= r.hi
        reason := r.highTaken ? 2 : 0
    if reason == 0 and (r.upperPurged or r.lowerPurged) and f_gtop_inside(c, r.hi, r.lo)
        r.closedBackInside := true
    reason

f_relevant(ActiveRange r) =>
    r.closedBackInside and ((r.upperPurged and not r.lowerPurged and not r.lowTaken) or (r.lowerPurged and not r.upperPurged and not r.highTaken))

// Observation only: latest traded price is inside; the source close is pending.
// Existing closed candidates alone supply identity/coverage. Equality never
// starts a purge, and a touch at the opposite edge removes a pending objective.
f_forming(ActiveRange r, float h, float l, float c) =>
    bool upper = r.upperPurged or h > r.hi
    bool lower = r.lowerPurged or l < r.lo
    not r.closedBackInside and r.retiredReason == 0 and f_gtop_inside(c, r.hi, r.lo) and ((upper and not lower and not r.lowTaken and l > r.lo) or (lower and not upper and not r.highTaken and h < r.hi))

f_archive(array<ActiveRange> retired, ActiveRange r, int reason, int closedAt, float h, float l, float c) =>
    if not na(retired)
        ActiveRange record = f_copy_range(r)
        record.retiredReason := reason
        record.retiredAt := closedAt
        record.objectiveAtRetirement := r.upperPurged ? l <= r.lo : h >= r.hi
        record.outsideCloseAtRetirement := not r.h1Delivery and f_gtop_outside(c, r.hi, r.lo)
        record.deliverySourceClosed := not r.h1Delivery
        if reason == 2
            record.objectiveObservedAt := closedAt
            record.objectiveEvidenceTF := r.h1Delivery ? "60" : r.sourceTF
        // Prior first purge is known; a strict opposite purge can be in the
        // delivery candle itself. Only this range's own close confirms it.
        if reason == 2 and not r.h1Delivery and r.closedBackInside and f_gtop_inside(c, r.hi, r.lo) and (r.upperPurged ? l < r.lo : h > r.hi)
            record.doublePurgeAt := closedAt
        if reason == 2 and not r.h1Delivery and r.closedBackInside and (r.upperPurged ? l < r.lo : h > r.hi)
            record.oppositePurgePending := true
        array.push(retired, record)
        if array.size(retired) > historyKeep
            array.shift(retired)
    0

// Follow completed ranges independently of active pending-DOL selection.
// A second, opposing STRICT breach is a distinct purge; merely touching the
// opposite objective completes delivery but is not yet a double purge.
f_follow_retired(array<ActiveRange> retired, float h, float l, float c, int tc, bool h1Evidence=false, int sourceStart=na) =>
    if not na(retired)
        for r in retired
            if r.retiredReason == 2 and not r.followStopped and tc >= r.retiredAt and not h1Evidence
                r.deliverySourceClosed := true
                r.lastSourceOpen := sourceStart
                r.lastSourceClose := tc
                r.lastSourcePrice := c
                bool inside = f_gtop_inside(c, r.hi, r.lo)
                if na(r.doublePurgeAt)
                    r.oppositePurgePending := r.oppositePurgePending or (r.upperPurged ? l < r.lo : h > r.hi)
                    if inside and r.oppositePurgePending
                        r.doublePurgeAt := tc
                else if tc > r.doublePurgeAt and (r.upperPurged ? h >= r.hi : l <= r.lo)
                    r.returnObjectiveAt := tc
                    r.followStopped := true
                if f_gtop_outside(c, r.hi, r.lo)
                    r.invalidOpen := sourceStart
                    r.invalidAt := tc
                    r.followStopped := true
    0

f_shift_observe(ActiveRange r, float o, float h, float l, float c, int tc, array<ActiveRange> retired, int sourceStart=na) =>
    r.lastSourceOpen := sourceStart
    r.lastSourceClose := tc
    r.lastSourcePrice := c
    if na(r.purgeClose) and (h > r.hi or l < r.lo)
        r.purgeOpen := sourceStart
        r.purgeClose := tc
    if not na(r.purgeClose) and na(r.returnClose) and f_gtop_inside(c, r.hi, r.lo)
        r.returnOpen := sourceStart
        r.returnClose := tc
        r.returnPrice := c
    if f_gtop_outside(c, r.hi, r.lo)
        r.invalidOpen := sourceStart
        r.invalidAt := tc
    bool wasQualified = f_relevant(r)
    bool v2Delivered = f_v2_delivery(r, o, h, l, c)
    // An unqualified, non-V2 candidate closing outside is discarded by every
    // caller. It cannot produce an archive; avoid updating its unused variant fields.
    int reason = 1
    if wasQualified or v2Delivered or not (f_gtop_outside(c, r.hi, r.lo))
        f_variant_observe(r, h, l, c)
        reason := f_active_reason(r, h, l, c)
        if v2Delivered
            r.sameCandleV2 := true
            r.upperPurged := c < r.lo
            r.lowerPurged := c > r.hi
            r.highTaken := true
            r.lowTaken := true
            reason := 2
        if reason != 0 and (wasQualified or v2Delivered)
            f_archive(retired, r, reason, tc, h, l, c)
    reason

f_active_step(array<ActiveRange> pool, float h, float l, float c, int s, int e, int seq, string title, array<ActiveRange> retired=na, string sourceTF="", float o=na) =>
    int i = array.size(pool) - 1
    while i >= 0
        ActiveRange r = array.get(pool, i)
        int reason = f_shift_observe(r, o, h, l, c, e, retired, s)
        if reason != 0 or seq - r.born >= autoLookback
            array.remove(pool, i)
        i -= 1
    f_follow_retired(retired, h, l, c, e, false, s)
    if h > l and s < e
        ActiveRange candidate = ActiveRange.new(h, l, s, e, seq, title, sourceTF=sourceTF)
        array.push(pool, candidate)
    0


f_case_edge_pending_bearish() =>
    ActiveRange r = ActiveRange.new(110, 90, 0, 1, 0, "QA")
    array<ActiveRange> history = array.new<ActiveRange>()
    int reason = f_shift_observe(r, 106, 112, 104, 110, 2, history)
    f_relevant(r) == false and (reason == 1) == false and r.resoup == false and r.resoupPending == false

