f_case_own_timeframe() =>
    ActiveRange r = ActiveRange.new(110, 90, 0, 1, 0, "H4", upperPurged=true, highTaken=true, closedBackInside=true, retiredReason=2, retiredAt=2, h1Delivery=true, deliverySourceClosed=false)
    array<ActiveRange> history = array.from(r)
    f_follow_retired(history, 109, 89, 106, 3, true)
    bool h1Ignored = na(r.doublePurgeAt) and not r.deliverySourceClosed
    f_follow_retired(history, 112, 88, 111, 4, true)
    bool h1CannotInvalidate = not r.followStopped
    f_follow_retired(history, 112, 88, 90, 5)
    bool edgePending = na(r.doublePurgeAt) and not r.followStopped
    f_follow_retired(history, 109, 94, 100, 6)
    h1Ignored and h1CannotInvalidate and edgePending and r.doublePurgeAt == 6 and r.deliverySourceClosed

f_case_delivery_candle_double_purge() =>
    ActiveRange r = ActiveRange.new(110, 90, 0, 1, 0, "H1")
    array<ActiveRange> history = array.new<ActiveRange>()
    f_shift_observe(r, 106, 112, 104, 106, 2, history)
    f_shift_observe(r, 106, 109, 89, 100, 3, history)
    array.size(history) == 1 and array.get(history, 0).doublePurgeAt == 3

string evidenceTF = "240"
int evidenceAnchor = 0
bool evidenceHistory = false
bool historyOn = false
string evidenceFocus = "Explicit parent layer"
string highestEvidenceTF = "240"
f_evidence_visible(ActiveRange r) =>
    r.retiredReason == 0 and (f_relevant(r) or r.forming)


f_evidence_range(array<ActiveRange> rows) =>
    ActiveRange chosen = na
    int bestRank = 100
    if not na(rows)
        for r in rows
            if r.sourceTF == evidenceTF and (evidenceFocus == "Explicit parent layer" or highestEvidenceTF != "" or evidenceHistory or evidenceAnchor != 0) and (evidenceAnchor == 0 or r.begins == evidenceAnchor) and (r.retiredReason == 0 or (historyOn and evidenceHistory))
                int rank = r.retiredReason == 0 and f_relevant(r) ? 0 : r.retiredReason == 0 and (r.upperPurged or r.lowerPurged) ? 1 : r.retiredReason != 0 ? 2 : 3
                if na(chosen) or rank < bestRank or rank == bestRank and (rank == 0 ? r.begins < chosen.begins : r.begins > chosen.begins)
                    chosen := r
                    bestRank := rank
    chosen

// Keep all available active parents in oldest-first order, up to the same
// existing per-layer limit (maximum eight). Explicit opening remains singular.
f_evidence_ranges(array<ActiveRange> rows) =>
    array<ActiveRange> selected = array.new<ActiveRange>()
    if not na(rows) and evidenceAnchor == 0
        for r in rows
            if r.sourceTF == evidenceTF and f_evidence_visible(r)
                int at = 0
                while at < array.size(selected)
                    if r.begins < array.get(selected, at).begins
                        break
                    at += 1
                array.insert(selected, at, r)
    if array.size(selected) == 0
        ActiveRange fallback = f_evidence_range(rows)
        if not na(fallback)
            array.push(selected, fallback)
    selected


f_case_active_before_history() =>
    ActiveRange old = ActiveRange.new(110, 90, 1, 2, 0, "Old", upperPurged=true, closedBackInside=true, sourceTF="240", retiredReason=1)
    ActiveRange active = ActiveRange.new(110, 90, 3, 4, 0, "Active", lowerPurged=true, closedBackInside=true, sourceTF="240")
    array<ActiveRange> rows = array.from(old, active)
    ActiveRange chosen = f_evidence_range(rows)
    chosen.begins == 3 and chosen.retiredReason == 0

type EvidenceCandle
    int s
    int e
    float o
    float h
    float l
    float c
    int previousClose = na
    int projectedOpen = na
    int tradingDay = na


f_assigned_evidence(ActiveRange r, array<EvidenceCandle> bars, int cutoff) =>
    EvidenceCandle model = na
    EvidenceCandle csd = na
    EvidenceCandle modelInvalid = na
    EvidenceCandle soup = na
    bool soupEligible = true
    bool continuous = true
    bool modelContinuous = true
    bool primaryCertain = false
    bool coveredStart = false
    bool bearish = r.upperPurged
    int expected = r.ends
    int observedThrough = na
    if not na(bars)
        for bar in bars
            if bar.s >= r.ends and bar.e <= cutoff and (na(r.invalidAt) or bar.e <= r.invalidAt)
                bool connected = f_gtop_chart_contiguous(expected, bar.s, bar.previousClose, bar.projectedOpen)
                coveredStart := coveredStart or (na(observedThrough) and connected)
                continuous := continuous and connected
                expected := bar.e
                observedThrough := bar.e
                if na(model) and (r.upperPurged != r.lowerPurged) and f_gtop_body_purge(bar.o, bar.h, bar.l, bar.c, bearish ? r.hi : r.lo, bearish)
                    model := bar
                    primaryCertain := coveredStart and continuous
                else if not na(model)
                    // A missing prefix limits first identity, not a witnessed
                    // CISD against this retained candle. A later gap still blocks.
                    modelContinuous := modelContinuous and connected
                    if continuous and na(soup) and na(csd) and na(modelInvalid) and soupEligible and f_gtop_soup_confirmation(bar.o, bar.h, bar.l, bar.c, model.h, model.l, bearish)
                        soup := bar
                    soupEligible := soupEligible and not (bearish ? bar.l < model.l : bar.h > model.h)
                    if modelContinuous and na(csd) and f_gtop_cisd(bar.c, model.h, model.l, bearish)
                        csd := bar
                    if modelContinuous and na(modelInvalid) and f_gtop_outside(bar.c, model.h, model.l)
                        modelInvalid := bar
    bool complete = coveredStart and continuous and not na(observedThrough) and observedThrough >= math.min(cutoff, nz(r.invalidAt, cutoff))
    [model, csd, modelInvalid, soup, primaryCertain, complete, observedThrough]

// Post-confirmation Soup condition is independent of Model 1 own-CRT validity.
// Fixed Soup extreme supplies the distance origin; original Model 1 height
// supplies the percentage scale. No tolerance or trade execution is inferred.
type SoupFollow
    string cleanliness = "clean"
    string functionStatus = "pending"
    float points = 0.0
    float percent = 0.0
    float modelPoints = 0.0
    float modelPercent = 0.0
    float closePoints = 0.0
    int outsideCloses = 0
    int degradedAt = na
    int repurgeOpen = na
    int equalTouchAt = na
    int targetOpen = na
    int targetAt = na
    int windowEnd = na
    bool complete = false
    bool terminalBound = false

f_soup_follow(ActiveRange r, EvidenceCandle model, EvidenceCandle soup, array<EvidenceCandle> bars, int cutoff, bool verified) =>
    SoupFollow q = SoupFollow.new()
    bool bearish = r.upperPurged
    float target = bearish ? r.lo : r.hi
    int stop = math.min(cutoff, nz(r.invalidAt, cutoff))
    if na(soup) or na(model) or not verified or model.h <= model.l or stop < soup.e
        q.cleanliness := "unverified"
        q.functionStatus := "unverified"
        q.points := na
        q.percent := na
        q.modelPoints := na
        q.modelPercent := na
        q.closePoints := na
        q.outsideCloses := na
    else
        q.windowEnd := soup.e
        bool earlierTarget = false
        for bar in bars
            if bar.s >= r.ends and bar.e <= soup.s and (bearish ? bar.l <= target : bar.h >= target)
                earlierTarget := true
        bool sameTarget = bearish ? soup.l <= target : soup.h >= target
        if earlierTarget
            q.functionStatus := "parent_objective_already_reached"
            q.complete := true
        else if sameTarget
            bool ordered = bearish ? soup.c <= target : soup.c >= target
            q.functionStatus := ordered ? "parent_objective_delivered" : "same_candle_order_unresolved"
            q.targetOpen := soup.s
            q.targetAt := soup.e
            q.complete := true
            q.terminalBound := not ordered
        else
            bool gap = false
            for bar in bars
                if bar.s >= soup.e and bar.e <= stop
                    if not f_gtop_chart_contiguous(q.windowEnd, bar.s, bar.previousClose, bar.projectedOpen)
                        gap := true
                        break
                    q.windowEnd := bar.e
                    float points = f_gtop_adverse_extension(bar.h, bar.l, soup.h, soup.l, bearish)
                    float modelPoints = f_gtop_adverse_extension(bar.h, bar.l, model.h, model.l, bearish)
                    bool hit = bearish ? bar.l <= target : bar.h >= target
                    if hit
                        q.targetOpen := bar.s
                        q.targetAt := bar.e
                        q.terminalBound := points > q.points or modelPoints > q.modelPoints
                    else
                        if points > 0 and na(q.degradedAt)
                            q.degradedAt := bar.e
                            q.repurgeOpen := bar.s
                        if (bearish ? bar.h == soup.h : bar.l == soup.l) and na(q.equalTouchAt)
                            q.equalTouchAt := bar.e
                        float closePoints = f_gtop_adverse_extension(bar.c, bar.c, model.h, model.l, bearish)
                        if closePoints > 0
                            q.outsideCloses += 1
                            q.closePoints := math.max(q.closePoints, closePoints)
                    q.points := math.max(q.points, points)
                    q.modelPoints := math.max(q.modelPoints, modelPoints)
                    if hit
                        break
            q.complete := not gap and (not na(q.targetAt) or q.windowEnd >= stop)
            q.functionStatus := not na(q.targetAt) ? "parent_objective_delivered" : not q.complete ? "unverified" : not na(r.invalidAt) and stop == r.invalidAt ? "parent_invalidated_before_delivery" : "pending"
            q.cleanliness := not na(q.degradedAt) ? "degraded" : q.complete and not q.terminalBound ? "clean" : "unverified"
            q.percent := f_gtop_extension_percent(q.points, model.h, model.l)
            q.modelPercent := f_gtop_extension_percent(q.modelPoints, model.h, model.l)
    q


f_case_child_failure_preserves_parent() =>
    ActiveRange parent = ActiveRange.new(110, 90, 0, 10, 0, "H4", upperPurged=true, closedBackInside=true, sourceTF="240")
    array<EvidenceCandle> bars = array.from(EvidenceCandle.new(10, 11, 109, 113, 108, 112), EvidenceCandle.new(11, 12, 112, 112, 107, 107))
    [model, csd, failed, soup, primary, complete, through] = f_assigned_evidence(parent, bars, 12)
    not na(model) and not na(csd) and not na(failed) and model.s == 10 and failed.e == 12 and primary and complete and na(parent.invalidAt) and parent.retiredReason == 0 and f_relevant(parent)

f_case_shared_model_independent_parents() =>
    ActiveRange a = ActiveRange.new(110, 90, 0, 10, 0, "A", lowerPurged=true, closedBackInside=true, sourceTF="240")
    ActiveRange b = ActiveRange.new(108, 92, 1, 10, 0, "B", lowerPurged=true, closedBackInside=true, sourceTF="240")
    array<EvidenceCandle> bars = array.from(EvidenceCandle.new(10, 11, 95, 96, 88, 89), EvidenceCandle.new(11, 12, 89, 100, 89, 98))
    [ma, ca, sa, soupA, pa, fa, ta] = f_assigned_evidence(a, bars, 12)
    [mb, cb, sb, soupB, pb, fb, tb] = f_assigned_evidence(b, bars, 12)
    array<ActiveRange> both = f_evidence_ranges(array.from(b, a))
    not na(ma) and not na(mb) and ma.s == mb.s and ca.s == cb.s and sa.s == sb.s and a.hi != b.hi and f_relevant(a) and f_relevant(b) and na(a.invalidAt) and na(b.invalidAt) and array.size(both) == 2 and array.first(both).begins == 0

f_case_calendar_closure_and_missing_row() =>
    ActiveRange parent = ActiveRange.new(110, 90, 0, 10, 0, "Monthly", upperPurged=true, forming=true, sourceTF="1M")
    array<EvidenceCandle> bars = array.from(EvidenceCandle.new(12, 13, 109, 113, 108, 112, 10, 12), EvidenceCandle.new(15, 16, 112, 112, 107, 107, 13, 15))
    [model, csd, failed, soup, primary, complete, through] = f_assigned_evidence(parent, bars, 16)
    bool closureOK = not na(model) and not na(csd) and not na(failed) and primary and complete and csd.s == 15 and failed.e == 16 and parent.forming and not parent.closedBackInside and na(parent.invalidAt)
    array<EvidenceCandle> brokenBars = array.copy(bars)
    EvidenceCandle broken = array.get(bars, 1).copy()
    broken.previousClose := 14
    array.set(brokenBars, 1, broken)
    [m2, c2, s2, soup2, p2, f2, t2] = f_assigned_evidence(parent, brokenBars, 16)
    closureOK and not na(m2) and p2 and not f2 and na(c2) and na(s2)

f_case_retained_model_cisd(bool bearish) =>
    ActiveRange parent = ActiveRange.new(110, 90, 0, 10, 0, "Daily", upperPurged=bearish, lowerPurged=not bearish, forming=true, sourceTF="1D")
    EvidenceCandle model = bearish ? EvidenceCandle.new(12, 13, 109, 113, 108, 112) : EvidenceCandle.new(12, 13, 91, 92, 87, 88)
    EvidenceCandle confirm = bearish ? EvidenceCandle.new(13, 14, 112, 112, 106, 107) : EvidenceCandle.new(13, 14, 88, 94, 88, 93)
    array<EvidenceCandle> bars = array.from(model, confirm)
    [m, c, failed, soup, primary, complete, through] = f_assigned_evidence(parent, bars, 14)
    bool observed = not na(c) and not na(failed) and c.s == 13 and not primary and not complete and na(soup) and na(parent.invalidAt)
    [m0, c0, f0, s0, p0, full0, t0] = f_assigned_evidence(parent, bars, 13)
    bool closedOnly = not na(m0) and na(c0) and na(f0)
    EvidenceCandle equal = confirm.copy()
    equal.c := bearish ? model.l : model.h
    array<EvidenceCandle> equalBars = array.from(model.copy(), equal)
    [m1, c1, f1, s1, p1, full1, t1] = f_assigned_evidence(parent, equalBars, 14)
    bool equalityPending = na(c1) and na(f1)
    EvidenceCandle gap = confirm.copy()
    gap.s := 14
    gap.e := 15
    array<EvidenceCandle> gapBars = array.from(model.copy(), gap)
    [m2, c2, f2, s2, p2, full2, t2] = f_assigned_evidence(parent, gapBars, 15)
    observed and closedOnly and equalityPending and na(c2) and na(f2)

