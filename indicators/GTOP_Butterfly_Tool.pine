string G_ALERTS = "9ate8 observations and alerts"
// observeEight detail: Observes 9 AM-noon and 9 PM-midnight only. A sweep means price exceeded a range extreme. Invalidation requires a completed hourly candle closing strictly outside the 8 o'clock range. Monitoring that range then stops for the shift. No automatic roll to 9/10/11, variant claim, CSD, or entry signal.
bool observeEight = input.bool(true, "Observe 8 AM / 8 PM range during its next shift", group=G_ALERTS, tooltip="Observe 9–12 AM/PM. Strict breach sweeps; strict outside hourly close invalidates the 8 range and ends its shift tracking. No automatic roll, variant, CISD or entry signal.")
bool showFocus = input.bool(false, "Compact latest-bar 9ate8 status card", group=G_ALERTS, tooltip="The card reports the latest chart bar, including Bar Replay. It does not follow the crosshair or your scrolled historical viewport.")
// Create an alert from this indicator's named conditions in TradingView.
// Use Once Per Bar for sweeps, and Once Per Bar Close for hourly invalidation.
// A 1m/5m chart gives prompt observations. Higher charts deliver alerts at their
// update/close cadence; the hourly-close rule itself still uses hour boundaries.
// On a developing higher-timeframe chart, the final returned intrabar is
// conservatively confirmed only once a later intrabar arrives (up to one sample
// of latency). Wall-clock time alone never confirms a delayed-feed candle.

// Context is explicitly selected, never inferred as a directional trade thesis.
string G_CONTEXT = "Gray higher-timeframe context"
string contextSource = input.string("Off", "Gray context range", options=["Off", "Previous day", "Previous week", "Previous month", "Manual bounds"], group=G_CONTEXT)
color contextColor = input.color(color.rgb(145, 145, 145), "Gray box", group=G_CONTEXT)
int contextFade = input.int(85, "Gray box transparency", minval=0, maxval=100, group=G_CONTEXT)
float manualHigh = input.float(0, "Manual context high", group=G_CONTEXT)
float manualLow = input.float(0, "Manual context low", group=G_CONTEXT)
int manualStart = input.int(0, "Manual context starts (Unix ms; 0 = off)", group=G_CONTEXT)

string G_TARGET = "Draw on liquidity (manual)"
string targetSide = input.string("Off", "Liquidity objective", options=["Off", "High (buy-side)", "Low (sell-side)"], group=G_TARGET, tooltip="Choose the side from your own analysis. The eye marks an objective, not an entry signal. Default Off avoids inventing a directional thesis.")
string targetSource = input.string("Gray context", "Objective range", options=["Gray context", "8 AM", "8 PM", "CBDR 2-8 PM", "GCT / New York AM 9 AM-1 PM", "Asia Expansion 1-5 AM", "London Lunch 5-9 AM", "New York PM 1-5 PM", "CBDR + Early Asia 5-9 PM", "Asia Open 9 PM-1 AM", "Monday"], group=G_TARGET, tooltip="For an intraday source, enable that range's box. Only completed, non-PARTIAL ranges can supply an objective. A newly forming range does not produce a target.")
color targetColor = input.color(color.rgb(65, 65, 65), "Objective eye color", group=G_TARGET)
int targetHours = input.int(4, "Objective line ahead (hours)", minval=1, maxval=48, group=G_TARGET)

// Declared after the established settings; belongs to the Butterfly context group.
int higherLayerCount = input.int(3, "Higher timeframe layers", minval=0, maxval=11, group=G_AUTO, tooltip="Butterfly context only. Number of strictly higher ladder sources in addition to the current chart source. H1 with 3 shows H4, D1 and W1; 4 also adds Monthly. Zero shows only the current source. The ladder stops at 12M.", active=autoScope == "Butterfly context")

// Added after established inputs to preserve their IDs and saved values.
// Fixed calendar reference: these choices never roll forward at midnight.
// recentReferenceDate detail: Fixed date in the GTOP timezone. The initial value is 2026-10-08, not a moving Today. Set this to the latest day you want to annotate. The rows apply to this date and the previous two CALENDAR dates, including weekends. They stay on those dates until you edit this field. Default preserves your existing bias settings; Bullish, Bearish and Neutral override only that one session.
string recentReferenceDate = input.string("2026-10-08", "Three-day ribbon | Reference date (YYYY-MM-DD)", group=G_RIBBON_ADV, display=display.none, tooltip="Fixed NY date, initially 2026-10-08; never rolls. Rows cover this and two prior calendar dates, including weekends. Default retains bias; other choices override only that session.")
string recent0Day = input.string("Default", "Reference day | Dayshift", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent0shifts", group=G_RIBBON_ADV, display=display.none, tooltip="Reference day, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent0Night = input.string("Default", "Nightshift", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent0shifts", group=G_RIBBON_ADV, display=display.none, tooltip="Reference day, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent0Early = input.string("Default", "Reference day | Human 00–09", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent0human", group=G_RIBBON_ADV, display=display.none, tooltip="Reference day, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent0Off = input.string("Default", "Human 12–21", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent0human", group=G_RIBBON_ADV, display=display.none, tooltip="Reference day, in the GTOP timezone. Dayshift 09:00–12:00; Nightshift 21:00–24:00; Human Max 00:00–09:00 and 12:00–21:00. Default keeps the existing bias for this occurrence. Neutral explicitly uses its neutral session fill. Only the selected occurrence changes.")
string recent1Day = input.string("Default", "Previous day | Dayshift", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent1shifts", group=G_RIBBON_ADV, display=display.none, tooltip="Previous day, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent1Night = input.string("Default", "Nightshift", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent1shifts", group=G_RIBBON_ADV, display=display.none, tooltip="Previous day, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent1Early = input.string("Default", "Previous day | Human 00–09", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent1human", group=G_RIBBON_ADV, display=display.none, tooltip="Previous day, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent1Off = input.string("Default", "Human 12–21", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent1human", group=G_RIBBON_ADV, display=display.none, tooltip="Previous day, in the GTOP timezone. Dayshift 09:00–12:00; Nightshift 21:00–24:00; Human Max 00:00–09:00 and 12:00–21:00. Default keeps the existing bias for this occurrence. Neutral explicitly uses its neutral session fill. Only the selected occurrence changes.")
string recent2Day = input.string("Default", "Two days earlier | Dayshift", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent2shifts", group=G_RIBBON_ADV, display=display.none, tooltip="Two days earlier, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent2Night = input.string("Default", "Nightshift", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent2shifts", group=G_RIBBON_ADV, display=display.none, tooltip="Two days earlier, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent2Early = input.string("Default", "Two days earlier | Human 00–09", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent2human", group=G_RIBBON_ADV, display=display.none, tooltip="Two days earlier, GTOP timezone. Day 09–12; Night 21–24; Human Max 00–09/12–21. Default retains bias; Neutral uses neutral fill. Only this occurrence changes.")
string recent2Off = input.string("Default", "Human 12–21", options=["Default", "Bullish", "Bearish", "Neutral"], inline="recent2human", group=G_RIBBON_ADV, display=display.none, tooltip="Two days earlier, in the GTOP timezone. Dayshift 09:00–12:00; Nightshift 21:00–24:00; Human Max 00:00–09:00 and 12:00–21:00. Default keeps the existing bias for this occurrence. Neutral explicitly uses its neutral session fill. Only the selected occurrence changes.")

// Fixed-box variant only: a manual context needs both time boundaries.
int manualEnd = input.int(0, "Manual context ends (Unix ms; 0 = off)", group=G_CONTEXT, tooltip="Required for Manual bounds in this fixed-box variant. Enter a time after the manual start; the box stops here instead of extending to current price.")

// New input follows all existing declarations to preserve their ordinal IDs.
bool rangeStatusOn = input.bool(false, "Show evaluation status", group=G_QUICK, tooltip="Optional evaluated range-count badge. Off by default for clean screenshots; range boxes, titles and DOLs are unaffected. Genuine coverage/configuration warnings remain visible. Appears after calculation, not while loading.")
color rangeLabelTextColor = input.color(color.rgb(0, 0, 0), "Range label text color", group=G_QUICK, tooltip="Text color for every range title and its variant/status. DOL lines, eyes, box borders, ribbons and sticky notes keep their own colors.")

// Append new settings after all prior inputs to retain their ordinal IDs.
string stickyAlign = input.string("Right", "Note text alignment", options=["Right", "Left", "Center"], group=G_MARK, tooltip="Align text inside the sticky note. Use Note position to move the note around the chart.")

// Append after established inputs so existing saved settings keep their IDs.
color rangeGuideColor = input.color(color.rgb(0, 0, 0), "Range borders, connectors and DOL color", group=G_QUICK, tooltip="Color for all price-range borders, caption connectors, source-edge accents and automatic/manual DOL lines. Defaults to black on every timeframe.")

// Simple date-specific ribbon annotation. Existing dated rows stay under Advanced.
// Empty date is inactive so updating the script preserves existing annotations.
// ribbonDateText detail: One fixed date in the GTOP timezone. Choose the named shift below; no dot matching is needed. Blank leaves saved annotations unchanged. This date never rolls forward. Editing it intentionally moves this dated row; retain additional dates in Advanced ribbon colors or saved chart-picked annotations. Default preserves the underlying annotation; named choices affect only this date. Saved chart-picked annotations keep priority on overlap; set their slot Off to replace them.
string ribbonDateText = input.string("", "Shift date (YYYY-MM-DD)", group=G_DATED_SHIFT, display=display.none, tooltip="Fixed NY date and named shift; blank preserves saved annotations. Editing moves this dated row. Default retains underlying color. Saved chart-picked slots win overlaps; set them Off to replace.")
string ribbonDayChoice = input.string("Neutral", "Dayshift · 09–12", options=["Default", "Bullish", "Bearish", "Neutral", "Custom"], inline="datedDay", group=G_DATED_SHIFT, display=display.none)
string ribbonNightChoice = input.string("Neutral", "Nightshift · 21–24", options=["Default", "Bullish", "Bearish", "Neutral", "Custom"], inline="datedNight", group=G_DATED_SHIFT, display=display.none)

// H4 source follows existing inputs; the deferred Soup toggle has been removed.
// h4Source detail: Default: fixed New York windows 01–05, 05–09, 09–13, 13–17, 17–21 and 21–01. Chart H4: use this symbol's native TradingView four-hour candle boundaries, including shortened session candles. Applies to automatic H4 ranges, variants and source-candle H4 manual anchors. The time ribbon always keeps the GTOP schedule. Both modes require covered closed hourly evidence; developing candles do not confirm variants.
string h4Source = input.string("GTOP 1/5/9 NY", "H4 source", options=["GTOP 1/5/9 NY", "Chart H4"], group=G_QUICK, tooltip="GTOP NY: 01–05/05–09/09–13/13–17/17–21/21–01. Chart H4 uses native symbol candles. Controls H4 ranges and manual source anchors; ribbon stays GTOP. Covered closed-hour evidence required.")
bool h4ChartMode = h4Source == "Chart H4"

// Chart-picked annotations are appended to preserve every saved input ID.
// Off is non-destructive. Timestamps are fixed; no rolling Today dates.
// shiftPoint1 detail: Place dot 1 just above the ribbon block you want to color, then choose Shift 1 color below. To move it later, select GTOP Butterfly and drag the dot. Its horizontal position selects one fixed shift; its height does not affect the color. Off leaves the shift unchanged. Reset points repositions all six dots. Uses the GTOP timezone: Day 09–12, Night 21–24, Human Max 00–09 or 12–21. Highest numbered active slot wins overlaps.
int shiftPoint1 = input.time(0, "Shift 1 dot", inline="shiftDot1", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag horizontally to choose a fixed NY shift. Height only places the handle. Off preserves color; highest active slot wins. Reset moves all six. Day 09–12; Night 21–24; Human Max otherwise.")
string shiftChoice1 = input.string("Off", "Shift 1 color", options=["Off", "Bullish", "Bearish", "Neutral", "Custom"], inline="shiftPick1", group=G_SHIFT_LEGACY, display=display.none)
color shiftColor1 = input.color(color.rgb(220, 232, 186), "Custom", inline="shiftPick1", group=G_SHIFT_LEGACY, display=display.none, active=shiftChoice1 == "Custom", tooltip="Custom uses this swatch. Bullish, Bearish and Neutral use your existing palette. Ribbon transparency still applies. Each slot recolors one occurrence only; the optional H4 row is unchanged.")
// shiftPoint2 detail: Place dot 2 just above the ribbon block you want to color, then choose Shift 2 color below. To move it later, select GTOP Butterfly and drag the dot. Its horizontal position selects one fixed shift; its height does not affect the color. Off leaves the shift unchanged. Reset points repositions all six dots. Uses the GTOP timezone: Day 09–12, Night 21–24, Human Max 00–09 or 12–21. Highest numbered active slot wins overlaps.
int shiftPoint2 = input.time(0, "Shift 2 dot", inline="shiftDot2", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag horizontally to choose a fixed NY shift. Height only places the handle. Off preserves color; highest active slot wins. Reset moves all six. Day 09–12; Night 21–24; Human Max otherwise.")
string shiftChoice2 = input.string("Off", "Shift 2 color", options=["Off", "Bullish", "Bearish", "Neutral", "Custom"], inline="shiftPick2", group=G_SHIFT_LEGACY, display=display.none)
color shiftColor2 = input.color(color.rgb(220, 232, 186), "Custom", inline="shiftPick2", group=G_SHIFT_LEGACY, display=display.none, active=shiftChoice2 == "Custom", tooltip="Custom uses this swatch. Bullish, Bearish and Neutral use your existing palette. Ribbon transparency still applies. Each slot recolors one occurrence only; the optional H4 row is unchanged.")
// shiftPoint3 detail: Place dot 3 just above the ribbon block you want to color, then choose Shift 3 color below. To move it later, select GTOP Butterfly and drag the dot. Its horizontal position selects one fixed shift; its height does not affect the color. Off leaves the shift unchanged. Reset points repositions all six dots. Uses the GTOP timezone: Day 09–12, Night 21–24, Human Max 00–09 or 12–21. Highest numbered active slot wins overlaps.
int shiftPoint3 = input.time(0, "Shift 3 dot", inline="shiftDot3", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag horizontally to choose a fixed NY shift. Height only places the handle. Off preserves color; highest active slot wins. Reset moves all six. Day 09–12; Night 21–24; Human Max otherwise.")
string shiftChoice3 = input.string("Off", "Shift 3 color", options=["Off", "Bullish", "Bearish", "Neutral", "Custom"], inline="shiftPick3", group=G_SHIFT_LEGACY, display=display.none)
color shiftColor3 = input.color(color.rgb(220, 232, 186), "Custom", inline="shiftPick3", group=G_SHIFT_LEGACY, display=display.none, active=shiftChoice3 == "Custom", tooltip="Custom uses this swatch. Bullish, Bearish and Neutral use your existing palette. Ribbon transparency still applies. Each slot recolors one occurrence only; the optional H4 row is unchanged.")
// shiftPoint4 detail: Place dot 4 just above the ribbon block you want to color, then choose Shift 4 color below. To move it later, select GTOP Butterfly and drag the dot. Its horizontal position selects one fixed shift; its height does not affect the color. Off leaves the shift unchanged. Reset points repositions all six dots. Uses the GTOP timezone: Day 09–12, Night 21–24, Human Max 00–09 or 12–21. Highest numbered active slot wins overlaps.
int shiftPoint4 = input.time(0, "Shift 4 dot", inline="shiftDot4", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag horizontally to choose a fixed NY shift. Height only places the handle. Off preserves color; highest active slot wins. Reset moves all six. Day 09–12; Night 21–24; Human Max otherwise.")
string shiftChoice4 = input.string("Off", "Shift 4 color", options=["Off", "Bullish", "Bearish", "Neutral", "Custom"], inline="shiftPick4", group=G_SHIFT_LEGACY, display=display.none)
color shiftColor4 = input.color(color.rgb(220, 232, 186), "Custom", inline="shiftPick4", group=G_SHIFT_LEGACY, display=display.none, active=shiftChoice4 == "Custom", tooltip="Custom uses this swatch. Bullish, Bearish and Neutral use your existing palette. Ribbon transparency still applies. Each slot recolors one occurrence only; the optional H4 row is unchanged.")
// shiftPoint5 detail: Place dot 5 just above the ribbon block you want to color, then choose Shift 5 color below. To move it later, select GTOP Butterfly and drag the dot. Its horizontal position selects one fixed shift; its height does not affect the color. Off leaves the shift unchanged. Reset points repositions all six dots. Uses the GTOP timezone: Day 09–12, Night 21–24, Human Max 00–09 or 12–21. Highest numbered active slot wins overlaps.
int shiftPoint5 = input.time(0, "Shift 5 dot", inline="shiftDot5", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag horizontally to choose a fixed NY shift. Height only places the handle. Off preserves color; highest active slot wins. Reset moves all six. Day 09–12; Night 21–24; Human Max otherwise.")
string shiftChoice5 = input.string("Off", "Shift 5 color", options=["Off", "Bullish", "Bearish", "Neutral", "Custom"], inline="shiftPick5", group=G_SHIFT_LEGACY, display=display.none)
color shiftColor5 = input.color(color.rgb(220, 232, 186), "Custom", inline="shiftPick5", group=G_SHIFT_LEGACY, display=display.none, active=shiftChoice5 == "Custom", tooltip="Custom uses this swatch. Bullish, Bearish and Neutral use your existing palette. Ribbon transparency still applies. Each slot recolors one occurrence only; the optional H4 row is unchanged.")
// shiftPoint6 detail: Place dot 6 just above the ribbon block you want to color, then choose Shift 6 color below. To move it later, select GTOP Butterfly and drag the dot. Its horizontal position selects one fixed shift; its height does not affect the color. Off leaves the shift unchanged. Reset points repositions all six dots. Uses the GTOP timezone: Day 09–12, Night 21–24, Human Max 00–09 or 12–21. Highest numbered active slot wins overlaps.
int shiftPoint6 = input.time(0, "Shift 6 dot", inline="shiftDot6", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag horizontally to choose a fixed NY shift. Height only places the handle. Off preserves color; highest active slot wins. Reset moves all six. Day 09–12; Night 21–24; Human Max otherwise.")
string shiftChoice6 = input.string("Off", "Shift 6 color", options=["Off", "Bullish", "Bearish", "Neutral", "Custom"], inline="shiftPick6", group=G_SHIFT_LEGACY, display=display.none)
color shiftColor6 = input.color(color.rgb(220, 232, 186), "Custom", inline="shiftPick6", group=G_SHIFT_LEGACY, display=display.none, active=shiftChoice6 == "Custom", tooltip="Custom uses this swatch. Bullish, Bearish and Neutral use your existing palette. Ribbon transparency still applies. Each slot recolors one occurrence only; the optional H4 row is unchanged.")
// Paired dot heights are display handles only; saved time/color inputs retain their IDs.
float shiftDotHeight1 = input.price(0, "Height", inline="shiftDot1", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag the dot above its shift to keep the handle visible. Horizontal position chooses the shift; height is cosmetic and needs no manual entry.")
float shiftDotHeight2 = input.price(0, "Height", inline="shiftDot2", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag the dot above its shift to keep the handle visible. Horizontal position chooses the shift; height is cosmetic and needs no manual entry.")
float shiftDotHeight3 = input.price(0, "Height", inline="shiftDot3", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag the dot above its shift to keep the handle visible. Horizontal position chooses the shift; height is cosmetic and needs no manual entry.")
float shiftDotHeight4 = input.price(0, "Height", inline="shiftDot4", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag the dot above its shift to keep the handle visible. Horizontal position chooses the shift; height is cosmetic and needs no manual entry.")
float shiftDotHeight5 = input.price(0, "Height", inline="shiftDot5", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag the dot above its shift to keep the handle visible. Horizontal position chooses the shift; height is cosmetic and needs no manual entry.")
float shiftDotHeight6 = input.price(0, "Height", inline="shiftDot6", group=G_SHIFT_LEGACY, display=display.none, confirm=false, tooltip="Drag the dot above its shift to keep the handle visible. Horizontal position chooses the shift; height is cosmetic and needs no manual entry.")
// Append the new input to preserve saved IDs; inline places it beside Time ribbon.
// customShiftColors detail: Time ribbon shows or hides the ribbon. Uncheck Custom shift colors to return every Day, Night and Human Max block to its neutral palette in one step. This bypasses dated, saved chart-picked and recurring shift choices. Check it again to restore your saved choices; they are not erased. Dot positions, the optional H4 row and range colors are unchanged.
bool customShiftColors = input.bool(true, "Custom shift colors", inline="ribbonQuick", group=G_QUICK, tooltip="Off restores neutral shift colors; on restores saved choices. Dated, chart-picked and recurring choices remain saved. Dots, H4 ribbon and range colors are unchanged.")
var array<int> shiftPoints = array.from(shiftPoint1, shiftPoint2, shiftPoint3, shiftPoint4, shiftPoint5, shiftPoint6)
var array<string> shiftChoices = array.from(shiftChoice1, shiftChoice2, shiftChoice3, shiftChoice4, shiftChoice5, shiftChoice6)
var array<color> shiftColors = array.from(shiftColor1, shiftColor2, shiftColor3, shiftColor4, shiftColor5, shiftColor6)

// SHARED EVIDENCE VIEW — appended inputs preserve previous input ordering.
string G_EVIDENCE = "GBOP knows · Butterfly shows"
bool evidenceOn = input.bool(true, "Show price-reading evidence", group=G_QUICK, tooltip="Summary panel only. Candle callouts, range boxes and an independently enabled capture keep working when this panel is hidden.")
string evidenceTFChoice = input.timeframe("240", "Explicit parent layer", options=["3", "5", "15", "60", "240", "1D", "1W", "1M", "3M", "6M", "12M"], group=G_EVIDENCE, tooltip="Uses an already selected analysis layer. H4 uses the existing H4 source choice. No additional parent layers are silently enabled.")
int evidenceAnchor = input.int(0, "Exact range opening (Unix ms; 0 = automatic)", group=G_EVIDENCE, tooltip="Automatic keeps the oldest confirmed relevant range, then a developing range, then recent history. An explicit opening never silently switches ranges.")
bool evidenceMarkers = input.bool(true, "Mark the key evidence candles", group=G_QUICK, tooltip="Hide all candle callouts together; individual choices are remembered. Model 1, CISD and Super Soup below control each type. Panel, ranges and objectives stay independent.")
// contextAlerts detail: Exports actual TradingView closed candles, selected range and Butterfly interpretation. Create an alert using Any alert() function call, then paste its message into GBOP's Read my Butterfly chart panel. Captures do not update GBOP automatically. Changing script settings requires recreating the alert.
bool contextAlerts = input.bool(false, "Export chart evidence in alert messages", group=G_EVIDENCE, tooltip="Export closed chart evidence with Any alert() function call; paste into GBOP Read my Butterfly chart. No automatic GBOP refresh. Recreate alerts after settings change.")

// New event inputs follow existing inputs to preserve their ordering.
bool evidenceModel = input.bool(true, "Model 1", inline="quickEvidenceEvents", group=G_QUICK, tooltip="Show or hide Model 1 candle callouts only. Evidence-panel status and CISD/Super Soup choices stay independent.")
bool evidenceCisd = input.bool(true, "CISD", inline="quickEvidenceEvents", group=G_QUICK, tooltip="Show or hide CISD confirmation callouts only. Evidence-panel status and the other callout choices stay independent.")
bool evidenceSoup = input.bool(true, "Super Soup", inline="quickEvidenceEvents", group=G_QUICK, tooltip="Show established Super Soup callouts: proven Model 1 purge/return or ordered same-candle delivery. Outside close alone is not Soup. Panel and validity remain independent.")

// Highest active enabled layer; oldest-first priority remains within that layer.
// evidenceFocus detail: On H1, lead with the visible hourly shift ranges and their variants; M5 remains their assigned execution timeframe. Other charts follow their assigned parent when available, then the highest mapped context. Daily charts retain monthly detail. Higher context is summarized below; hover for full ranges. Highest relevant timeframe and Explicit parent layer override automatic focus. Simultaneous parents keep independent states; history is opt-in.
string evidenceFocus = input.string("Chart parent detail", "Evidence focus", options=["Chart parent detail", "Highest relevant timeframe", "Explicit parent layer"], group=G_EVIDENCE, tooltip="H1 prioritizes hourly shift range/variant with M5 evidence; D1 keeps monthly detail. Other charts use assigned parent, then highest mapped layer. Hover for context. Overrides select another focus.")
bool evidenceHistory = input.bool(false, "Review historical evidence", group=G_EVIDENCE, active=historyOn, tooltip="Requires History. Shows retired detail for an explicit opening, or an explicit layer with no active range. Off excludes historical evidence/callouts; box History is separate.")

// Appended inputs retain all existing input ordinals, including saved dots.
string ribbonEarlyChoice = input.string("Default", "Human Max · 00–09", options=["Default", "Bullish", "Bearish", "Neutral", "Custom"], inline="datedEarly", group=G_DATED_SHIFT, display=display.none)
string ribbonLateChoice = input.string("Default", "Human Max · 12–21", options=["Default", "Bullish", "Bearish", "Neutral", "Custom"], inline="datedLate", group=G_DATED_SHIFT, display=display.none)
color ribbonDayCustom = input.color(color.rgb(220, 232, 186), "Custom", inline="datedDay", group=G_DATED_SHIFT, active=ribbonDayChoice == "Custom")
color ribbonNightCustom = input.color(color.rgb(220, 232, 186), "Custom", inline="datedNight", group=G_DATED_SHIFT, active=ribbonNightChoice == "Custom")
color ribbonEarlyCustom = input.color(color.rgb(220, 232, 186), "Custom", inline="datedEarly", group=G_DATED_SHIFT, active=ribbonEarlyChoice == "Custom")
color ribbonLateCustom = input.color(color.rgb(220, 232, 186), "Custom", inline="datedLate", group=G_DATED_SHIFT, active=ribbonLateChoice == "Custom")

// Append to preserve all saved input IDs and note text.
string stickyPosition = input.string("Top center", "Note position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=G_MARK, tooltip="Pins notes to one of nine chart positions. Other panels move aside when needed. Background defaults to 0% opacity.")
bool spotlightOn = input.bool(false, "Range spotlight", inline="spotlight", group=G_QUICK, tooltip="Number the panel ranges and highlight one matching title and box. Range boxes still controls drawings. Selection follows the current panel order as ranges change.")
int spotlightNumber = input.int(1, "Range number", minval=1, maxval=88, inline="spotlight", group=G_QUICK, active=spotlightOn, tooltip="Choose the bracketed number beside a panel range. Unavailable numbers highlight nothing. The chosen eligible box gets priority within the drawing limit.")

f_evidence_needed(bool panel, bool markers, bool parentEvent, bool modelEvent, bool cisdEvent, bool soupEvent, bool capture) =>
    panel or capture or (markers and (parentEvent or modelEvent or cisdEvent or soupEvent))

bool evidenceNeeded = spotlightOn or f_evidence_needed(evidenceOn, evidenceMarkers, false, evidenceModel, evidenceCisd, evidenceSoup, contextAlerts)
// Drawing visibility must not turn off the source state used by evidence.
bool rangeAnalysisNeeded = autoOn or evidenceNeeded or spotlightOn

// CLOCK HELPERS --------------------------------------------------------------
f_day(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0)

f_stamp(int anchor, int dayOffset, int clockHour) =>
    timestamp(TZ, year(anchor, TZ), month(anchor, TZ), dayofmonth(anchor, TZ) + dayOffset + int(math.floor(clockHour / 24.0)), clockHour % 24, 0)

// Parse a date, rather than a chart-timezone timestamp, to avoid timezone ambiguity.
// Round-trip validation rejects impossible dates without stopping range calculations.
f_reference_day(string dateText) =>
    int parsed = na
    if str.length(dateText) == 10
        if str.substring(dateText, 4, 5) == "-" and str.substring(dateText, 7, 8) == "-"
            int y = int(str.tonumber(str.substring(dateText, 0, 4)))
            int m = int(str.tonumber(str.substring(dateText, 5, 7)))
            int d = int(str.tonumber(str.substring(dateText, 8, 10)))
            if not na(y) and not na(m) and not na(d) and y >= 1970 and y <= 2200 and m >= 1 and m <= 12 and d >= 1 and d <= 31
                int candidate = timestamp(TZ, y, m, d, 0, 0)
                if str.format_time(candidate, "yyyy-MM-dd", TZ) == dateText
                    parsed := candidate
    parsed

var int ribbonDate = f_reference_day(str.trim(ribbonDateText))
var int recentReference = f_reference_day(recentReferenceDate)
// Calendar arithmetic, never subtracting fixed 24-hour milliseconds across DST.
var int recentPrevious = na(recentReference) ? na : f_stamp(recentReference, -1, 0)
var int recentTwoEarlier = na(recentReference) ? na : f_stamp(recentReference, -2, 0)

f_recent_bias(int anchor, string title, string hours) =>
    int localDay = f_day(anchor)
    int row = localDay == recentReference ? 0 : localDay == recentPrevious ? 1 : localDay == recentTwoEarlier ? 2 : -1
    string chosen = "Default"
    if row >= 0
        if title == "Dayshift"
            chosen := row == 0 ? recent0Day : row == 1 ? recent1Day : recent2Day
        else if title == "Nightshift"
            chosen := row == 0 ? recent0Night : row == 1 ? recent1Night : recent2Night
        else if title == "Human Max"
            bool early = hours == "12-9 AM"
            chosen := row == 0 ? (early ? recent0Early : recent0Off) : row == 1 ? (early ? recent1Early : recent1Off) : (early ? recent2Early : recent2Off)
    if not na(ribbonDate) and localDay == ribbonDate
        if title == "Dayshift" and ribbonDayChoice != "Default"
            chosen := ribbonDayChoice
        else if title == "Nightshift" and ribbonNightChoice != "Default"
            chosen := ribbonNightChoice
        else if title == "Human Max" and chosen == "Default"
            chosen := "Neutral"
    chosen

f_window(int t, int startHour, int endHour) =>
    int offset = endHour > 24 and t < f_stamp(t, 0, startHour) ? -1 : 0
    int s = f_stamp(t, offset, startHour)
    int e = f_stamp(t, offset, endHour)
    [s, e]

// Calendar-based New York windows also cover midnight and DST transitions.
f_gtop_h4_window(int t) =>
    int hr = hour(t, TZ)
    int firstHour = hr < 1 ? 21 : 1 + int(math.floor((hr - 1) / 4.0)) * 4
    f_window(t, firstHour, firstHour + 4)

f_h4_source_window(int t, int nativeStart, int nativeEnd, bool chartMode) =>
    if chartMode
        [nativeStart, nativeEnd]
    else
        f_gtop_h4_window(t)

f_h4_window_text(int starts, int ends) =>
    str.format_time(starts, "HH:mm", TZ) + "–" + str.format_time(ends, "HH:mm", TZ) + " NY"

f_h4_misaligned(int starts, int ends) =>
    [gtopStart, gtopEnd] = f_gtop_h4_window(starts)
    not na(starts) and not na(ends) and (starts != gtopStart or ends != gtopEnd)

f_ink(string bias, int anchor) =>
    bool applies = biasScope == "All dates" or f_day(anchor) == f_day(biasDate)
    applies and bias == "Bullish" ? bullColor : applies and bias == "Bearish" ? bearColor : neutralColor

string ribbonFont = switch fontChoice
    "Tiny" => size.tiny
    "Small" => size.small
    "Large" => size.large
    "Huge" => size.huge
    => size.normal
// The finite ladder is data, not a duplicated chain of branches in every
// requested source. Calendar timeframe durations retain Pine's own definitions.
f_ladder_values() =>
    array.from("3", "5", "15", "60", "240", "1D", "1W", "1M", "3M", "6M", "12M")

f_first_higher_rank(float seconds) =>
    int result = -1
    array<string> ladder = f_ladder_values()
    for i = 0 to array.size(ladder) - 1
        if seconds < timeframe.in_seconds(array.get(ladder, i))
            result := i
            break
    result

f_parent_tf(float seconds) =>
    int rank = f_first_higher_rank(seconds)
    rank < 0 ? "" : array.get(f_ladder_values(), rank)

f_ladder_rank(string layer) =>
    array.indexof(f_ladder_values(), layer)

f_layer_selected(string layer, bool manualToggle, string chartTF, float seconds, string parentTF, string scope, int higherCount = 3) =>
    int firstHigher = f_first_higher_rank(seconds)
    int layerRank = f_ladder_rank(layer)
    bool inHigherContext = firstHigher >= 0 and layerRank >= firstHigher and layerRank < firstHigher + higherCount
    bool inContext = layer == chartTF or inHigherContext
    seconds <= timeframe.in_seconds(layer) and (scope == "Butterfly context" ? inContext : scope == "Current + one higher" ? layer == chartTF or layer == parentTF : manualToggle)

f_chart_layer_covered(string chartTF) =>
    f_ladder_rank(chartTF) >= 0

f_chart_layer_selected(bool covered, bool manualToggle, string scope) =>
    not covered and (scope == "Butterfly context" or scope == "Current + one higher" or manualToggle)

f_ribbon_chart(float seconds) =>
    seconds >= 60 and seconds <= 3600

float chartSeconds = timeframe.in_seconds()
string chartTF = timeframe.period
string requestedParent = autoScope == "Butterfly context" or parentChoice == "Automatic" ? f_parent_tf(chartSeconds) : parentChoice
bool parentValid = requestedParent != "" and timeframe.in_seconds(requestedParent) > chartSeconds
string parentTF = parentValid ? requestedParent : ""
bool defaultLayers = autoScope == "Current + one higher"
bool intradayClock = chart.is_standard and timeframe.isintraday and chartSeconds >= 60 and chartSeconds <= 14400
bool ribbonChart = chart.is_standard and f_ribbon_chart(chartSeconds)
if barstate.isfirst and (not chart.is_standard or na(chartSeconds) or chartSeconds < 60)
    runtime.error("GTOP: use standard time-based candles, 1 minute or higher.")

// MAIN-context head only. Never reference these aliases from request expressions:
// a requested-context last_bar_time is not the main Bar Replay head.
int headOpen = last_bar_time
bool atStatusCapture = barstate.islast
// Prime dynamic datasets on the last historical main bar, then request at the
// actual main endpoint. Normal mapping chooses the Replay-available source bar.
bool requestParentEndpoint = barstate.islastconfirmedhistory or barstate.islast
var int statusKnownEnd = na
var int headClose = na
if atStatusCapture
    statusKnownEnd := barstate.isconfirmed ? time_close : time
    headClose := time_close
// These display boundaries change only with the MAIN head, not each history bar.
// Ordinary var rollback still recomputes them on every tick of a new live head.
var int displayHead = na
var int recentLeft = na
var int ribbonLeft = na
var int calculationLeft = na
var int calculationRight = na
var int observationLeft = na
if na(displayHead) or displayHead != headOpen
    displayHead := headOpen
    recentLeft := f_stamp(headOpen, 1 - visibleDays, 0)
    int firstJobStart = f_stamp(recentLeft, 0, 9)
    ribbonLeft := startAtJob and firstJobStart <= headOpen ? firstJobStart : recentLeft
    calculationLeft := f_stamp(recentLeft, -8, 0)
    calculationRight := f_stamp(headOpen, 2, 0)
    observationLeft := f_stamp(headOpen, -8, 0)

// CURRENT DISPLAY COLLECTOR BEGIN. Normal var rollback replaces provisional
// ticks. These aligned arrays contain only offered main bars, never source data.
var array<int> visibleTimes = array.new<int>()
var array<int> visibleCloses = array.new<int>()
var array<float> recentHighs = array.new<float>()
var array<float> recentLows = array.new<float>()
var array<int> ribbonSampleTimes = array.new<int>()
var array<float> ribbonLows = array.new<float>()
while array.size(visibleTimes) > 0 and array.first(visibleTimes) < recentLeft
    array.shift(visibleTimes)
    array.shift(visibleCloses)
    array.shift(recentHighs)
    array.shift(recentLows)
while array.size(visibleTimes) > 0 and array.last(visibleTimes) > headOpen
    array.pop(visibleTimes)
    array.pop(visibleCloses)
    array.pop(recentHighs)
    array.pop(recentLows)
if time >= recentLeft and time <= headOpen
    if array.size(visibleTimes) > 0 and array.last(visibleTimes) == time
        int i = array.size(visibleTimes) - 1
        array.set(visibleCloses, i, time_close)
        array.set(recentHighs, i, high)
        array.set(recentLows, i, low)
    else
        array.push(visibleTimes, time)
        array.push(visibleCloses, time_close)
        array.push(recentHighs, high)
        array.push(recentLows, low)
while array.size(ribbonSampleTimes) > 0 and array.first(ribbonSampleTimes) < ribbonLeft
    array.shift(ribbonSampleTimes)
    array.shift(ribbonLows)
while array.size(ribbonSampleTimes) > 0 and array.last(ribbonSampleTimes) > headOpen
    array.pop(ribbonSampleTimes)
    array.pop(ribbonLows)
if time >= ribbonLeft and time <= headOpen
    if array.size(ribbonSampleTimes) > 0 and array.last(ribbonSampleTimes) == time
        array.set(ribbonLows, array.size(ribbonLows) - 1, low)
    else
        array.push(ribbonSampleTimes, time)
        array.push(ribbonLows, low)
// Recompute after pruning/replacement, only when the main drawing pass needs it.
// Native extrema avoid stale outliers and an interpreted scan on every bar.
float visibleHigh = barstate.islast and array.size(recentHighs) > 0 ? array.max(recentHighs) : na
float visibleLow = barstate.islast and array.size(recentLows) > 0 ? array.min(recentLows) : na
float ribbonLow = barstate.islast and array.size(ribbonLows) > 0 ? array.min(ribbonLows) : na
// CURRENT DISPLAY COLLECTOR END.
// Recover prior scheduled levels without clipping automatic or selected sources.
// Boundaries above are cached together; source history budgets remain unchanged.

// The prior HTF candle is confirmed. [1] plus lookahead_on avoids future data.
string contextTF = contextSource == "Previous day" ? "1D" : contextSource == "Previous month" ? "1M" : "1W"
[contextH, contextL, contextT, contextTC] = request.security(syminfo.tickerid, contextTF, [high[1], low[1], time[1], time_close[1]], lookahead=barmerge.lookahead_on)
var float selectedContextHigh = na
var float selectedContextLow = na
var int selectedContextStart = na
var int selectedContextFinish = na
if atStatusCapture
    selectedContextHigh := contextSource == "Manual bounds" ? manualHigh : contextH
    selectedContextLow := contextSource == "Manual bounds" ? manualLow : contextL
    selectedContextStart := contextSource == "Manual bounds" ? manualStart : contextT
    selectedContextFinish := contextSource == "Manual bounds" ? manualEnd : contextTC

// Request expressions may be evaluated in their own contexts. Check selection
// inside each state engine against the ORIGINAL chart period, never that context.
f_main_layer_enabled(string title) =>
    string mainTF = timeframe.main_period
    float mainSeconds = timeframe.in_seconds(mainTF)
    string layer = title == "M" ? "1M" : title == "W" ? "1W" : title == "D" ? "1D" : title == "M15" ? "15" : title == "M5" ? "5" : title == "M3" ? "3" : title
    string requested = autoScope == "Butterfly context" or parentChoice == "Automatic" ? f_parent_tf(mainSeconds) : parentChoice
    string selectedParent = requested != "" and timeframe.in_seconds(requested) > mainSeconds ? requested : ""
    bool manual = layer == "1M" ? autoM : layer == "3M" ? auto3M : layer == "6M" ? auto6M : layer == "12M" ? auto12M : layer == "1W" ? autoW : layer == "1D" ? autoD : layer == "240" ? autoH4 : layer == "60" ? autoH1 : layer == "15" ? autoM15 : layer == "5" ? autoM5 : layer == "3" ? autoM3 : autoChart
    bool chartLayer = title == "Chart " + mainTF
    rangeAnalysisNeeded and (chartLayer ? f_chart_layer_selected(f_chart_layer_covered(mainTF), autoChart, autoScope) : f_layer_selected(layer, manual, mainTF, mainSeconds, selectedParent, autoScope, higherLayerCount))

// AUTOMATIC CONFIRMED-RANGE ENGINE -------------------------------------------
// Persistent state advances only with the previous SOURCE bar. The optional
// Daily/Weekly close projection uses copies and is selected only after its source
// close is confirmed in the main chart context; never confirm inside security().
// The same lifecycle runs for every context layer. No weekday/date presets.
type ActiveRange
    float hi
    float lo
    int begins
    int ends
    int born
    string title
    bool highTaken = false
    bool lowTaken = false
    bool upperPurged = false
    bool lowerPurged = false
    bool closedBackInside = false
    string sourceTF = ""
    int retiredReason = 0
    int retiredAt = na
    bool objectiveAtRetirement = false
    bool outsideCloseAtRetirement = false
    int observedCandles = 1
    int insideBefore = 0
    int manipulationNumber = 0
    float manipulationHigh = na
    float manipulationLow = na
    bool manipulationInside = false
    bool midpointTaken = false
    bool resoup = false
    bool resoupPending = false
    bool deliverySourceClosed = true
    bool sameCandleV2 = false
    int doublePurgeAt = na
    bool oppositePurgePending = false
    int returnObjectiveAt = na
    bool followStopped = false
    bool h1Delivery = false
    bool forming = false
    int purgeOpen = na
    int purgeClose = na
    int returnOpen = na
    int returnClose = na
    float returnPrice = na
    int lastSourceOpen = na
    int lastSourceClose = na
    float lastSourcePrice = na
    int objectiveObservedAt = na
    string objectiveEvidenceTF = ""
    int invalidOpen = na
    int invalidAt = na

f_copy_range(ActiveRange r) =>
    // ActiveRange contains only scalar fields. Native copy preserves every
    // value in a new independent object; no nested reference can be shared.
    r.copy()

// Candle-ordered CRT structure. This never changes box eligibility. It does
// not infer intrabar event order, Model1/CSD, a Super Soup, or an entry.
f_variant_observe(ActiveRange r, float h, float l, float c) =>
    r.observedCandles += 1
    bool firstPurge = not r.upperPurged and not r.lowerPurged and (h > r.hi or l < r.lo)
    bool insideClose = f_gtop_inside(c, r.hi, r.lo)
    float middle = math.avg(r.hi, r.lo)
    if firstPurge
        r.manipulationNumber := r.observedCandles
        r.manipulationHigh := h
        r.manipulationLow := l
        r.manipulationInside := insideClose
        r.midpointTaken := h > r.hi ? l <= middle : h >= middle
    else if r.manipulationNumber == 0
        if f_gtop_inside_bar(h, l, r.hi, r.lo)
            r.insideBefore += 1
    else
        bool midNow = r.upperPurged ? l <= middle : h >= middle
        bool sweptManipulation = r.upperPurged ? h > r.manipulationHigh : l < r.manipulationLow
        bool objectiveTaken = r.upperPurged ? r.lowTaken : r.highTaken
        bool objectiveNow = r.upperPurged ? l <= r.lo : h >= r.hi
        // Midpoint is not the full objective. Same-bar re-purge + full objective
        // has unknown order, so it cannot newly qualify V6.
        if not r.resoup and f_gtop_v6_before_full(r.manipulationInside, sweptManipulation, objectiveTaken, objectiveNow)
            r.resoupPending := true
        if r.resoupPending and insideClose and not objectiveTaken and not objectiveNow
            r.resoup := true
            r.resoupPending := false
        r.midpointTaken := r.midpointTaken or midNow
    0

f_variant_codes(ActiveRange r, bool completed, bool firstFormingPurge = false) =>
    string codes = ""
    int observed = r.observedCandles + (firstFormingPurge ? 1 : 0)
    int manipulation = firstFormingPurge ? observed : r.manipulationNumber
    if r.sameCandleV2 and completed
        codes := "V2"
    else if r.manipulationInside or firstFormingPurge
        if r.insideBefore == 1
            codes := "V4"
        else if r.insideBefore >= 2
            codes := "V5"
        else if manipulation == 2
            codes := completed ? (observed == 3 ? "V1" : observed > 3 ? "V3" : "") : observed < 3 ? "V1/V3" : "V3"
        if r.resoup or r.resoupPending
            // An evidenced second purge makes only V6 eligible.
            codes := "V6"
    completed and r.resoupPending ? "" : codes

// Narrow OHLC proof for V2: candle 2 OPENS strictly inside, purges one edge,
// and CLOSES beyond the opposing target. The purge necessarily precedes that
// closing delivery. Gap opens and inside-closing two-sided bars stay unknown.
// V2 is completed history only; it never fabricates an active inside-close box.
f_v2_delivery(ActiveRange r, float o, float h, float l, float c) =>
    bool startsInside = o > r.lo and o < r.hi
    bool early = r.observedCandles == 1 and r.manipulationNumber == 0
    early and startsInside and ((h > r.hi and c < r.lo) or (l < r.lo and c > r.hi))

// 0 = remains (waiting or relevant), 1 = source-close invalidation,
// 2 = objective delivered or both sides reached in the activation candle.
// Objective tracking starts at the first strict purge, not before it.
// Equal-edge touches alone do not activate relevance. Same-bar two-sided
// action has no provably pending DOL; suppress it without inferring event order.
f_active_reason(ActiveRange r, float h, float l, float c) =>
    int reason = 0
    bool objectiveReached = r.closedBackInside and ((r.upperPurged and l <= r.lo) or (r.lowerPurged and h >= r.hi))
    if objectiveReached
        r.lowTaken := r.lowTaken or r.upperPurged
        r.highTaken := r.highTaken or r.lowerPurged
        reason := 2
    else if f_gtop_outside(c, r.hi, r.lo)
        reason := 1
    else if r.upperPurged
        r.lowTaken := r.lowTaken or l <= r.lo
        reason := r.lowTaken ? 2 : 0
    else if r.lowerPurged
        r.highTaken := r.highTaken or h >= r.hi
        reason := r.highTaken ? 2 : 0
    else if h > r.hi
        r.upperPurged := true
        r.highTaken := true
        r.lowTaken := l <= r.lo
        r.lowerPurged := l < r.lo
        reason := r.lowTaken ? 2 : 0
    else if l < r.lo
        r.lowerPurged := true
        r.lowTaken := true
        r.highTaken := h >= r.hi
        reason := r.highTaken ? 2 : 0
    if reason == 0 and (r.upperPurged or r.lowerPurged) and f_gtop_inside(c, r.hi, r.lo)
        r.closedBackInside := true
    reason

f_relevant(ActiveRange r) =>
    r.closedBackInside and ((r.upperPurged and not r.lowerPurged and not r.lowTaken) or (r.lowerPurged and not r.upperPurged and not r.highTaken))

// Observation only: latest traded price is inside; the source close is pending.
// Existing closed candidates alone supply identity/coverage. Equality never
// starts a purge, and a touch at the opposite edge removes a pending objective.
f_forming(ActiveRange r, float h, float l, float c) =>
    bool upper = r.upperPurged or h > r.hi
    bool lower = r.lowerPurged or l < r.lo
    not r.closedBackInside and r.retiredReason == 0 and f_gtop_inside(c, r.hi, r.lo) and ((upper and not lower and not r.lowTaken and l > r.lo) or (lower and not upper and not r.highTaken and h < r.hi))

f_archive(array<ActiveRange> retired, ActiveRange r, int reason, int closedAt, float h, float l, float c) =>
    if not na(retired)
        ActiveRange record = f_copy_range(r)
        record.retiredReason := reason
        record.retiredAt := closedAt
        record.objectiveAtRetirement := r.upperPurged ? l <= r.lo : h >= r.hi
        record.outsideCloseAtRetirement := not r.h1Delivery and f_gtop_outside(c, r.hi, r.lo)
        record.deliverySourceClosed := not r.h1Delivery
        if reason == 2
            record.objectiveObservedAt := closedAt
            record.objectiveEvidenceTF := r.h1Delivery ? "60" : r.sourceTF
        // Prior first purge is known; a strict opposite purge can be in the
        // delivery candle itself. Only this range's own close confirms it.
        if reason == 2 and not r.h1Delivery and r.closedBackInside and f_gtop_inside(c, r.hi, r.lo) and (r.upperPurged ? l < r.lo : h > r.hi)
            record.doublePurgeAt := closedAt
        if reason == 2 and not r.h1Delivery and r.closedBackInside and (r.upperPurged ? l < r.lo : h > r.hi)
            record.oppositePurgePending := true
        array.push(retired, record)
        if array.size(retired) > historyKeep
            array.shift(retired)
    0

// Follow completed ranges independently of active pending-DOL selection.
// A second, opposing STRICT breach is a distinct purge; merely touching the
// opposite objective completes delivery but is not yet a double purge.
f_follow_retired(array<ActiveRange> retired, float h, float l, float c, int tc, bool h1Evidence=false, int sourceStart=na) =>
    if not na(retired)
        for r in retired
            if r.retiredReason == 2 and not r.followStopped and tc >= r.retiredAt and not h1Evidence
                r.deliverySourceClosed := true
                r.lastSourceOpen := sourceStart
                r.lastSourceClose := tc
                r.lastSourcePrice := c
                bool inside = f_gtop_inside(c, r.hi, r.lo)
                if na(r.doublePurgeAt)
                    r.oppositePurgePending := r.oppositePurgePending or (r.upperPurged ? l < r.lo : h > r.hi)
                    if inside and r.oppositePurgePending
                        r.doublePurgeAt := tc
                else if tc > r.doublePurgeAt and (r.upperPurged ? h >= r.hi : l <= r.lo)
                    r.returnObjectiveAt := tc
                    r.followStopped := true
                if f_gtop_outside(c, r.hi, r.lo)
                    r.invalidOpen := sourceStart
                    r.invalidAt := tc
                    r.followStopped := true
    0

f_shift_observe(ActiveRange r, float o, float h, float l, float c, int tc, array<ActiveRange> retired, int sourceStart=na) =>
    r.lastSourceOpen := sourceStart
    r.lastSourceClose := tc
    r.lastSourcePrice := c
    if na(r.purgeClose) and (h > r.hi or l < r.lo)
        r.purgeOpen := sourceStart
        r.purgeClose := tc
    if not na(r.purgeClose) and na(r.returnClose) and f_gtop_inside(c, r.hi, r.lo)
        r.returnOpen := sourceStart
        r.returnClose := tc
        r.returnPrice := c
    if f_gtop_outside(c, r.hi, r.lo)
        r.invalidOpen := sourceStart
        r.invalidAt := tc
    bool wasQualified = f_relevant(r)
    bool v2Delivered = f_v2_delivery(r, o, h, l, c)
    // An unqualified, non-V2 candidate closing outside is discarded by every
    // caller. It cannot produce an archive; avoid updating its unused variant fields.
    int reason = 1
    if wasQualified or v2Delivered or not (f_gtop_outside(c, r.hi, r.lo))
        f_variant_observe(r, h, l, c)
        reason := f_active_reason(r, h, l, c)
        if v2Delivered
            r.sameCandleV2 := true
            r.upperPurged := c < r.lo
            r.lowerPurged := c > r.hi
            r.highTaken := true
            r.lowTaken := true
            reason := 2
        if reason != 0 and (wasQualified or v2Delivered)
            f_archive(retired, r, reason, tc, h, l, c)
    reason

f_active_step(array<ActiveRange> pool, float h, float l, float c, int s, int e, int seq, string title, array<ActiveRange> retired=na, string sourceTF="", float o=na) =>
    int i = array.size(pool) - 1
    while i >= 0
        ActiveRange r = array.get(pool, i)
        int reason = f_shift_observe(r, o, h, l, c, e, retired, s)
        if reason != 0 or seq - r.born >= autoLookback
            array.remove(pool, i)
        i -= 1
    f_follow_retired(retired, h, l, c, e, false, s)
    if h > l and s < e
        ActiveRange candidate = ActiveRange.new(h, l, s, e, seq, title, sourceTF=sourceTF)
        array.push(pool, candidate)
    0

// Return only a bounded snapshot at the chosen source-context observation bar.
// Transport collections only on the last available SOURCE bar, as well as
// requesting them only at MAIN endpoints. Main-only gating still copies every
// historical source collection and exhausted M5 memory. State calculations and
// source history budgets remain unchanged. History adds archives
// to those same head-evaluated snapshots; it never rewinds source selection.
// Copy each object so main-context drawing cannot mutate the source pool.
f_active_snapshot(array<ActiveRange> pool, bool atSnapshot, array<ActiveRange> retired=na) =>
    array<ActiveRange> result = na
    if atSnapshot
        result := array.new<ActiveRange>()
        int i = 0
        // Chronological priority is stable until a range delivers/invalidates.
        // Filter BEFORE applying the display cap so waiting candles cannot
        // hide an older purged range with an objective still pending.
        while i < array.size(pool) and array.size(result) < autoKeep
            ActiveRange r = array.get(pool, i)
            if f_relevant(r)
                array.push(result, f_copy_range(r))
            i += 1
        // Transport at most one extra selected-layer candidate for honest
        // pending/untouched evidence. It does not gain a relevant range box.
        if evidenceNeeded and array.size(pool) > 0
            int selectedPending = -1
            int pendingIndex = array.size(pool) - 1
            while pendingIndex >= 0
                ActiveRange pending = array.get(pool, pendingIndex)
                if pending.sourceTF == evidenceTFChoice and not f_relevant(pending) and (evidenceAnchor == 0 or pending.begins == evidenceAnchor)
                    if selectedPending < 0 or pending.upperPurged or pending.lowerPurged
                        selectedPending := pendingIndex
                    if pending.upperPurged or pending.lowerPurged
                        break
                pendingIndex -= 1
            if selectedPending >= 0
                array.push(result, f_copy_range(array.get(pool, selectedPending)))
        if not na(retired)
            // Retain 24 for follow-through, transport only six recent eligible
            // records. Old completed ranges must not crowd out today's range.
            int historyCount = 0
            int historyIndex = array.size(retired) - 1
            while historyIndex >= 0 and historyCount < 6
                ActiveRange record = array.get(retired, historyIndex)
                if historyOn or (evidenceNeeded and record.sourceTF == evidenceTFChoice) or (not record.followStopped and not na(record.doublePurgeAt))
                    array.push(result, f_copy_range(record))
                    historyCount += 1
                historyIndex -= 1
    result

// Session timestamps are not a holiday calendar. Preserve ordinary D/W/M
// closures; never infer a missing candle from elapsed weekend hours alone.
f_adjacent_session(bool wasLast, bool isFirst, int previousTradingDay, int nextTradingDay) =>
    wasLast and isFirst and nextTradingDay - previousTradingDay == 86400000

f_native_gap(int prevEnd, int nextStart, int nextEnd, bool intraday, bool monthly, bool weekly, int multiplier, bool sessionBoundary) =>
    bool gap = false
    if not na(prevEnd) and not na(nextStart) and not na(nextEnd)
        if intraday
            gap := nextStart > prevEnd and not sessionBoundary
        else if monthly
            int a = year(prevEnd - 1, syminfo.timezone) * 12 + month(prevEnd - 1, syminfo.timezone) - 1
            int b = year(nextEnd - 1, syminfo.timezone) * 12 + month(nextEnd - 1, syminfo.timezone) - 1
            gap := int(math.floor(b / multiplier)) - int(math.floor(a / multiplier)) > 1
        else if weekly
            gap := int(math.floor((nextEnd - 1 - 345600000) / (604800000.0 * multiplier))) - int(math.floor((prevEnd - 1 - 345600000) / (604800000.0 * multiplier))) > 1
    gap

f_unknown_gap(array<ActiveRange> pool, array<ActiveRange> retired, int lastKnown) =>
    for r in pool
        if f_relevant(r)
            ActiveRange record = f_copy_range(r)
            record.retiredReason := 3
            record.retiredAt := lastKnown
            array.push(retired, record)
            if array.size(retired) > historyKeep
                array.shift(retired)
    array.clear(pool)
    0

f_hour_objectives(array<ActiveRange> pool, array<ActiveRange> retired, float h, float l, float c, int t, int tc) =>
    int i = array.size(pool) - 1
    while i >= 0
        ActiveRange r = array.get(pool, i)
        if t >= r.ends and tc > t and f_relevant(r) and (r.upperPurged ? l <= r.lo : h >= r.hi)
            r.observedCandles += 1
            r.h1Delivery := true
            r.highTaken := true
            r.lowTaken := true
            f_archive(retired, r, 2, tc, h, l, c)
            array.remove(pool, i)
        i -= 1
    f_follow_retired(retired, h, l, c, tc, true)
    0

f_hour_batch(array<ActiveRange> pool, array<ActiveRange> retired, array<int> ts, array<int> ends, array<float> hs, array<float> ls, array<float> cs, int limit) =>
    if not na(ts) and array.size(ts) > 0
        for j = 0 to array.size(ts) - 1
            int t = array.get(ts, j)
            int tc = array.get(ends, j)
            if tc <= limit and tc > t
                f_hour_objectives(pool, retired, array.get(hs, j), array.get(ls, j), array.get(cs, j), t, tc)
    0

f_hour_snapshot(array<ActiveRange> pool, array<ActiveRange> retired, bool atSnapshot, array<int> ts, array<int> ends, array<float> hs, array<float> ls, array<float> cs, int limit) =>
    array<ActiveRange> snapshotPool = pool
    array<ActiveRange> snapshotRetired = retired
    if atSnapshot and timeframe.in_seconds() > 3600
        snapshotPool := array.new<ActiveRange>()
        snapshotRetired := array.new<ActiveRange>()
        for r in pool
            array.push(snapshotPool, f_copy_range(r))
        for r in retired
            array.push(snapshotRetired, f_copy_range(r))
        f_hour_batch(snapshotPool, snapshotRetired, ts, ends, hs, ls, cs, limit)
    // One written snapshot call; only higher sources need projected pool copies.
    // f_active_snapshot still copies every transported record in both paths.
    f_active_snapshot(snapshotPool, atSnapshot, snapshotRetired)

f_native_views(string layer, bool endpoint=false, bool allSnapshots=false, bool stageCandidates=false) =>
    var array<ActiveRange> pool = array.new<ActiveRange>()
    var array<ActiveRange> retired = array.new<ActiveRange>()
    var int seq = 0
    [hourStarts, hourEnds, hourHighs, hourLows, hourCloses] = request.security_lower_tf(syminfo.tickerid, "60", [time, time_close, high, low, close], ignore_invalid_timeframe=true, calc_bars_count=5000)
    bool currentGap = f_native_gap(time_close[1], time, time_close, timeframe.isintraday, timeframe.ismonthly, timeframe.isweekly, timeframe.multiplier, f_adjacent_session(session.islastbar[1], session.isfirstbar, time_tradingday[1], time_tradingday))
    bool previousGap = currentGap[1]
    bool atSnapshot = allSnapshots or barstate.islast
    bool projectClose = endpoint and atSnapshot and (timeframe.isweekly or timeframe.isdaily) and timeframe.multiplier == 1
    array<ActiveRange> result = na
    array<ActiveRange> endpointResult = na
    // The same written lifecycle step handles the closed previous source and,
    // only at the endpoint, a projection into independent copies. The second
    // pass never changes persistent pools or confirms a developing source.
    for pass = 0 to (projectClose ? 1 : 0)
        bool projection = pass == 1
        array<ActiveRange> stepPool = pool
        array<ActiveRange> stepRetired = retired
        if projection
            stepPool := array.new<ActiveRange>()
            stepRetired := array.new<ActiveRange>()
            for r in pool
                array.push(stepPool, f_copy_range(r))
            for r in retired
                array.push(stepRetired, f_copy_range(r))
        int offset = projection ? 0 : 1
        if not na(time[offset])
            if not projection
                if previousGap
                    f_unknown_gap(pool, retired, time_close[2])
                seq += 1
            bool dailyTitle = timeframe.isdaily and timeframe.multiplier == 1
            string datePattern = timeframe.ismonthly ? "MMM yyyy" : timeframe.isintraday ? "MMM d HH:mm" : dailyTitle ? "EEEE | MMM d, yyyy" : "MMM d, yyyy"
            int titleTime = dailyTitle ? time_tradingday[offset] : timeframe.ismonthly and timeframe.multiplier == 1 ? time_close[offset] - 1 : time[offset]
            string titleZone = dailyTitle ? "UTC" : timeframe.isintraday ? TZ : syminfo.timezone
            string title = (dailyTitle ? "Day" : layer) + " | " + (na(titleTime) ? "Trading date unavailable" : str.format_time(titleTime, datePattern, titleZone))
            if timeframe.in_seconds() > 3600
                f_hour_batch(stepPool, stepRetired, hourStarts[offset], hourEnds[offset], hourHighs[offset], hourLows[offset], hourCloses[offset], projection ? math.min(timenow, time_close) : time_close[1])
            f_active_step(stepPool, high[offset], low[offset], close[offset], time[offset], time_close[offset], seq + (projection ? 1 : 0), title, stepRetired, timeframe.period, open[offset])
            if not projection and currentGap
                f_unknown_gap(pool, retired, time_close[1])
        if projection
            endpointResult := f_active_snapshot(stepPool, atSnapshot, stepRetired)
        else
            result := f_hour_snapshot(pool, retired, atSnapshot, hourStarts, hourEnds, hourHighs, hourLows, hourCloses, math.min(timenow, time_close))
    if stageCandidates and atSnapshot and time <= timenow and timenow < time_close
        for r in pool
            if not f_relevant(r)
                ActiveRange staged = f_copy_range(r)
                staged.forming := true
                array.push(result, staged)
    [result, endpointResult]

// One source engine provides independent ordinary and close-projected copies.
// Current OHLC is never accepted as confirmed without f_forming_display's
// source-span and main-close guards; live OHLC is observation-only.
f_native_bundle() =>
    string tf = timeframe.period
    string layer = not f_chart_layer_covered(tf) ? "Chart " + tf : tf == "1M" ? "M" : tf == "1W" ? "W" : tf == "1D" ? "D" : timeframe.isintraday ? "M" + tf : tf
    bool stage = tf == "1M" or tf == "1W" or tf == "1D"
    [ordinary, projected] = f_native_views(layer, true, false, stage)
    [ordinary, projected, time, time_close, high, low, close]

f_h4_title(int s) =>
    switch hour(s, TZ)
        1 => "Asia Expansion"
        5 => "London Lunch"
        9 => "GCT / New York AM"
        13 => "New York PM"
        17 => "CBDR + Early Asia"
        => "Asia Open"

f_h4_range_title(int starts, int ends) =>
    (h4ChartMode ? "Chart H4" : "GTOP H4 | " + f_h4_title(starts)) + " | " + f_h4_window_text(starts, ends) + " | " + str.format_time(starts, "MMM d", TZ)

// Session continuity uses native boundary evidence and repeated timing, never
// future OHLC. Consistent systematic feed omissions remain indistinguishable
// from stable closures; this is not an independent holiday/data integrity audit.
f_source_continuity() =>
    var int learnedOffset = na
    var int learnedCount = 0
    int maxOffsetMs = 3600000
    int neededPriorBoundaries = 3

    // This is a calendar projection, not a future-price request. Snapshot the
    // previous source bar's projection rather than recalculating it retrospectively.
    int expectedNext = time("", bars_back = -1)
    int projectedNext = expectedNext[1]
    bool validTransition = time > time[1] and time_close[1] > time[1] and time >= time_close[1]
    bool rawContiguous = validTransition and time == time_close[1]
    bool newTradingDay = time_tradingday > time_tradingday[1]
    bool nativeBoundary = validTransition and session.islastbar[1] and session.isfirstbar and newTradingDay
    bool usableProjection = nativeBoundary and projectedNext >= time_close[1] and projectedNext <= time
    int offsetMs = usableProjection ? time - projectedNext : na
    bool boundedBoundary = usableProjection and offsetMs <= maxOffsetMs

    // IMPORTANT: Read the PRE-update state. The first three matching observations
    // train the offset but do not authorize retention; the fourth can authorize it.
    bool exactBoundary = boundedBoundary and offsetMs == 0
    bool learnedBoundary = boundedBoundary and offsetMs == learnedOffset and learnedCount >= neededPriorBoundaries
    bool continuous = rawContiguous or exactBoundary or learnedBoundary

    if boundedBoundary
        if offsetMs == learnedOffset
            learnedCount := math.min(learnedCount + 1, neededPriorBoundaries)
        else
            learnedOffset := offsetMs
            learnedCount := 1
    else if nativeBoundary or not rawContiguous
        // Unknown gaps, unusable projections, and non-monotonic/missing history
        // discard learning. Ordinary contiguous intraday bars preserve learning.
        learnedOffset := na
        learnedCount := 0

    continuous

// Both H4 modes consume only observed closed H1 prices. The same lifecycle
// uses either fixed GTOP windows or native chart-candle boundaries.
f_h4_h1_v2(array<ActiveRange> pool, array<ActiveRange> retired, float o, float h, float l, float c, int t, int tc) =>
    int i = array.size(pool) - 1
    while i >= 0
        ActiveRange r = array.get(pool, i)
        bool v2Delivered = (h4ChartMode or tc <= r.ends + 4 * 3600000) and f_v2_delivery(r, o, h, l, c)
        bool objectiveReached = f_relevant(r) and (r.upperPurged ? l <= r.lo : h >= r.hi)
        if t >= r.ends and tc > t and (v2Delivered or objectiveReached)
            if v2Delivered
                r.sameCandleV2 := true
                r.upperPurged := c < r.lo
                r.lowerPurged := c > r.hi
            else
                r.observedCandles += 1
            r.h1Delivery := true
            r.highTaken := true
            r.lowTaken := true
            f_archive(retired, r, 2, tc, h, l, c)
            array.remove(pool, i)
        i -= 1
    f_follow_retired(retired, h, l, c, tc, true)
    0

f_h4_views(bool endpoint=false) =>
    var array<ActiveRange> pool = array.new<ActiveRange>()
    var array<ActiveRange> retired = array.new<ActiveRange>()
    var int seq = 0
    var int starts = na
    var int ends = na
    var int coverageEnd = na
    var float hi = na
    var float lo = na
    var float firstOpen = na
    var bool partial = true
    // Evaluated on every offered SOURCE H1 bar, before the enabled gate.
    // [1] belongs to the bar being consumed. Never use the current
    // transition witness to validate an older discontinuity.
    bool sourceConnected = f_source_continuity()
    // Read native boundaries in the H1 request context, on every source bar.
    // The [1] timestamps belong to the closed hour being consumed.
    int nativeStart = time("240")
    int nativeEnd = time_close("240")
    int t = time[1]
    int tc = time_close[1]
    var bool enabled = f_main_layer_enabled("240")
    if enabled and not na(t)
        bool linkedPrevious = not na(coverageEnd) and (t == coverageEnd or t > coverageEnd and time_close[2] == coverageEnd and sourceConnected[1])
        if not na(coverageEnd) and not linkedPrevious
            array.clear(pool)
        [s, e] = f_h4_source_window(t, nativeStart[1], nativeEnd[1], h4ChartMode)
        bool contained = t >= s and tc > t and tc <= e
        bool delayedOpeningCovered = t > s and not na(coverageEnd) and coverageEnd <= s and linkedPrevious
        if na(starts) or starts != s
            // An unfinished earlier window has no covered closing candle.
            // A later scheduled reopening cannot silently make it complete.
            if not na(starts) and coverageEnd != ends
                array.clear(pool)
            starts := s
            ends := e
            hi := high[1]
            lo := low[1]
            firstOpen := open[1]
            partial := not (t == s or delayedOpeningCovered) or not contained
            coverageEnd := tc
        else
            partial := partial or not linkedPrevious or not contained
            hi := math.max(hi, high[1])
            lo := math.min(lo, low[1])
            coverageEnd := tc
        if not partial and contained and linkedPrevious
            f_h4_h1_v2(pool, retired, open[1], high[1], low[1], close[1], t, tc)
        if tc == ends
            if not partial
                seq += 1
                f_active_step(pool, hi, lo, close[1], starts, ends, seq, f_h4_range_title(starts, ends), retired, "240", firstOpen)
            else
                array.clear(pool)
        else if tc > ends
            array.clear(pool)
        if time != tc and not sourceConnected
            array.clear(pool)
    bool atSnapshot = barstate.islast
    array<ActiveRange> result = f_active_snapshot(pool, enabled and atSnapshot, retired)
    array<ActiveRange> endpointResult = na
    // At the daily break no next H1 exists to consume the final hour via [1].
    // Project that exact closing hour into independent copies. MAIN alone
    // accepts this projection after the overlapping chart candle is confirmed.
    // A partial/gapped window or an hour that does not end H4 cannot qualify.
    if endpoint and enabled and atSnapshot and not partial and time == coverageEnd and time_close == ends
        array<ActiveRange> projectedPool = array.new<ActiveRange>()
        array<ActiveRange> projectedRetired = array.new<ActiveRange>()
        for r in pool
            array.push(projectedPool, f_copy_range(r))
        for r in retired
            array.push(projectedRetired, f_copy_range(r))
        f_h4_h1_v2(projectedPool, projectedRetired, open, high, low, close, time, time_close)
        f_active_step(projectedPool, math.max(hi, high), math.min(lo, low), close, starts, ends, seq + 1, f_h4_range_title(starts, ends), projectedRetired, "240", firstOpen)
        endpointResult := f_active_snapshot(projectedPool, true, projectedRetired)
    [result, endpointResult]

f_h4_active() =>
    [result, unused] = f_h4_views()
    result

// Candidate inventory is independent of chronological 9ate8 navigation.
// Admit every completed GTOP 08–11 / 20–23 hour, including 11 and 23.
// Waiting candidates stay hidden until the unchanged price rules qualify them;
// a later purge may qualify them after the shift. Every parent is observed once.
// Source-age bounds, unknown coverage and price outcomes still retire/omit them.
f_shift_active(bool allSnapshots=false) =>
    var array<ActiveRange> pool = array.new<ActiveRange>()
    var array<ActiveRange> retired = array.new<ActiveRange>()
    var int lastClosed = na
    var int seq = 0
    var bool enabled = f_main_layer_enabled("60")
    bool sourceConnected = f_source_continuity()
    int t = time[1]
    int tc = time_close[1]
    if enabled and not na(t)
        seq += 1
        int hr = hour(t, TZ)
        bool exactHour = minute(t, TZ) == 0 and second(t, TZ) == 0 and tc == f_stamp(t, 0, hr + 1)
        bool previousGap = not na(lastClosed) and t != lastClosed and not (time_close[2] == lastClosed and sourceConnected[1])
        if previousGap or not exactHour
            f_unknown_gap(pool, retired, lastClosed)
        if exactHour
            int i = array.size(pool) - 1
            while i >= 0
                ActiveRange prior = array.get(pool, i)
                int reason = f_shift_observe(prior, open[1], high[1], low[1], close[1], tc, retired, time[1])
                if reason != 0 or seq - prior.born >= autoLookback
                    array.remove(pool, i)
                i -= 1
            f_follow_retired(retired, high[1], low[1], close[1], tc, false, time[1])
            bool shiftHour = (hr >= 8 and hr <= 11) or (hr >= 20 and hr <= 23)
            if shiftHour and high[1] > low[1]
                string title = "H1 | " + str.format_time(t, "h a, MMM d", TZ) + (hr == 8 or hr == 20 ? " | 9ate8" : " | Shift CRT")
                ActiveRange candidate = ActiveRange.new(high[1], low[1], t, tc, seq, title, sourceTF="60")
                array.push(pool, candidate)
        lastClosed := tc
        if time != tc and not sourceConnected
            f_unknown_gap(pool, retired, tc)
    f_active_snapshot(pool, enabled and (allSnapshots or barstate.islast), retired)

// Input/chart-timeframe changes restart the script. These top-level gates
// have no bar-dependent inputs, so compute each once and reuse it. Keep
// request-context engine checks on timeframe.main_period unchanged.
var bool selectMonthly = rangeAnalysisNeeded and f_layer_selected("1M", autoM, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool select3M = rangeAnalysisNeeded and f_layer_selected("3M", auto3M, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool select6M = rangeAnalysisNeeded and f_layer_selected("6M", auto6M, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool select12M = rangeAnalysisNeeded and f_layer_selected("12M", auto12M, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectWeekly = rangeAnalysisNeeded and f_layer_selected("1W", autoW, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectDaily = rangeAnalysisNeeded and f_layer_selected("1D", autoD, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectH4 = rangeAnalysisNeeded and f_layer_selected("240", autoH4, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectHourly = rangeAnalysisNeeded and f_layer_selected("60", autoH1, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectM15 = rangeAnalysisNeeded and f_layer_selected("15", autoM15, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectM5 = rangeAnalysisNeeded and f_layer_selected("5", autoM5, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectM3 = rangeAnalysisNeeded and f_layer_selected("3", autoM3, chartTF, chartSeconds, parentTF, autoScope, higherLayerCount)
var bool selectChart = rangeAnalysisNeeded and f_chart_layer_selected(f_chart_layer_covered(chartTF), autoChart, autoScope)

// Offered MAIN bars only. Each written call retains its own source interval.
// Normal var rollback replaces each open-bar update. Require the exact source
// opening and contiguous, wholly contained bars; uncertain coverage fails closed.
f_main_forming_observation(string sourceTF, bool selected) =>
    int starts = time(sourceTF)
    int ends = time_close(sourceTF)
    var float hi = na
    var float lo = na
    var bool covered = false
    if selected and time <= headOpen
        bool newSource = na(starts[1]) or starts != starts[1]
        covered := not na(starts) and not na(ends) and time >= starts and time < time_close and time_close <= ends and not na(high) and not na(low) and not na(close) and (newSource ? time == starts : covered and ends == ends[1] and time == time_close[1])
        hi := newSource ? high : math.max(hi, high)
        lo := newSource ? low : math.min(lo, low)
    [starts, ends, hi, lo, covered]

// MAIN-context merge only. Shared Monthly/Daily/Weekly guards preserve the confirmed
// endpoint rule, covered main-price preference and true-realtime gap fallback.
// Returned forming objects are copies; no closed-source state is advanced.
f_forming_display(array<ActiveRange> ordinary, array<ActiveRange> endpoint, int sourceStart, int sourceEnd, int endpointStart, int endpointEnd, float endpointHigh, float endpointLow, float endpointLast, int mainStart, int mainEnd, float mainHigh, float mainLow, bool mainCovered) =>
    bool endpointClosed = barstate.isconfirmed and not na(endpointStart) and not na(endpointEnd) and endpointStart <= headOpen and headOpen < endpointEnd and endpointEnd <= time_close
    bool endpointLive = barstate.isrealtime and not endpointClosed and not na(endpointStart) and not na(endpointEnd) and endpointStart <= headOpen and headOpen < endpointEnd and timenow < endpointEnd
    bool formingAllowed = (mainCovered or endpointLive and endpointStart == mainStart and endpointEnd == mainEnd) and time == headOpen and sourceStart == mainStart and sourceEnd == mainEnd and time <= timenow and timenow < mainEnd and (not barstate.isconfirmed or time_close < mainEnd)
    float observedHigh = mainCovered ? mainHigh : endpointHigh
    float observedLow = mainCovered ? mainLow : endpointLow
    float observedLast = mainCovered ? close : endpointLast
    array<ActiveRange> confirmed = endpointClosed and not na(endpoint) ? endpoint : ordinary
    array<ActiveRange> visible = array.new<ActiveRange>()
    int activeCount = 0
    if not na(confirmed)
        for r in confirmed
            if not r.forming
                array.push(visible, r)
                if r.retiredReason == 0
                    activeCount += 1
    if formingAllowed and not na(ordinary)
        for r in ordinary
            if r.forming and activeCount < autoKeep and r.ends <= mainStart and f_forming(r, observedHigh, observedLow, observedLast)
                ActiveRange live = f_copy_range(r)
                live.upperPurged := r.upperPurged or observedHigh > r.hi
                live.lowerPurged := r.lowerPurged or observedLow < r.lo
                live.highTaken := live.upperPurged
                live.lowTaken := live.lowerPurged
                array.push(visible, live)
                activeCount += 1
    [visible, formingAllowed]

[mainMonthStart, mainMonthEnd, mainMonthHigh, mainMonthLow, mainMonthCovered] = f_main_forming_observation("1M", selectMonthly)
[mainWeekStart, mainWeekEnd, mainWeekHigh, mainWeekLow, mainWeekCovered] = f_main_forming_observation("1W", selectWeekly)
[mainDayStart, mainDayEnd, mainDayHigh, mainDayLow, mainDayCovered] = f_main_forming_observation("1D", selectDaily)

var array<ActiveRange> visibleMonthly = na
var bool monthlyFormingAllowed = false
var array<ActiveRange> visible3M = na
var array<ActiveRange> visible6M = na
var array<ActiveRange> visible12M = na
var array<ActiveRange> visibleWeekly = na
var bool weeklyFormingAllowed = false
var array<ActiveRange> visibleDaily = na
var bool dailyFormingAllowed = false
var array<ActiveRange> visibleH4 = na
var array<ActiveRange> visibleHourly = na
var array<ActiveRange> visibleM15 = na
var array<ActiveRange> visibleM5 = na
var array<ActiveRange> visibleM3 = na
var array<ActiveRange> visibleChart = na
// One native source request expression; each timeframe owns its independent
// persistent engine. Unlisted chart intervals now use this same 500-source-bar
// warm-up (above the maximum 240-range lifetime), instead of a second engine.
if requestParentEndpoint
    array<string> nativeTFs = array.from("1M", "1W", "1D", "3M", "6M", "12M", "15", "5", "3", timeframe.period)
    array<bool> nativeEnabled = array.from(selectMonthly, selectWeekly, selectDaily, select3M, select6M, select12M, selectM15, selectM5, selectM3, selectChart)
    for sourceIndex = 0 to array.size(nativeTFs) - 1
        if array.get(nativeEnabled, sourceIndex)
            string sourceTF = array.get(nativeTFs, sourceIndex)
            [ranges, endpointRanges, sourceStart, sourceEnd, endpointHigh, endpointLow, endpointLast] = request.security(syminfo.tickerid, sourceTF, f_native_bundle(), lookahead=barmerge.lookahead_on, calc_bars_count=500)
            if sourceIndex == 9
                if atStatusCapture
                    visibleChart := ranges
            else if sourceTF == "1M"
                [monthEndpointStart, monthEndpointEnd, monthEndpointHigh, monthEndpointLow, monthEndpointLast] = request.security(syminfo.tickerid, "1M", [time, time_close, high, low, close], lookahead=barmerge.lookahead_off, calc_bars_count=500)
                if atStatusCapture
                    [monthVisible, monthForming] = f_forming_display(ranges, na, sourceStart, sourceEnd, monthEndpointStart, monthEndpointEnd, monthEndpointHigh, monthEndpointLow, monthEndpointLast, mainMonthStart, mainMonthEnd, mainMonthHigh, mainMonthLow, mainMonthCovered)
                    visibleMonthly := monthVisible
                    monthlyFormingAllowed := monthForming
            else if sourceTF == "1W" or sourceTF == "1D"
                if atStatusCapture
                    bool week = sourceTF == "1W"
                    [sourceVisible, sourceForming] = f_forming_display(ranges, endpointRanges, sourceStart, sourceEnd, sourceStart, sourceEnd, endpointHigh, endpointLow, endpointLast, week ? mainWeekStart : mainDayStart, week ? mainWeekEnd : mainDayEnd, week ? mainWeekHigh : mainDayHigh, week ? mainWeekLow : mainDayLow, week ? mainWeekCovered : mainDayCovered)
                    if week
                        visibleWeekly := sourceVisible
                        weeklyFormingAllowed := sourceForming
                    else
                        visibleDaily := sourceVisible
                        dailyFormingAllowed := sourceForming
            else if atStatusCapture
                switch sourceTF
                    "3M" => visible3M := ranges
                    "6M" => visible6M := ranges
                    "12M" => visible12M := ranges
                    "15" => visibleM15 := ranges
                    "5" => visibleM5 := ranges
                    "3" => visibleM3 := ranges
f_hourly_bundle() =>
    [h4Ranges, h4Endpoint] = f_h4_views(true)
    [h4Ranges, h4Endpoint, f_shift_active(), time, time_close]

// On H4 charts the entire state machine still runs in the hourly context;
// only its final snapshot is transported. Never try to rebuild H4 from a single
// sampled hourly OHLC. Current snapshots only consume closed hourly candles.
// Both selected layers use the same closed-H1 source context and history bound.
// H1 is selectable only on charts <= H1, where this lookahead is unchanged.
if (selectH4 or selectHourly) and requestParentEndpoint
    [h4Ranges, h4Endpoint, hourRanges, hourStart, hourEnd] = request.security(syminfo.tickerid, "60", f_hourly_bundle(), lookahead=chartSeconds <= 3600 ? barmerge.lookahead_on : barmerge.lookahead_off, calc_bars_count=8000)
    if atStatusCapture and selectH4
        bool terminalHourClosed = barstate.isconfirmed and hourStart < time_close and hourEnd > time and hourEnd <= statusKnownEnd
        visibleH4 := terminalHourClosed and not na(h4Endpoint) ? h4Endpoint : h4Ranges
    if atStatusCapture and selectHourly
        visibleHourly := hourRanges

var array<box> autoBoxes = array.new<box>()
var array<line> autoLines = array.new<line>()
var array<label> autoLabels = array.new<label>()
var array<box> rangeInfoAreas = array.new<box>()
var array<label> rangeInfoLabels = array.new<label>()
var array<bool> rangeInfoBottom = array.new<bool>()
var array<string> rangeInfoDetails = array.new<string>()
var array<color> rangeInfoInk = array.new<color>()
var array<ActiveRange> spotlightSelection = array.new<ActiveRange>()
color spotlightInk = color.rgb(217,119,6)
f_is_spotlight(ActiveRange r) =>
    bool selected = false
    if spotlightOn and array.size(spotlightSelection) > 0
        ActiveRange chosen = array.first(spotlightSelection)
        selected := r.sourceTF == chosen.sourceTF and r.begins == chosen.begins
    selected
// Presentation scale uses offered main bars only, never the chart viewport.
float titlePriceSpan = math.max(ta.highest(high, 100) - ta.lowest(low, 100), syminfo.mintick * 50)
// One global presentation budget, separate from numerical source-state limits.
var array<int> visibleRangeCount = array.new<int>(1, 0)
f_claim_range_slot() =>
    bool allowed = autoOn and array.get(visibleRangeCount, 0) < maxVisibleRangeBoxes
    if allowed
        array.set(visibleRangeCount, 0, array.get(visibleRangeCount, 0) + 1)
    allowed

f_clear_active() =>
    for area in autoBoxes
        box.delete(area)
    for ray in autoLines
        line.delete(ray)
    for caption in autoLabels
        label.delete(caption)
    array.clear(autoBoxes)
    array.clear(autoLines)
    array.clear(autoLabels)
    array.clear(rangeInfoAreas)
    array.clear(rangeInfoLabels)
    array.clear(rangeInfoBottom)
    array.clear(rangeInfoDetails)
    array.clear(rangeInfoInk)
    array.set(visibleRangeCount, 0, 0)
    0

// The title itself is the hover target. Center it outside the source rectangle
// on the same purge side; preserve its title, variant and full hover details.
// Padding is proportional to the original range, not the current viewport.
// Pixel-size text cannot be clipped to a Pine box; tiny ranges can overflow.
f_range_info(box area, string detail, color ink, string title, bool bottom = false, string titleSize = size.tiny, int anchorTime = na) =>
    int left = box.get_left(area)
    int right = box.get_right(area)
    // Automatic purged ranges use the original source candle's time. Other
    // range families retain their centered captions unless explicitly anchored.
    int infoX = na(anchorTime) ? left + int((right - left) * 0.5) : anchorTime
    float top = box.get_top(area)
    float bottomPrice = box.get_bottom(area)
    // Every range family and later objective update keeps the same geometry metadata.
    // Scheduled ranges can still be forming, so this is the displayed window.
    string fullDetail = detail + "\n\nHigh " + str.tostring(top, format.mintick) + " | Low " + str.tostring(bottomPrice, format.mintick) + "\nDisplayed range window: " + str.format_time(left, "yyyy-MM-dd HH:mm", TZ) + " to " + str.format_time(right, "yyyy-MM-dd HH:mm", TZ) + " (" + TZ + ")"
    float padY = (top - bottomPrice) * 0.02
    float infoY = bottom ? bottomPrice - padY : top + padY
    string titleStyle = bottom ? label.style_label_up : label.style_label_down
    int index = array.indexof(rangeInfoAreas, area)
    label info = index >= 0 ? array.get(rangeInfoLabels, index) : na
    if na(info)
        info := label.new(infoX, infoY, title, tooltip=fullDetail, xloc=xloc.bar_time, yloc=yloc.price, style=titleStyle, color=color.new(chart.bg_color, 100), textcolor=rangeLabelTextColor, textalign=text.align_center, size=titleSize, force_overlay=true)
        array.push(rangeInfoAreas, area)
        array.push(rangeInfoLabels, info)
        array.push(rangeInfoBottom, bottom)
        array.push(rangeInfoDetails, fullDetail)
        array.push(rangeInfoInk, ink)
    else
        label.set_xy(info, infoX, infoY)
        label.set_style(info, titleStyle)
        label.set_tooltip(info, fullDetail)
        label.set_text(info, title)
        label.set_textcolor(info, rangeLabelTextColor)
        label.set_size(info, titleSize)
        array.set(rangeInfoBottom, index, bottom)
        array.set(rangeInfoDetails, index, fullDetail)
        array.set(rangeInfoInk, index, ink)
    info

// One final presentation pass, rather than repeating layout in each draw call.
// Width/height are conservative data-coordinate estimates, not pixel bounds.
// At most 50 titles; monotone outward placement clears each prior footprint.
// Intersecting or adjoining boxes get a source-edge callout so a
// caption cannot silently look like it belongs to the neighboring range.
// No label is hidden, moved to the opposite side, or moved to a DOL price.
f_layout_range_titles() =>
    array<bool> calloutRequired = array.new<bool>()
    array<int> occupiedCenter = array.new<int>()
    array<int> occupiedLeft = array.new<int>()
    array<int> occupiedRight = array.new<int>()
    array<float> occupiedLow = array.new<float>()
    array<float> occupiedHigh = array.new<float>()
    int count = array.size(rangeInfoLabels)
    if count > 0
        for i = 0 to count - 1
            box area = array.get(rangeInfoAreas, i)
            label info = array.get(rangeInfoLabels, i)
            bool bottom = array.get(rangeInfoBottom, i)
            color ink = array.get(rangeInfoInk, i)
            bool ambiguousSource = false
            // Sharing a time boundary also matters: adjacent H1 source boxes
            // can have overlapping price spans and visually shared corners.
            if count > 1
                for otherIndex = 0 to count - 1
                    if otherIndex != i
                        box other = array.get(rangeInfoAreas, otherIndex)
                        bool touchesTime = box.get_left(area) <= box.get_right(other) and box.get_right(area) >= box.get_left(other)
                        bool overlapsPrice = box.get_bottom(area) < box.get_top(other) and box.get_top(area) > box.get_bottom(other)
                        ambiguousSource := ambiguousSource or (touchesTime and overlapsPrice)
            string compact = str.replace_all(label.get_text(info), " | ", "\n")
            array<string> rows = str.split(compact, "\n")
            int columns = 1
            for row in rows
                columns := math.max(columns, str.length(row))
            int x = label.get_x(info)
            // Intersecting source windows must share the price-lane check even
            // when a lower chart is zoomed out enough to compress many bars.
            int halfWidth = int(math.max(chartSeconds * 1000 * math.max(3.0, columns * 0.45), (box.get_right(area) - box.get_left(area)) * 0.5))
            int titleLeft = x - halfWidth
            int titleRight = x + halfWidth
            // Text height follows the recent chart scale, not 10% of a huge
            // retained quarterly/yearly box that can push adjacent titles offscreen.
            float rowHeight = titlePriceSpan * (timeframe.ismonthly ? 0.014 : 0.018)
            float height = rowHeight * array.size(rows)
            float gap = rowHeight * 0.35
            float originalY = label.get_y(info)
            float edge = bottom ? box.get_bottom(area) : box.get_top(area)
            float calloutGap = rowHeight * 0.6
            float y = ambiguousSource ? (bottom ? math.min(originalY, edge - calloutGap) : math.max(originalY, edge + calloutGap)) : originalY
            bool crowded = false
            // Reserve all real source-anchor points before routing. A caption
            // may cover a neighboring box interior, but never hide its pointer.
            // Monotone moves clear one of count source points or i prior titles.
            for attempt = 0 to count + i
                float nextY = y
                float titleLow = bottom ? y - height : y
                float titleHigh = bottom ? y : y + height
                for anchorIndex = 0 to count - 1
                    if anchorIndex != i
                        box anchorArea = array.get(rangeInfoAreas, anchorIndex)
                        int anchorX = label.get_x(array.get(rangeInfoLabels, anchorIndex))
                        float anchorY = array.get(rangeInfoBottom, anchorIndex) ? box.get_bottom(anchorArea) : box.get_top(anchorArea)
                        if titleLeft <= anchorX and titleRight >= anchorX and titleLow < anchorY + gap and titleHigh > anchorY - gap
                            nextY := bottom ? math.min(nextY, anchorY - gap) : math.max(nextY, anchorY + gap)
                if i > 0
                    for j = 0 to i - 1
                        bool crossesTime = titleLeft <= array.get(occupiedRight, j) and titleRight >= array.get(occupiedLeft, j)
                        bool crossesPrice = titleLow < array.get(occupiedHigh, j) + gap and titleHigh > array.get(occupiedLow, j) - gap
                        if crossesTime and crossesPrice
                            nextY := bottom ? math.min(nextY, array.get(occupiedLow, j) - gap) : math.max(nextY, array.get(occupiedHigh, j) + gap)
                crowded := nextY != y
                if not crowded
                    break
                y := nextY
            label.set_text(info, compact)
            label.set_y(info, y)
            array.push(calloutRequired, ambiguousSource or y != originalY)
            array.push(occupiedCenter, x)
            array.push(occupiedLeft, titleLeft)
            array.push(occupiedRight, titleRight)
            array.push(occupiedLow, bottom ? y - height : y)
            array.push(occupiedHigh, bottom ? y : y + height)
        // Route after every caption is placed, so earlier leaders also avoid
        // later co-centered captions. No chart viewport information is read.
        for i = 0 to count - 1
            if array.get(calloutRequired, i)
                box area = array.get(rangeInfoAreas, i)
                label info = array.get(rangeInfoLabels, i)
                bool bottom = array.get(rangeInfoBottom, i)
                color ink = array.get(rangeInfoInk, i)
                int x = label.get_x(info)
                float y = label.get_y(info)
                float edge = bottom ? box.get_bottom(area) : box.get_top(area)
                // Dotted connector ends at the owning source edge, never the DOL.
                // The short edge accent stays inside the original time window.
                array.push(autoLines, line.new(box.get_left(area), edge, box.get_right(area), edge, xloc=xloc.bar_time, color=rangeGuideColor, width=2, style=line.style_solid, force_overlay=true))
                bool sharedStem = false
                int routeLeft = x
                int routeRight = x
                if count > 1
                    for j = 0 to count - 1
                        // Co-centered nested ranges need an elbow: a vertical
                        // shared stem otherwise runs through the nearer caption.
                        bool sameCenter = i != j and x == array.get(occupiedCenter, j)
                        bool crossesCaption = math.min(edge, y) < array.get(occupiedHigh, j) and math.max(edge, y) > array.get(occupiedLow, j)
                        if sameCenter and crossesCaption
                            sharedStem := true
                            routeLeft := math.min(routeLeft, array.get(occupiedLeft, j))
                            routeRight := math.max(routeRight, array.get(occupiedRight, j))
                if sharedStem
                    // Only the genuinely shared-center case takes a detour.
                    // Differing-center H1 callouts remain short and direct.
                    int routeGap = int(math.max(chartSeconds * 1000, 1))
                    bool routeToLeft = x - routeLeft < routeRight - x or (x - routeLeft == routeRight - x and i % 2 == 0)
                    int routeX = routeToLeft ? routeLeft - routeGap * (i + 1) : routeRight + routeGap * (i + 1)
                    array.push(autoLines, line.new(x, edge, routeX, edge, xloc=xloc.bar_time, color=rangeGuideColor, width=1, style=line.style_dotted, force_overlay=true))
                    array.push(autoLines, line.new(routeX, edge, routeX, y, xloc=xloc.bar_time, color=rangeGuideColor, width=1, style=line.style_dotted, force_overlay=true))
                    array.push(autoLines, line.new(routeX, y, x, y, xloc=xloc.bar_time, color=rangeGuideColor, width=1, style=line.style_dotted, force_overlay=true))
                else
                    array.push(autoLines, line.new(x, edge, x, y, xloc=xloc.bar_time, color=rangeGuideColor, width=1, style=line.style_dotted, force_overlay=true))
                label.set_color(info, color.new(chart.bg_color, 10))
                label.set_tooltip(info, array.get(rangeInfoDetails, i) + "\nDotted caption connector identifies this range's source high/low; an eye, when present, marks its DOL.")
    0

// The eye is centered on the actual line endpoint. Never lane-shift targets.
f_dol_eye(line targetLine, color ink, string detail) =>
    label.new(line.get_x2(targetLine), line.get_y2(targetLine), "👁️", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=color.new(chart.bg_color, 100), textcolor=ink, size=size.small, tooltip=detail, force_overlay=true)

// A native weekly candle belongs to its trading-week Monday in the exchange
// timezone. Sunday evening maps forward; holiday-delayed Tue-Sat maps back.
// timestamp calendar arithmetic avoids adding/subtracting 24h across DST.
f_week_title(int begins) =>
    string result = "Weekly (date unavailable)"
    if not na(begins)
        int weekday = dayofweek(begins, syminfo.timezone)
        int mondayOffset = weekday == dayofweek.sunday ? 1 : dayofweek.monday - weekday
        int monday = timestamp(syminfo.timezone, year(begins, syminfo.timezone), month(begins, syminfo.timezone), dayofmonth(begins, syminfo.timezone) + mondayOffset, 12, 0)
        int weekInMonth = int((dayofmonth(monday, syminfo.timezone) - 1) / 7) + 1
        result := "Week" + str.tostring(weekInMonth) + " (" + str.format_time(monday, "MMMM yyyy", syminfo.timezone) + ")"
    result

// Preserve each source's title, without injecting multiline status text.
f_range_tag_title(ActiveRange r) =>
    // Native source-period offsets avoid extra requests, duplicated state
    // engines and wall-clock arithmetic across overnight sessions/weekends.
    bool previous = r.begins == time(r.sourceTF, timeframe_bars_back=1)
    if r.sourceTF == "240" and not h4ChartMode
        // Fixed GTOP windows use their own previous-window identity.
        int referenceTime = barstate.isrealtime ? timenow : statusKnownEnd
        [currentStart, currentEnd] = f_gtop_h4_window(referenceTime)
        previous := r.ends == currentStart
    string datedTitle = r.sourceTF == "1W" ? f_week_title(r.begins) : str.replace_all(str.replace_all(r.title, "\n", " "), " | ", " · ")
    if r.sourceTF == "240"
        datedTitle := (h4ChartMode ? "Chart H4" : "GTOP H4 · " + f_h4_title(r.begins)) + "\n" + f_h4_window_text(r.begins, r.ends) + " · " + str.format_time(r.begins, "MMM d", TZ)
    string periodName = switch r.sourceTF
        "1M" => "Month"
        "1W" => "Week"
        "1D" => "Day"
        "60" => "Hour"
        "240" => "4H"
        "15" => "15 Minutes"
        "5" => "5 Minutes"
        "3" => "3 Minutes"
        "3M" => "Quarter"
        "6M" => "Half-Year"
        "12M" => "Year"
        => r.sourceTF + " Candle"
    (previous ? "Previous " + periodName + " · " : "") + datedTitle

// Variant-only title suffix. Codes come from the existing candle classifier;
// invalidated or coverage-unknown history must never look completed/pending.
f_range_variant_title(ActiveRange r) =>
    bool completed = not r.forming and r.retiredReason == 2 and r.deliverySourceClosed
    // Title-only virtual observation; never copy or mutate lifecycle fields.
    bool firstFormingPurge = r.forming and r.retiredReason == 0 and not r.closedBackInside and r.manipulationNumber == 0 and ((r.upperPurged and not r.lowerPurged and not r.lowTaken) or (r.lowerPurged and not r.upperPurged and not r.highTaken))
    string codes = not r.forming or firstFormingPurge ? f_variant_codes(r, completed, firstFormingPurge) : ""
    string result = codes == "" ? "Variant unclassified" : (completed ? "Completed " : "Potential ") + codes
    if completed and not na(r.doublePurgeAt)
        result += not na(r.returnObjectiveAt) ? " · Double purge · Return objective reached" : " · Double purge"
    if r.retiredReason == 2 and not r.deliverySourceClosed
        result := "Objective observed · variant awaiting source close"
    else if r.retiredReason != 0 and not completed
        result := r.retiredReason == 3 ? "Variant unverified" : "Variant not completed"
    result

// Main-chart presentation references only; never transported through requests.
// Keep source arrays by reference and preserve the existing per-layer schedule.
type ActiveDrawLayer
    array<ActiveRange> ranges
    color ink
    bool formingPass = false

f_draw_active(array<ActiveRange> ranges, color ink, int visibleEnd, int historyPass = -1) =>
    // Stop presentation work once its existing global cap has been filled.
    if not na(ranges) and array.get(visibleRangeCount, 0) < maxVisibleRangeBoxes
        array<int> starts = array.new<int>()
        for item in ranges
            array.push(starts, item.begins)
        for index in array.sort_indices(starts, historyPass == 1 ? order.descending : order.ascending)
            if array.get(visibleRangeCount, 0) >= maxVisibleRangeBoxes
                break
            ActiveRange r = array.get(ranges, index)
            bool spotlight = f_is_spotlight(r)
            int leftX = r.begins
            bool archived = r.retiredReason != 0
            int evidenceEnd = r.forming and barstate.isrealtime ? math.min(timenow, time_close) : statusKnownEnd
            bool historyEligible = archived and historyOn and (r.closedBackInside or r.sameCandleV2) and (not na(r.doublePurgeAt) or r.sourceTF == chartTF or r.sourceTF == parentTF or r.sourceTF == "240") and r.retiredAt <= evidenceEnd
            // Box geometry is always the source period, never the viewing edge or retirement time.
            int rightX = r.ends
            bool selectedPass = historyPass == -2 ? spotlight : not spotlight and (historyPass == -1 or historyPass == (archived ? 1 : r.forming ? 2 : 0))
            if selectedPass and (not archived and (r.forming ? (r.sourceTF == "1M" ? monthlyFormingAllowed : r.sourceTF == "1D" ? dailyFormingAllowed : weeklyFormingAllowed) : f_relevant(r)) or historyEligible) and not na(evidenceEnd) and r.ends <= evidenceEnd and leftX < visibleEnd and leftX < rightX and f_claim_range_slot()
                bool drawLow = r.upperPurged and not r.lowTaken
                bool drawHigh = r.lowerPurged and not r.highTaken
                string variantTitle = f_range_variant_title(r)
                string status = r.retiredReason == 3 ? "History · Coverage unknown" : r.retiredReason == 2 ? "History · Objective delivered" : archived ? "History · Invalidated by source close" : r.forming ? "Forming · source close pending" : "Confirmed · objective pending"
                status += "\n" + variantTitle
                string compactSource = f_range_tag_title(r)
                string compactTitle = (spotlight ? "▶ " : "") + compactSource + "\n" + variantTitle
                // One fact-complete tooltip serves the source title and its eye.
                // Status already includes the variant summary.
                string tagDetail = compactSource + "\n" + r.title + " | " + status
                tagDetail += not na(r.returnClose) ? "\nStrict-inside return: " + str.format_time(r.returnOpen, "MMM d HH:mm", TZ) + " candle; confirmed at " + str.format_time(r.returnClose, "MMM d HH:mm", TZ) + " NY." : "\nStrict-inside source return not confirmed."
                if archived and not na(r.doublePurgeAt)
                    tagDetail += "\nOpposing purge confirmed by source closure " + str.format_time(r.doublePurgeAt, "MMM d HH:mm", TZ) + " (" + TZ + ")."
                    tagDetail += not na(r.returnObjectiveAt) ? "\nReturn objective confirmed by source closure " + str.format_time(r.returnObjectiveAt, "MMM d HH:mm", TZ) + " (" + TZ + ")." : "\nReturn objective not yet confirmed by a later source candle."
                if archived
                    // Purge identity survives delivery; pending-DOL flags do not.
                    string purgeSide = r.upperPurged and r.lowerPurged ? "Both sides purged" : r.upperPurged ? "Buy-side purged" : r.lowerPurged ? "Sell-side purged" : "Purge unverified"
                    tagDetail += "\n" + purgeSide
                // The source rectangle stays quiet; its centered outside title carries the full tooltip.
                box area = box.new(leftX, r.hi, rightX, r.lo, xloc=xloc.bar_time, bgcolor=color.new(spotlight ? spotlightInk : color.gray, spotlight ? 80 : archived ? 98 : autoFill), border_color=spotlight ? spotlightInk : rangeGuideColor, border_width=spotlight ? 3 : 1, border_style=line.style_solid, force_overlay=true)
                array.push(autoBoxes, area)
                if archived
                    tagDetail += "\nRetired " + str.format_time(r.retiredAt, "yyyy-MM-dd HH:mm", TZ) + " NY. Closed OHLC; intrabar order needs finer data."
                    if r.retiredReason == 1 and r.objectiveAtRetirement
                        tagDetail += "\nObjective also touched in the outside-close candle; order unresolved."
                    if r.retiredReason == 2 and r.outsideCloseAtRetirement
                        tagDetail += "\nObjective touch preceded or coincided with the outside close."
                tagDetail += "\nObserved candles: " + str.tostring(r.observedCandles) + "; prior inside bars: " + str.tostring(r.insideBefore)
                if r.resoupPending
                    tagDetail += "\nSecond purge observed; strict-inside source close pending."
                if r.resoup
                    tagDetail += "\nManipulation extreme re-purged before full objective."
                if r.sameCandleV2
                    tagDetail += "\nV2: open inside, purge, then opposite close."
                // Keep the source box fixed. Its one pending DOL also covers the
                // source boundary, so panning inside the source still shows that edge.
                if not archived and autoDol and (drawLow or drawHigh)
                    float dol = drawLow ? r.lo : r.hi
                    int endX = math.max(rightX, evidenceEnd)
                    line dolLine = line.new(leftX, dol, endX, dol, xloc=xloc.bar_time, color=spotlight ? spotlightInk : rangeGuideColor, width=spotlight ? 3 : 1, style=line.style_solid, force_overlay=true)
                    array.push(autoLines, dolLine)
                    // Parent DOL depends only on its own source range lifecycle.
                    string dolDisplay = (r.forming ? "👀 Provisional DOL " : "👀 DOL ") + (drawLow ? "low" : "high")
                    tagDetail += "\n" + dolDisplay + " | " + str.tostring(dol, format.mintick) + (r.forming ? "\nPrice inside; source close/variant pending. Without realtime data, provisional DOL ends at the available anchor." : "\nVariants use offered source closes; full calendar coverage unverified.")
                    array.push(autoLabels, f_dol_eye(dolLine, ink, tagDetail))
                if rangeLabels
                    // Anchor the caption and its extension at the original source
                    // candle's purged high/low, not halfway toward the purge candle.
                    // Purge flags retain their identity after DOL delivery.
                    // If no unique side is known, use above-center without inferring one.
                    bool titleAtBottom = r.lowerPurged and not r.upperPurged
                    int titleAnchor = r.upperPurged != r.lowerPurged ? r.begins : na
                    array.push(autoLabels, f_range_info(area, tagDetail, ink, compactTitle, titleAtBottom, archived ? size.tiny : size.small, titleAnchor))
                if autoMidpoints
                    float middle = math.avg(r.hi, r.lo)
                    array.push(autoLines, line.new(leftX, middle, rightX, middle, xloc=xloc.bar_time, color=color.new(ink, 50), style=line.style_dotted, force_overlay=true))
    0

// Pine has no carriage-return escape: do not use a literal \r replacement,
// which would replace lowercase r. Normalize only supported newline escapes.
f_sticky_text(string rule1, string rule2, string rule3, string rule4, string rule5, string rule6) =>
    string note = ""
    for rule in array.from(rule1, rule2, rule3, rule4, rule5, rule6)
        string clean = str.trim(str.replace_all(rule, "\n", " "))
        if str.length(clean) > 0
            note += (note == "" ? "" : "\n") + clean
    note

// TradingView allows only one visible table at each anchor. Reserve the chosen
// note position only when it contains visible text; move any competing panel.
var string notePosition = str.replace_all(str.lower(stickyPosition), " ", "_")
var string noteText = f_sticky_text(stickyText, stickyRule2, stickyRule3, stickyRule4, stickyRule5, stickyRule6)
var bool noteVisible = stickyOn and str.length(noteText) > 0
f_note_free_position(string preferred, string fallback) =>
    noteVisible and notePosition == preferred ? fallback : preferred

var table brandMark = table.new(f_note_free_position(position.top_left, position.middle_left), 1, 2, force_overlay=true)
var table stickyNote = table.new(noteVisible ? notePosition : position.middle_center, 1, 1, force_overlay=true)
var table chartMark = table.new(f_note_free_position(position.bottom_right, position.middle_right), 1, 1, force_overlay=true)
f_watermark() =>
    table.clear(brandMark, 0, 0, 0, 1)
    table.clear(stickyNote, 0, 0, 0, 0)
    table.clear(chartMark, 0, 0, 0, 0)
    if watermarkOn
        table.cell(brandMark, 0, 0, watermarkTitle, text_color=watermarkInk, text_size=size.normal, text_halign=text.align_left)
        table.cell(brandMark, 0, 1, watermarkMotto, text_color=watermarkInk, text_size=size.normal, text_halign=text.align_left)
        if watermarkInfo
            table.cell(chartMark, 0, 0, str.format_time(headOpen, "MMM d, yyyy", TZ) + "\n" + syminfo.ticker + " | " + timeframe.period, text_color=watermarkInk, text_size=size.normal, text_halign=text.align_right)
    if noteVisible
        // Compose opacity so either control can make the fill fully transparent.
        float noteTransparency = 100.0 - (100.0 - color.t(stickyColor)) * (100.0 - stickyFade) / 100.0
        string noteAlignment = stickyAlign == "Left" ? text.align_left : stickyAlign == "Center" ? text.align_center : text.align_right
        table.cell(stickyNote, 0, 0, noteText, bgcolor=color.new(stickyColor, noteTransparency), text_color=watermarkInk, text_size=stickySize, text_halign=noteAlignment)
    0

// SELECTED ANCHOR RETRIEVAL ---------------------------------------------------
// Runs in the source timeframe. The [1] values are already closed; lookahead_on
// maps availability from the NEXT source bar without leaking the selected close.
f_pick_source(int selected) =>
    bool picked = time[1] <= selected and selected < time_close[1]
    [ta.valuewhen(picked, high[1], 0), ta.valuewhen(picked, low[1], 0), ta.valuewhen(picked, time[1], 0), ta.valuewhen(picked, time_close[1], 0)]

// Manual H4 selections can reference any GTOP window, not a fixed example.
f_pick_h4(int selected) =>
    int hr = hour(selected, TZ)
    int firstHour = hr < 1 ? 21 : 1 + int(math.floor((hr - 1) / 4.0)) * 4
    [begins, ends] = f_window(selected, firstHour, firstHour + 4)
    var float chosenH = na
    var float chosenL = na
    var int coverageEnd = na
    var bool incomplete = false
    var bool complete = false
    if time[1] >= begins and time[1] < ends and time_close[1] <= ends
        if na(chosenH)
            chosenH := high[1]
            chosenL := low[1]
            incomplete := time[1] != begins
        else
            incomplete := incomplete or time[1] > coverageEnd
            chosenH := math.max(chosenH, high[1])
            chosenL := math.min(chosenL, low[1])
        coverageEnd := time_close[1]
        if coverageEnd == ends
            complete := not incomplete
    [complete ? chosenH : na, complete ? chosenL : na, complete ? begins : na, complete ? ends : na]

f_pick_model(int selected, string direction) =>
    var float chosenH = na
    var float chosenL = na
    var float chosenO = na
    var float chosenC = na
    var int chosenS = na
    var int chosenE = na
    var int cisdAt = na
    if time[1] <= selected and selected < time_close[1]
        chosenH := high[1]
        chosenL := low[1]
        chosenO := open[1]
        chosenC := close[1]
        chosenS := time[1]
        chosenE := time_close[1]
        cisdAt := na
    if not na(chosenE) and time[1] >= chosenE and na(cisdAt)
        bool confirms = (direction == "Bearish" or direction == "Bullish") and f_gtop_cisd(close[1], chosenH, chosenL, direction == "Bearish")
        if confirms
            cisdAt := time_close[1]
    [chosenH, chosenL, chosenS, chosenE, cisdAt, chosenO, chosenC]

type SelectedAnchor
    string title
    string timeframeName
    int selectedTime
    float sourceSeconds
    string relevance
    string direction
    string objective
    color ink
    int fade
    bool manual
    float manualH
    float manualL
    int manualS
    int manualE
    float hi = na
    float lo = na
    int begins = na
    int ends = na
    bool ready = false

var array<SelectedAnchor> anchors = array.new<SelectedAnchor>()
if barstate.isfirst
    array.push(anchors, SelectedAnchor.new(maTitle, "1M", maDate, timeframe.in_seconds("1M"), maStatus, maDirection, maObjective, maColor, maFade, maMode == "Manual bounds", maHigh, maLow, maStart, maEnd))
    array.push(anchors, SelectedAnchor.new(mbTitle, "1M", mbDate, timeframe.in_seconds("1M"), mbStatus, mbDirection, mbObjective, mbColor, mbFade, mbMode == "Manual bounds", mbHigh, mbLow, mbStart, mbEnd))
    array.push(anchors, SelectedAnchor.new(waTitle, "1W", waDate, timeframe.in_seconds("1W"), waStatus, waDirection, waObjective, waColor, waFade, waMode == "Manual bounds", waHigh, waLow, waStart, waEnd))
    array.push(anchors, SelectedAnchor.new(daTitle, "1D", daDate, timeframe.in_seconds("1D"), daStatus, daDirection, daObjective, daColor, daFade, daMode == "Manual bounds", daHigh, daLow, daStart, daEnd))
    array.push(anchors, SelectedAnchor.new(haTitle, h4ChartMode ? "Chart H4" : "GTOP H4 NY", haDate, 14400.0, haStatus, haDirection, haObjective, haColor, haFade, haMode == "Manual bounds", haHigh, haLow, haStart, haEnd))

f_capture_anchor(int index, float h, float l, int begins, int ends) =>
    if atStatusCapture
        SelectedAnchor anchor = array.get(anchors, index)
        anchor.hi := anchor.manual ? anchor.manualH : h
        anchor.lo := anchor.manual ? anchor.manualL : l
        anchor.begins := anchor.manual ? anchor.manualS : begins
        anchor.ends := anchor.manual ? anchor.manualE : ends
        if index == 2 and waTitle == "Weekly" and not na(anchor.begins)
            anchor.title := f_week_title(anchor.begins)
        if index == 4 and not anchor.manual and haTitle == "H4 session" and not na(begins)
            anchor.title := f_h4_range_title(begins, ends)
        anchor.ready := not na(anchor.hi) and not na(anchor.lo) and anchor.hi > anchor.lo and not na(anchor.begins) and not na(anchor.ends) and anchor.begins < anchor.ends and anchor.ends <= statusKnownEnd and (index != 4 or chartSeconds <= 3600 or time >= anchor.ends)
    0

if stackOn and chartSeconds <= timeframe.in_seconds("1M")
    [mah, mal, mas, mae] = request.security(syminfo.tickerid, "1M", f_pick_source(maDate), lookahead=barmerge.lookahead_on, calc_bars_count=600)
    f_capture_anchor(0, mah, mal, mas, mae)

if stackOn and chartSeconds <= timeframe.in_seconds("1M")
    [mbh, mbl, mbs, mbe] = request.security(syminfo.tickerid, "1M", f_pick_source(mbDate), lookahead=barmerge.lookahead_on, calc_bars_count=600)
    f_capture_anchor(1, mbh, mbl, mbs, mbe)

if stackOn and chartSeconds <= timeframe.in_seconds("1W")
    [wah, wal, was, wae] = request.security(syminfo.tickerid, "1W", f_pick_source(waDate), lookahead=barmerge.lookahead_on, calc_bars_count=600)
    f_capture_anchor(2, wah, wal, was, wae)

if stackOn and chartSeconds <= timeframe.in_seconds("1D")
    [dah, dal, das, dae] = request.security(syminfo.tickerid, "1D", f_pick_source(daDate), lookahead=barmerge.lookahead_on, calc_bars_count=600)
    f_capture_anchor(3, dah, dal, das, dae)

if stackOn and chartSeconds <= 14400
    if h4ChartMode
        [hah, hal, has, hae] = request.security(syminfo.tickerid, "240", f_pick_source(haDate), lookahead=barmerge.lookahead_on, calc_bars_count=2000)
        f_capture_anchor(4, hah, hal, has, hae)
    else
        [hah, hal, has, hae] = request.security(syminfo.tickerid, "60", f_pick_h4(haDate), lookahead=barmerge.lookahead_on, calc_bars_count=8000)
        f_capture_anchor(4, hah, hal, has, hae)

var float modelH = na
var float modelL = na
var float modelO = na
var float modelC = na
var int modelS = na
var int modelE = na
var int modelCisd = na
bool modelTfVisible = chartSeconds <= timeframe.in_seconds(selectedModelTF)
if stackOn and selectedModelOn and modelTfVisible
    [mh, ml, ms, me, mc, mo, mclose] = request.security(syminfo.tickerid, selectedModelTF, f_pick_model(selectedModelDate, selectedModelDirection), lookahead=barmerge.lookahead_on, calc_bars_count=100000)
    if atStatusCapture
        modelH := mh
        modelL := ml
        modelO := mo
        modelC := mclose
        modelS := ms
        modelE := me
        modelCisd := mc

var array<box> stackBoxes = array.new<box>()
var array<line> stackLines = array.new<line>()
var array<label> stackLabels = array.new<label>()

f_clear_stack() =>
    for drawing in stackBoxes
        box.delete(drawing)
    for drawing in stackLines
        line.delete(drawing)
    for drawing in stackLabels
        label.delete(drawing)
    array.clear(stackBoxes)
    array.clear(stackLines)
    array.clear(stackLabels)
    0

f_anchor_name(SelectedAnchor anchor) =>
    int priorMonth = timestamp(TZ, year(headOpen, TZ), month(headOpen, TZ) - 1, 15, 12)
    bool previousMonth = anchor.timeframeName == "1M" and not na(anchor.begins) and year(anchor.selectedTime, TZ) == year(priorMonth, TZ) and month(anchor.selectedTime, TZ) == month(priorMonth, TZ)
    anchor.title + (previousMonth ? " (PM)" : "")

f_render_stack(int visibleEnd) =>
    int evidenceEnd = statusKnownEnd
    f_clear_stack()
    if autoOn and stackOn
        for i = 0 to array.size(anchors) - 1
            SelectedAnchor anchor = array.get(anchors, i)
            bool scopeVisible = chartSeconds <= anchor.sourceSeconds
            bool eligible = anchor.relevance != "Retired" and anchor.ready and scopeVisible and anchor.ends <= evidenceEnd
            string caption = f_anchor_name(anchor)
            string anchorDetail = caption + " | " + anchor.relevance + " | Direction: " + anchor.direction
            bool visibleBody = anchor.begins < visibleEnd
            if eligible and visibleBody and f_claim_range_slot()
                color outline = color.new(anchor.ink, anchor.relevance == "Watch" ? 65 : 10)
                box area = na
                if anchor.begins < visibleEnd
                    area := box.new(anchor.begins, anchor.hi, anchor.ends, anchor.lo, xloc=xloc.bar_time, border_color=rangeGuideColor, border_width=1, bgcolor=color.new(anchor.ink, anchor.fade), force_overlay=true)
                    array.push(stackBoxes, area)
                    array.push(stackLabels, f_range_info(area, anchorDetail, color.rgb(50,50,50), caption, false, size.small))
                int rightEnd = visibleEnd + int(chartSeconds * 1000 * 3)
                if extendStackDol and anchor.objective != "Off" and anchor.relevance == "Relevant"
                    float target = anchor.objective == "High" ? anchor.hi : anchor.lo
                    line dolLine = line.new(anchor.ends, target, rightEnd, target, xloc=xloc.bar_time, color=rangeGuideColor, width=1, style=line.style_dashed, force_overlay=true)
                    array.push(stackLines, dolLine)
                    array.push(stackLabels, f_dol_eye(dolLine, outline, anchorDetail + "\nManually selected DOL " + str.lower(anchor.objective) + " | " + str.tostring(target, format.mintick) + "\nRelevance and objective are user selections; delivery is not automatically verified."))
                    f_range_info(area, anchorDetail + "\nDOL " + str.lower(anchor.objective) + " | " + str.tostring(target, format.mintick), color.rgb(45,45,45), caption, false, size.small)
        int chosenIndex = selectedModelAnchor == "Monthly A" ? 0 : selectedModelAnchor == "Monthly B" ? 1 : selectedModelAnchor == "Weekly" ? 2 : selectedModelAnchor == "Daily" ? 3 : 4
        SelectedAnchor linked = array.get(anchors, chosenIndex)
        bool linkedReady = linked.ready and linked.relevance == "Relevant" and not na(modelS) and linked.ends <= modelS
        bool modelReady = selectedModelOn and modelTfVisible and linkedReady and not na(modelH) and not na(modelL) and modelE <= evidenceEnd
        string expectedModelTF = f_gtop_assigned_tf(chosenIndex <= 1 ? "1M" : chosenIndex == 2 ? "1W" : chosenIndex == 3 ? "1D" : "240")
        bool assignedTFMatches = timeframe.in_seconds(selectedModelTF) == timeframe.in_seconds(expectedModelTF)
        bool localModelVerified = modelReady and assignedTFMatches and (selectedModelDirection == "Bearish" or selectedModelDirection == "Bullish") and f_gtop_body_purge(modelO, modelH, modelL, modelC, selectedModelDirection == "Bearish" ? linked.hi : linked.lo, selectedModelDirection == "Bearish")
        string execution = not selectedModelOn ? "Choose a Model1 candle and its CRT anchor" : not modelTfVisible ? "Use assigned execution timeframe or lower" : not modelReady ? "Model1 / earlier Relevant CRT anchor unavailable" : selectedModelDirection == "Unspecified" ? "Choose execution direction" : not assignedTFMatches ? "Selected candle unverified | assigned timeframe is " + expectedModelTF : not localModelVerified ? "Selected candle unverified | local body purge not established; paired SMT not assessed" : not na(modelCisd) and modelCisd <= evidenceEnd ? "CISD confirmed | strict full-range close" : selectedSetup == "Stand aside" ? "Stand aside (manual)" : "Model1 selected | waiting for CISD"
        if modelReady and selectedSetup != "Stand aside" and modelS < visibleEnd and f_claim_range_slot()
            box modelArea = box.new(modelS, modelH, modelE, modelL, xloc=xloc.bar_time, border_color=rangeGuideColor, border_style=line.style_solid, bgcolor=color.new(color.gray,96), force_overlay=true)
            array.push(stackBoxes, modelArea)
            string modelTitle = (localModelVerified ? "Model1 | " : "Selected candle · unverified | ") + selectedModelTF + " | " + linked.title
            array.push(stackLabels, f_range_info(modelArea, modelTitle + "\n" + execution + "\nDirection: " + selectedModelDirection, color.rgb(45,45,45), modelTitle))
    0

// BOUNDED ASSIGNED-TIMEFRAME EVIDENCE -----------------------------------------
// Explicit detail requests one assigned timeframe; automatic detail primes all
// five mapped contexts. Retain 512 closed candles per context, scan only at
// the main endpoint, and reject future evidence.
type EvidenceCandle
    int s
    int e
    float o
    float h
    float l
    float c
    int previousClose = na
    int projectedOpen = na
    int tradingDay = na

f_evidence_bars() =>
    var array<EvidenceCandle> bars = array.new<EvidenceCandle>()
    // Freeze the preceding source bar's calendar projection, not future OHLC.
    int nextOpening = time("", bars_back=-1)
    if not na(time[1])
        array.push(bars, EvidenceCandle.new(time[1], time_close[1], open[1], high[1], low[1], close[1], time_close[2], nextOpening[2], time_tradingday[1]))
        if array.size(bars) > 512
            array.shift(bars)
    barstate.islast ? bars : na

// Input rows are the same guarded visible snapshots used by the range drawings.
// A forming copy may be displayed, but never becomes source-confirmed here.
f_evidence_visible(ActiveRange r) =>
    r.retiredReason == 0 and (f_relevant(r) or r.forming)

f_has_active_evidence(array<ActiveRange> rows) =>
    bool found = false
    if not na(rows)
        for r in rows
            found := found or f_evidence_visible(r)
    found

// Snapshot references are reused by focus and overview, highest source first.
type EvidenceLayer
    array<ActiveRange> rows
    string tf
var array<EvidenceLayer> evidenceLayers = array.new<EvidenceLayer>()
if requestParentEndpoint
    evidenceLayers := array.from(EvidenceLayer.new(visible12M, "12M"), EvidenceLayer.new(visible6M, "6M"), EvidenceLayer.new(visible3M, "3M"), EvidenceLayer.new(visibleMonthly, "1M"), EvidenceLayer.new(visibleWeekly, "1W"), EvidenceLayer.new(visibleDaily, "1D"), EvidenceLayer.new(visibleH4, "240"), EvidenceLayer.new(visibleHourly, "60"), EvidenceLayer.new(visibleM15, "15"), EvidenceLayer.new(visibleM5, "5"), EvidenceLayer.new(visibleM3, "3"))
string chartParentTF = timeframe.period == "5" ? "60" : timeframe.period == "15" ? "240" : timeframe.period == "60" ? "1D" : timeframe.period == "240" ? "1W" : timeframe.period == "1D" ? "1M" : ""
string highestEvidenceTF = ""
string highestMappedTF = ""
bool chartParentActive = false
for layer in evidenceLayers
    if f_has_active_evidence(layer.rows)
        if highestEvidenceTF == ""
            highestEvidenceTF := layer.tf
        if highestMappedTF == "" and f_gtop_assigned_tf(layer.tf) != ""
            highestMappedTF := layer.tf
        chartParentActive := chartParentActive or layer.tf == chartParentTF
highestMappedTF := highestMappedTF == "" ? highestEvidenceTF : highestMappedTF
f_evidence_auto_tf(string mainTF, string focus, bool shiftActive, bool parentActive, string parent, string highest, string mapped) =>
    focus == "Highest relevant timeframe" ? highest : mainTF == "60" and shiftActive ? "60" : parentActive ? parent : mapped
string automaticDetailTF = f_evidence_auto_tf(timeframe.period, evidenceFocus, f_has_active_evidence(visibleHourly), chartParentActive, chartParentTF, highestEvidenceTF, highestMappedTF)
string evidenceTF = evidenceFocus != "Explicit parent layer" and evidenceAnchor == 0 and automaticDetailTF != "" ? automaticDetailTF : evidenceTFChoice

array<EvidenceCandle> assignedEvidence = na
string evidenceAssignedTF = f_gtop_assigned_tf(evidenceTF)
if evidenceNeeded and requestParentEndpoint
    // Request contexts depend only on inputs and fixed canonical mappings,
    // never on the parent engine outputs. Retain only the focused array.
    for assignedTF in array.from("5", "15", "60", "240", "1D")
        if evidenceFocus != "Explicit parent layer" or assignedTF == f_gtop_assigned_tf(evidenceTFChoice)
            // Lower chart intervals need the last intrabar snapshot; the
            // higher/equal path retains the confirmed [1] plus lookahead-on rule.
            array<EvidenceCandle> offered = na
            if timeframe.in_seconds(assignedTF) < chartSeconds
                offered := request.security(syminfo.tickerid, assignedTF, f_evidence_bars(), lookahead=barmerge.lookahead_off, calc_bars_count=514)
            else
                offered := request.security(syminfo.tickerid, assignedTF, f_evidence_bars(), lookahead=barmerge.lookahead_on, calc_bars_count=514)
            if assignedTF == evidenceAssignedTF
                assignedEvidence := offered

f_evidence_range(array<ActiveRange> rows) =>
    ActiveRange chosen = na
    int bestRank = 100
    if not na(rows)
        for r in rows
            if r.sourceTF == evidenceTF and (evidenceFocus == "Explicit parent layer" or highestEvidenceTF != "" or evidenceHistory or evidenceAnchor != 0) and (evidenceAnchor == 0 or r.begins == evidenceAnchor) and (r.retiredReason == 0 or (historyOn and evidenceHistory))
                int rank = r.retiredReason == 0 and f_relevant(r) ? 0 : r.retiredReason == 0 and (r.upperPurged or r.lowerPurged) ? 1 : r.retiredReason != 0 ? 2 : 3
                if na(chosen) or rank < bestRank or rank == bestRank and (rank == 0 ? r.begins < chosen.begins : r.begins > chosen.begins)
                    chosen := r
                    bestRank := rank
    chosen

// Keep all available active parents in oldest-first order, up to the same
// existing per-layer limit (maximum eight). Explicit opening remains singular.
f_evidence_ranges(array<ActiveRange> rows) =>
    array<ActiveRange> selected = array.new<ActiveRange>()
    if not na(rows) and evidenceAnchor == 0
        for r in rows
            if r.sourceTF == evidenceTF and f_evidence_visible(r)
                int at = 0
                while at < array.size(selected)
                    if r.begins < array.get(selected, at).begins
                        break
                    at += 1
                array.insert(selected, at, r)
    if array.size(selected) == 0
        ActiveRange fallback = f_evidence_range(rows)
        if not na(fallback)
            array.push(selected, fallback)
    selected

f_evidence_clock(int opening) =>
    na(opening) ? "time unverified" : str.format_time(opening, "MMM d HH:mm", TZ)

f_evidence_candle_name(EvidenceCandle bar) =>
    evidenceAssignedTF == "1D" and not na(bar.tradingDay) ? str.format_time(bar.tradingDay, "EEE MMM d", "UTC") : f_evidence_clock(bar.s)

f_evidence_tf_name(string tf) =>
    tf == "" ? "Unmapped" : tf == "12M" ? "12M" : tf == "6M" ? "6M" : tf == "3M" ? "3M" : tf == "240" ? "H4" : tf == "60" ? "H1" : tf == "1D" ? "D1" : tf == "1W" ? "W1" : tf == "1M" ? "MN1" : "M" + tf

string evidenceParentName = f_evidence_tf_name(evidenceTF)
string evidenceAssignedName = f_evidence_tf_name(evidenceAssignedTF)

f_parent_state(ActiveRange r) =>
    r.retiredReason == 3 ? "Coverage unverified" : r.retiredReason == 2 ? "Objective reached" : not na(r.invalidAt) or r.retiredReason == 1 ? "Invalidated" : r.forming ? "Developing · source close pending" : f_relevant(r) ? "Confirmed · opposing objective pending" : (r.upperPurged or r.lowerPurged) ? "Developing · strict-inside source close pending" : "Awaiting a strict purge"

// Assigned evidence is read-only with respect to the parent ActiveRange.
// Model 1 own-CRT failure preserves its identity and never invalidates parent.
f_assigned_evidence(ActiveRange r, array<EvidenceCandle> bars, int cutoff) =>
    EvidenceCandle model = na
    EvidenceCandle csd = na
    EvidenceCandle modelInvalid = na
    EvidenceCandle soup = na
    bool soupEligible = true
    bool continuous = true
    bool modelContinuous = true
    bool primaryCertain = false
    bool coveredStart = false
    bool bearish = r.upperPurged
    int expected = r.ends
    int observedThrough = na
    if not na(bars)
        for bar in bars
            if bar.s >= r.ends and bar.e <= cutoff and (na(r.invalidAt) or bar.e <= r.invalidAt)
                bool connected = f_gtop_chart_contiguous(expected, bar.s, bar.previousClose, bar.projectedOpen)
                coveredStart := coveredStart or (na(observedThrough) and connected)
                continuous := continuous and connected
                expected := bar.e
                observedThrough := bar.e
                if na(model) and (r.upperPurged != r.lowerPurged) and f_gtop_body_purge(bar.o, bar.h, bar.l, bar.c, bearish ? r.hi : r.lo, bearish)
                    model := bar
                    primaryCertain := coveredStart and continuous
                else if not na(model)
                    // A missing prefix limits first identity, not a witnessed
                    // CISD against this retained candle. A later gap still blocks.
                    modelContinuous := modelContinuous and connected
                    if continuous and na(soup) and na(csd) and na(modelInvalid) and soupEligible and f_gtop_soup_confirmation(bar.o, bar.h, bar.l, bar.c, model.h, model.l, bearish)
                        soup := bar
                    soupEligible := soupEligible and not (bearish ? bar.l < model.l : bar.h > model.h)
                    if modelContinuous and na(csd) and f_gtop_cisd(bar.c, model.h, model.l, bearish)
                        csd := bar
                    if modelContinuous and na(modelInvalid) and f_gtop_outside(bar.c, model.h, model.l)
                        modelInvalid := bar
    bool complete = coveredStart and continuous and not na(observedThrough) and observedThrough >= math.min(cutoff, nz(r.invalidAt, cutoff))
    [model, csd, modelInvalid, soup, primaryCertain, complete, observedThrough]

// Post-confirmation Soup condition is independent of Model 1 own-CRT validity.
// Fixed Soup extreme supplies the distance origin; original Model 1 height
// supplies the percentage scale. No tolerance or trade execution is inferred.
type SoupFollow
    string cleanliness = "clean"
    string functionStatus = "pending"
    float points = 0.0
    float percent = 0.0
    float modelPoints = 0.0
    float modelPercent = 0.0
    float closePoints = 0.0
    int outsideCloses = 0
    int degradedAt = na
    int repurgeOpen = na
    int equalTouchAt = na
    int targetOpen = na
    int targetAt = na
    int windowEnd = na
    bool complete = false
    bool terminalBound = false

f_soup_follow(ActiveRange r, EvidenceCandle model, EvidenceCandle soup, array<EvidenceCandle> bars, int cutoff, bool verified) =>
    SoupFollow q = SoupFollow.new()
    bool bearish = r.upperPurged
    float target = bearish ? r.lo : r.hi
    int stop = math.min(cutoff, nz(r.invalidAt, cutoff))
    if na(soup) or na(model) or not verified or model.h <= model.l or stop < soup.e
        q.cleanliness := "unverified"
        q.functionStatus := "unverified"
        q.points := na
        q.percent := na
        q.modelPoints := na
        q.modelPercent := na
        q.closePoints := na
        q.outsideCloses := na
    else
        q.windowEnd := soup.e
        bool earlierTarget = false
        for bar in bars
            if bar.s >= r.ends and bar.e <= soup.s and (bearish ? bar.l <= target : bar.h >= target)
                earlierTarget := true
        bool sameTarget = bearish ? soup.l <= target : soup.h >= target
        if earlierTarget
            q.functionStatus := "parent_objective_already_reached"
            q.complete := true
        else if sameTarget
            bool ordered = bearish ? soup.c <= target : soup.c >= target
            q.functionStatus := ordered ? "parent_objective_delivered" : "same_candle_order_unresolved"
            q.targetOpen := soup.s
            q.targetAt := soup.e
            q.complete := true
            q.terminalBound := not ordered
        else
            bool gap = false
            for bar in bars
                if bar.s >= soup.e and bar.e <= stop
                    if not f_gtop_chart_contiguous(q.windowEnd, bar.s, bar.previousClose, bar.projectedOpen)
                        gap := true
                        break
                    q.windowEnd := bar.e
                    float points = f_gtop_adverse_extension(bar.h, bar.l, soup.h, soup.l, bearish)
                    float modelPoints = f_gtop_adverse_extension(bar.h, bar.l, model.h, model.l, bearish)
                    bool hit = bearish ? bar.l <= target : bar.h >= target
                    if hit
                        q.targetOpen := bar.s
                        q.targetAt := bar.e
                        q.terminalBound := points > q.points or modelPoints > q.modelPoints
                    else
                        if points > 0 and na(q.degradedAt)
                            q.degradedAt := bar.e
                            q.repurgeOpen := bar.s
                        if (bearish ? bar.h == soup.h : bar.l == soup.l) and na(q.equalTouchAt)
                            q.equalTouchAt := bar.e
                        float closePoints = f_gtop_adverse_extension(bar.c, bar.c, model.h, model.l, bearish)
                        if closePoints > 0
                            q.outsideCloses += 1
                            q.closePoints := math.max(q.closePoints, closePoints)
                    q.points := math.max(q.points, points)
                    q.modelPoints := math.max(q.modelPoints, modelPoints)
                    if hit
                        break
            q.complete := not gap and (not na(q.targetAt) or q.windowEnd >= stop)
            q.functionStatus := not na(q.targetAt) ? "parent_objective_delivered" : not q.complete ? "unverified" : not na(r.invalidAt) and stop == r.invalidAt ? "parent_invalidated_before_delivery" : "pending"
            q.cleanliness := not na(q.degradedAt) ? "degraded" : q.complete and not q.terminalBound ? "clean" : "unverified"
            q.percent := f_gtop_extension_percent(q.points, model.h, model.l)
            q.modelPercent := f_gtop_extension_percent(q.modelPoints, model.h, model.l)
    q

f_json_time(int value) =>
    na(value) ? "null" : str.tostring(int(value / 1000))

f_json_price(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

f_soup_head(SoupFollow q) =>
    string condition = q.cleanliness == "degraded" ? "Degraded" : q.cleanliness == "clean" ? "Clean" : "Cleanliness unverified"
    string functionText = q.functionStatus == "parent_objective_delivered" ? "Parent objective delivered" : q.functionStatus == "pending" ? "Parent objective pending" : q.functionStatus == "parent_invalidated_before_delivery" ? "Parent invalidated before delivery" : q.functionStatus == "parent_objective_already_reached" ? "Parent objective preceded this Soup" : q.functionStatus == "same_candle_order_unresolved" ? "Parent delivery order unverified" : "Parent function unverified"
    condition + " · " + functionText

f_soup_detail(SoupFollow q, EvidenceCandle model, EvidenceCandle soup) =>
    string qualifier = not q.complete ? "Observed in retained coverage" : q.terminalBound ? "Full-bar upper bound" : "Maximum adverse extension"
    qualifier + " beyond Soup wick: " + f_json_price(q.points) + " points · " + str.tostring(q.percent, "#.0") + "% of original Model 1 range (height " + f_json_price(model.h - model.l) + ").\nStrict re-purge " + f_evidence_clock(q.repurgeOpen) + " · known " + f_evidence_clock(q.degradedAt) + ". Wicks count; touch does not.\nSeparate Model 1 extension " + f_json_price(q.modelPoints) + " · " + str.tostring(q.modelPercent, "#.0") + "%; adverse closes " + str.tostring(q.outsideCloses) + ".\nWindow " + f_evidence_clock(soup.e) + " – " + f_evidence_clock(q.windowEnd) + "; parent delivery " + f_evidence_clock(q.targetOpen) + ". No tolerance or trade result inferred."

f_metric(float value) =>
    na(value) ? "null" : str.tostring(value, "#.########")

f_soup_json(SoupFollow q) =>
    '{"cleanliness":"' + q.cleanliness + '","function_status":"' + q.functionStatus + '","max_adverse_points":' + f_metric(q.points) + ',"max_adverse_percent":' + f_metric(q.percent) + ',"model_boundary_points":' + f_metric(q.modelPoints) + ',"model_boundary_percent":' + f_metric(q.modelPercent) + ',"max_close_points":' + f_metric(q.closePoints) + ',"outside_close_count":' + (na(q.outsideCloses) ? "null" : str.tostring(q.outsideCloses)) + ',"degraded_at":' + f_json_time(q.degradedAt) + ',"repurge_open":' + f_json_time(q.repurgeOpen) + ',"equal_touch_at":' + f_json_time(q.equalTouchAt) + ',"target_open":' + f_json_time(q.targetOpen) + ',"target_at":' + f_json_time(q.targetAt) + ',"window_end":' + f_json_time(q.windowEnd) + ',"coverage_complete":' + str.tostring(q.complete) + ',"terminal_bar_bound":' + str.tostring(q.terminalBound) + '}'

f_context_parent(ActiveRange r, EvidenceCandle model, EvidenceCandle csd, EvidenceCandle modelInvalid, EvidenceCandle soup, SoupFollow follow, bool primary, bool complete, string variantDisplay) =>
    string definition = r.sourceTF == "240" ? (h4ChartMode ? "native_chart" : "gtop_ny_1_5_9") : "native_chart"
    string stateCode = r.retiredReason == 3 ? "coverage_unverified" : r.retiredReason == 2 ? "objective_reached" : not na(r.invalidAt) or r.retiredReason == 1 ? "invalidated" : r.forming ? "source_close_pending" : f_relevant(r) ? "confirmed" : r.upperPurged or r.lowerPurged ? "return_pending" : "awaiting_purge"
    string direction = r.upperPurged and not r.lowerPurged ? "bearish" : r.lowerPurged and not r.upperPurged ? "bullish" : "unresolved"
    string variant = str.startswith(variantDisplay, "Completed ") ? array.get(str.split(variantDisplay, " "), 1) : "unclassified"
    string shown = '{"state":"' + stateCode + '","direction":"' + direction + '","variant":"' + variant + '","v6_pending":' + str.tostring(r.resoupPending) + ',"purge_at":' + f_json_time(r.purgeClose) + ',"return_at":' + f_json_time(r.returnClose) + ',"invalid_at":' + f_json_time(r.invalidAt) + ',"objective_at":' + f_json_time(r.objectiveObservedAt) + ',"double_purge_at":' + f_json_time(r.doublePurgeAt) + ',"last_close_at":' + f_json_time(r.lastSourceClose) + ',"last_close":' + f_json_price(r.lastSourcePrice) + ',"model_at":' + (na(model) ? "null" : f_json_time(model.e)) + ',"cisd_at":' + (na(csd) ? "null" : f_json_time(csd.e)) + ',"model_invalid_open":' + (na(modelInvalid) ? "null" : f_json_time(modelInvalid.s)) + ',"model_invalid_at":' + (na(modelInvalid) ? "null" : f_json_time(modelInvalid.e)) + ',"primary_model_verified":' + str.tostring(primary) + ',"assigned_complete":' + str.tostring(complete) + ',"soup_at":' + (na(soup) ? "null" : f_json_time(soup.e)) + ',"soup_open":' + (na(soup) ? "null" : f_json_time(soup.s)) + ',"variant_display":"' + variantDisplay + '"}'
    shown := str.substring(shown, 0, str.length(shown) - 1) + ',"soup_follow_through":' + (na(soup) ? "null" : f_soup_json(follow)) + '}'
    '{"range_open":' + f_json_time(r.begins) + ',"range_end":' + f_json_time(r.ends) + ',"high":' + f_json_price(r.hi) + ',"low":' + f_json_price(r.lo) + ',"range_definition":"' + definition + '","coverage":"' + (r.retiredReason == 3 or r.forming ? "unverified" : "closed_source") + '","butterfly":' + shown + '}'

f_context_packet(string parents, string overview, int earliest) =>
    string candles = ""
    string calendar = ""
    if not na(assignedEvidence)
        int first = math.max(0, array.size(assignedEvidence) - 192)
        if first < array.size(assignedEvidence)
            for i = first to array.size(assignedEvidence) - 1
                EvidenceCandle bar = array.get(assignedEvidence, i)
                if bar.s >= earliest and bar.e <= statusKnownEnd
                    candles += (candles == "" ? "" : ",") + "[" + f_json_time(bar.s) + "," + f_json_time(bar.e) + "," + f_json_price(bar.o) + "," + f_json_price(bar.h) + "," + f_json_price(bar.l) + "," + f_json_price(bar.c) + "]"
                    calendar += (calendar == "" ? "" : ",") + "[" + f_json_time(bar.s) + "," + f_json_time(bar.previousClose) + "," + f_json_time(bar.projectedOpen) + "," + f_json_time(bar.tradingDay) + "]"
    '{"schema":"gtop.chart.v3","context":{"rules_version":"' + GTOP_RULESET_VERSION + '","rules_hash":"' + GTOP_RULESET_SHA256 + '","source":"TradingView","symbol":"' + syminfo.tickerid + '","chart_tf":"' + timeframe.period + '","range_tf":"' + evidenceTF + '","cutoff":' + f_json_time(statusKnownEnd) + ',"captured_at":' + f_json_time(timenow) + ',"timezone":"' + TZ + '","assigned_tf":"' + evidenceAssignedTF + '"},"bars":[' + candles + '],"calendar":[' + calendar + '],"parents":[' + parents + '],"overview":[' + overview + ']}'

// Deduplicate a verified event by type/timeframe and candle opening. Every parent
// association remains in the visible label and its independent hover details.
type EvidenceEvent
    int x
    float y
    string title
    string detail
    bool above
    string parentName

f_evidence_marker(array<string> keys, array<label> marks, array<string> tips, int x, float y, string title, string detail, bool above, string parentName) =>
    if evidenceMarkers and not na(x) and not na(y)
        string key = title + ":" + str.tostring(x)
        int found = array.indexof(keys, key)
        if found >= 0
            label shared = array.get(marks, found)
            label.set_text(shared, label.get_text(shared) + " · " + parentName)
            string combined = array.get(tips, found) + "\n\nLinked parent: " + detail
            array.set(tips, found, combined)
            label.set_tooltip(shared, combined)
        else
            label created = label.new(x, y, title + "\n" + parentName, xloc=xloc.bar_time, style=above ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 15), textcolor=color.white, size=size.tiny, tooltip=detail, force_overlay=true)
            array.push(keys, key)
            array.push(marks, created)
            array.push(tips, detail)
            array.push(autoLabels, created)
    0

f_context_range_detail(ActiveRange r, string title, string variant) =>
    title + "\n" + variant + "\n" + f_json_price(r.lo) + " – " + f_json_price(r.hi) + "\n" + f_parent_state(r) + "\n" + (r.upperPurged ? "Sell-side " + f_json_price(r.lo) : "Buy-side " + f_json_price(r.hi)) + " objective pending"

f_context_overview(array<ActiveRange> rows, string tf) =>
    string packet = ""
    int count = 0
    if not na(rows)
        for r in rows
            if f_evidence_visible(r)
                count += 1
                if contextAlerts and barstate.isrealtime and barstate.isconfirmed
                    string definition = r.sourceTF == "240" and not h4ChartMode ? "gtop_ny_1_5_9" : "native_chart"
                    packet += (packet == "" ? "" : ",") + '{"range_tf":"' + r.sourceTF + '","range_open":' + f_json_time(r.begins) + ',"range_end":' + f_json_time(r.ends) + ',"high":' + f_json_price(r.hi) + ',"low":' + f_json_price(r.lo) + ',"range_definition":"' + definition + '","coverage":"' + (r.forming ? "unverified" : "closed_source") + '","direction":"' + (r.upperPurged ? "bearish" : "bullish") + '"}'
    [count == 0 ? "" : f_evidence_tf_name(tf) + " (" + str.tostring(count) + ")", packet]

// 8 detailed parents, 10 other layers with up to 8 ranges each, and headers/footer.
var table evidencePanel = table.new(f_note_free_position(position.top_right, position.middle_right), 1, 108, force_overlay=true)
f_evidence_cell(int row, string message, string detail, string fontSize, color background, color foreground = color.black) =>
    if evidenceOn
        table.cell(evidencePanel, 0, row, message, tooltip=detail, text_size=fontSize, text_halign=text.align_left, text_color=foreground, bgcolor=background)

f_evidence_range_cell(int row, ActiveRange r, int ordinal, string message, string detail, string fontSize, color background) =>
    bool selected = spotlightOn and ordinal == spotlightNumber
    if selected
        array.push(spotlightSelection, r)
    string prefix = spotlightOn ? (selected ? "▶ " : "") + "[" + str.tostring(ordinal) + "] " : ""
    f_evidence_cell(row, prefix + message, detail, fontSize, selected ? color.rgb(255,237,213) : background, color.rgb(185,28,28))
    if evidenceOn
        table.cell_set_text_formatting(evidencePanel, 0, row, selected ? text.format_bold : text.format_none)

f_show_evidence() =>
    table.clear(evidencePanel, 0, 0, 0, 107)
    array.clear(spotlightSelection)
    if evidenceNeeded
        array<ActiveRange> rows = evidenceTF == "60" ? visibleHourly : evidenceTF == "240" ? visibleH4 : evidenceTF == "1D" ? visibleDaily : evidenceTF == "1W" ? visibleWeekly : evidenceTF == "1M" ? visibleMonthly : evidenceTF == "3M" ? visible3M : evidenceTF == "6M" ? visible6M : evidenceTF == "12M" ? visible12M : evidenceTF == "15" ? visibleM15 : evidenceTF == "5" ? visibleM5 : visibleM3
        array<ActiveRange> parents = f_evidence_ranges(rows)
        array<string> keys = array.new<string>()
        array<label> marks = array.new<label>()
        array<string> tips = array.new<string>()
        array<EvidenceEvent> events = array.new<EvidenceEvent>()
        string packets = ""
        int earliest = statusKnownEnd
        bool parentClosePending = false
        string title = syminfo.tickerid + " · " + (evidenceTF == "60" ? "Shift context" : evidenceParentName + " context")
        f_evidence_cell(0, title, "", size.small, color.rgb(45,54,66), color.white)
        string overview = ""
        string overviewDetail = "Independent parents. Developing = source close pending. Hover each red range title for its bounds and status. History/layer bounds apply."
        string overviewPacket = ""
        for layer in evidenceLayers
            [layerText, layerPacket] = f_context_overview(layer.rows, layer.tf)
            if layerText != "" and layer.tf != evidenceTF
                overview += (overview == "" ? "" : " · ") + layerText
            if layerPacket != ""
                overviewPacket += (overviewPacket == "" ? "" : ",") + layerPacket
        f_evidence_cell(1, evidenceParentName + " ranges · " + evidenceAssignedName + " execution evidence" + (evidenceFocus == "Explicit parent layer" or evidenceAnchor != 0 ? " · selected" : ""), overviewDetail, size.tiny, color.new(color.silver, 20))
        if array.size(parents) == 0
            f_evidence_cell(2, "No active range in this layer", "Enable the layer, select an opening, or opt in to historical review. " + overviewDetail, size.small, color.white)
        else
            for parentIndex = 0 to array.size(parents) - 1
                ActiveRange r = array.get(parents, parentIndex)
                parentClosePending := parentClosePending or r.forming
                earliest := math.min(earliest, r.begins)
                string parentName = evidenceParentName + " " + (timeframe.in_seconds(r.sourceTF) >= 86400 ? array.last(str.split(r.title, " | ")) : f_evidence_clock(r.begins))
                bool bearish = r.upperPurged
                string variantDisplay = f_range_variant_title(r)
                string shiftName = r.sourceTF == "60" ? (hour(r.begins, TZ) >= 20 ? "Nightshift" : "Dayshift") + " · " : ""
                string identity = shiftName + variantDisplay + "\n" + f_range_tag_title(r)
                string state = f_parent_state(r)
                string compactState = f_json_price(r.lo) + " – " + f_json_price(r.hi) + "\n" + state
                if r.retiredReason == 0 and r.upperPurged != r.lowerPurged
                    compactState += "\n" + (bearish ? "Sell-side " + f_json_price(r.lo) : "Buy-side " + f_json_price(r.hi)) + " pending"
                string chronology = "Range opened " + f_evidence_clock(r.begins) + "\nPurge " + f_evidence_clock(r.purgeOpen) + "\nStrict-inside return " + f_evidence_clock(r.returnOpen) + " · confirmed " + f_evidence_clock(r.returnClose) + "\nLast own-source close " + f_evidence_clock(r.lastSourceClose) + " at " + f_json_price(r.lastSourcePrice)
                if not na(r.invalidAt)
                    chronology += "\nParent invalidation known " + f_evidence_clock(r.invalidAt)
                f_evidence_range_cell(2 + parentIndex * 3, r, parentIndex + 1, identity, state + "\n" + chronology, size.small, color.rgb(231,236,241))
                f_evidence_cell(3 + parentIndex * 3, compactState, chronology, size.small, color.white)
                [model, csd, modelInvalid, soup, primaryCertain, complete, observedThrough] = f_assigned_evidence(r, assignedEvidence, statusKnownEnd)
                SoupFollow follow = f_soup_follow(r, model, soup, assignedEvidence, statusKnownEnd, primaryCertain)
                string lower = evidenceAssignedName + ": "
                string lowerDetail = "Parent closes: " + evidenceParentName + " only. Model 1 identity, CISD and execution differ. Soup needs closed-OHLC proof; ambiguity stays unverified. No paired SMT.\nEvidence through " + f_evidence_clock(observedThrough) + "; bounded to 512 closed candles."
                if not na(model)
                    lowerDetail += "\nModel 1 known at its " + f_evidence_clock(model.e) + " close.\nSuper Soup assesses the Model 1 candle range: " + f_json_price(model.l) + " – " + f_json_price(model.h)
                    if not na(modelInvalid)
                        lowerDetail += "\nModel 1 range invalidation: " + f_evidence_clock(modelInvalid.s) + " candle closed " + f_evidence_clock(modelInvalid.e) + " at " + f_json_price(modelInvalid.c) + "; independent of parent validity, Soup formation/cleanliness and member entry."
                if na(model)
                    lower += evidenceAssignedTF == "" ? "No assigned mapping" : (r.upperPurged or r.lowerPurged) ? (complete ? "No Model 1 observed" : "Evidence incomplete · closed history needed") : "Awaiting directional purge"
                else
                    lower += "Model 1 · " + f_evidence_candle_name(model) + (primaryCertain ? "" : " · first unverified")
                    lower += not na(csd) ? "\nCISD confirmed · " + f_evidence_candle_name(csd) + " · Model 1 validated" : complete ? "\nCISD pending · close " + (bearish ? "below " + str.tostring(model.l, format.mintick) : "above " + str.tostring(model.h, format.mintick)) : "\nCISD unverified · more closed evidence needed"
                    lower += not na(soup) ? "\nSuper Soup · " + f_soup_head(follow) : "\nSuper Soup · Not established"
                    if not na(soup)
                        lowerDetail += "\nSuper Soup " + f_evidence_candle_name(soup) + " · " + f_soup_head(follow) + "\n" + f_soup_detail(follow, model, soup)
                    if evidenceModel
                        array.push(events, EvidenceEvent.new(model.s, bearish ? model.h : model.l, "Model 1 · " + evidenceAssignedName, identity + "\n" + f_evidence_candle_name(model) + " · body purge identified\n" + lowerDetail, bearish, parentName))
                    if evidenceCisd and not na(csd)
                        array.push(events, EvidenceEvent.new(csd.s, csd.c, "CISD · " + evidenceAssignedName, identity + "\nModel 1 validated by " + f_evidence_candle_name(csd) + "\nStrict full-extreme close known " + f_evidence_clock(csd.e) + "\nParent validity unchanged by this lower close", not bearish, parentName))
                    if evidenceSoup and not na(soup)
                        array.push(events, EvidenceEvent.new(soup.s, bearish ? soup.h : soup.l, "Super Soup · " + evidenceAssignedName, identity + "\n" + f_evidence_candle_name(soup) + " · verified Model 1 range purge and return/delivery\n" + lowerDetail, bearish, parentName))
                f_evidence_cell(4 + parentIndex * 3, lower, lowerDetail, size.small, color.white)
                if contextAlerts and barstate.isrealtime and barstate.isconfirmed and r.ends <= statusKnownEnd
                    packets += (packets == "" ? "" : ",") + f_context_parent(r, model, csd, modelInvalid, soup, follow, primaryCertain, complete, variantDisplay)
            for event in events
                f_evidence_marker(keys, marks, tips, event.x, event.y, event.title, event.detail, event.above, event.parentName)
            if contextAlerts and barstate.isrealtime and barstate.isconfirmed and packets != ""
                string packet = f_context_packet(packets, overviewPacket, earliest)
                if str.length(packet) <= 40960
                    alert(packet, alert.freq_once_per_bar_close)
                else
                    log.error("Chart capture exceeds the alert limit; no incomplete message sent.")
        int contextRow = math.max(3, 2 + array.size(parents) * 3)
        int contextOrdinal = array.size(parents)
        if overview != ""
            f_evidence_cell(contextRow, "Other context · " + overview, "Hover each range for its own bounds and status.", size.tiny, color.new(color.silver, 20))
            contextRow += 1
            for layer in evidenceLayers
                if layer.tf != evidenceTF and not na(layer.rows)
                    for r in layer.rows
                        if f_evidence_visible(r)
                            contextOrdinal += 1
                            string contextTitle = f_range_tag_title(r)
                            string contextVariant = f_range_variant_title(r)
                            f_evidence_range_cell(contextRow, r, contextOrdinal, contextTitle + "\n" + contextVariant, f_context_range_detail(r, contextTitle, contextVariant), size.tiny, contextRow % 2 == 0 ? color.white : color.rgb(231,236,241))
                            contextRow += 1
        string spotlightNotice = not spotlightOn ? "" : array.size(spotlightSelection) == 0 ? "Spotlight: range number unavailable\n" : not autoOn ? "Spotlight: range drawings hidden\n" : ""
        f_evidence_cell(contextRow, spotlightNotice + "Closed through " + f_evidence_clock(statusKnownEnd) + " NY · GTOP " + GTOP_RULESET_VERSION, "GBOP imports a fixed chart capture; no live refresh.", size.tiny, color.rgb(231,236,241))
    0



// RANGE ENGINE ---------------------------------------------------------------
type RangeSpec
    string title
    int firstHour
    int lastHour
    color ink
    bool monday

type RangeDrawing
    box area
    line upper
    line lower
    line middle
    bool alive = true
    int begins = na
    int ends = na
    float hi = na
    float lo = na
    string caption = ""
    string title = ""
    color ink = na
    bool partial = true
    bool completed = false

type RangeState
    int start = na
    int finish = na
    int lastDataEnd = na
    float hi = na
    float lo = na
    bool partial = false
    bool done = false
    RangeDrawing drawing = na

type EightWatch
    int start = na
    int finish = na
    int lastDataEnd = na
    float hi = na
    float lo = na
    bool partial = false
    bool ready = false
    bool upperSwept = false
    bool lowerSwept = false
    bool invalidated = false
    string invalidationSide = ""

var EightWatch watchAM = EightWatch.new()
var EightWatch watchPM = EightWatch.new()
// 0/1: AM buy/sell-side sweep; 2: AM invalidation; 3/4/5: corresponding PM.
// Reset each chart execution; observations are reconstructed on live rollback.
var array<bool> observations = array.new<bool>(6, false)
array.fill(observations, false)

f_watch(EightWatch watch, int t, int tc, float h, float l, float c, bool sampleConfirmed, int anchorHour, int bitOffset) =>
    int s = f_stamp(t, 0, anchorHour)
    int e = f_stamp(t, 0, anchorHour + 1)
    int shiftEnd = f_stamp(t, 0, anchorHour + 4)
    if t >= s and t < e
        if na(watch.start) or watch.start != s
            watch.start := s
            watch.finish := e
            watch.hi := h
            watch.lo := l
            watch.partial := t > s
            watch.ready := false
            watch.upperSwept := false
            watch.lowerSwept := false
            watch.invalidated := false
            watch.invalidationSide := ""
        else
            watch.partial := watch.partial or (not na(watch.lastDataEnd) and t > watch.lastDataEnd)
            watch.hi := math.max(watch.hi, h)
            watch.lo := math.min(watch.lo, l)
        watch.lastDataEnd := tc
    else if watch.start == s and t >= e and t < shiftEnd
        if not watch.ready
            watch.partial := watch.partial or watch.lastDataEnd < e
            watch.ready := true
        if not watch.partial and not watch.invalidated
            if h > watch.hi and not watch.upperSwept
                watch.upperSwept := true
                array.set(observations, bitOffset, true)
            if l < watch.lo and not watch.lowerSwept
                watch.lowerSwept := true
                array.set(observations, bitOffset + 1, true)
            int hourEnd = f_stamp(t, 0, hour(t, TZ) + 1)
            bool closedHour = tc == hourEnd and sampleConfirmed
            if closedHour and (c > watch.hi or c < watch.lo)
                watch.invalidated := true
                watch.invalidationSide := c > watch.hi ? "above" : "below"
                array.set(observations, bitOffset + 2, true)
    0

var array<RangeSpec> specs = array.new<RangeSpec>()
var array<RangeState> states = array.new<RangeState>()
var array<RangeDrawing> history = array.new<RangeDrawing>()
var array<box> ribbons = array.new<box>()
// Keep one previous box per row so equal off-hours across a closed-market gap
// become one visible block/label instead of several squeezed labels.
var array<box> lastRibbonByRow = array.new<box>(2, na)
var array<string> lastRibbonTitle = array.new<string>(2, "")
var array<color> lastRibbonInk = array.new<color>(2, na)

f_register(bool enabled, string title, int firstHour, int lastHour, color ink, bool isMonday=false) =>
    if enabled and showRanges and intradayClock
        array.push(specs, RangeSpec.new(title, firstHour, lastHour, ink, isMonday))
        array.push(states, RangeState.new())
    0

if barstate.isfirst
    f_register(cbdrOn, "CBDR 2-8 PM", 14, 20, cbdrColor)
    f_register(h4aOn, "Asia Expansion 1-5 AM", 1, 5, h4aColor)
    f_register(h4bOn, "London Lunch 5-9 AM", 5, 9, h4bColor)
    f_register(gctOn, "GCT / New York AM 9 AM-1 PM", 9, 13, gctColor)
    f_register(h4dOn, "New York PM 1-5 PM", 13, 17, h4dColor)
    f_register(h4eOn, "CBDR + Early Asia 5-9 PM", 17, 21, h4eColor)
    f_register(h4fOn, "Asia Open 9 PM-1 AM", 21, 25, h4fColor)
    f_register(mondayOn, "Monday", 0, 24, mondayColor, true)
    f_register(am8, "8 AM", 8, 9, am8Color)
    f_register(am9, "9 AM", 9, 10, am9Color)
    f_register(am10, "10 AM", 10, 11, am10Color)
    f_register(am11, "11 AM", 11, 12, am11Color)
    f_register(pm8, "8 PM", 20, 21, pm8Color)
    f_register(pm9, "9 PM", 21, 22, pm9Color)
    f_register(pm10, "10 PM", 22, 23, pm10Color)
    f_register(pm11, "11 PM", 23, 24, pm11Color)
    f_register(am7, "7 AM", 7, 8, am7Color)
    f_register(pm7, "7 PM", 19, 20, pm7Color)

f_caption(RangeSpec spec, RangeState state) =>
    rangeLabels ? spec.title + (rangeWidths ? " | width " + str.tostring(state.hi - state.lo, format.mintick) : "") + (state.partial ? " | PARTIAL" : "") + (state.done ? "" : " | forming") : ""

f_capture_scheduled(RangeDrawing drawing, RangeSpec spec, RangeState state, int rightX) =>
    drawing.begins := state.start
    drawing.ends := rightX
    drawing.hi := state.hi
    drawing.lo := state.lo
    drawing.caption := f_caption(spec, state)
    drawing.title := spec.title
    drawing.ink := spec.ink
    drawing.partial := state.partial
    drawing.completed := state.done
    0

f_render_scheduled(int visibleEnd) =>
    array<int> starts = array.new<int>()
    for drawing in history
        box.delete(drawing.area)
        line.delete(drawing.upper)
        line.delete(drawing.lower)
        line.delete(drawing.middle)
        drawing.area := na
        drawing.upper := na
        drawing.lower := na
        drawing.middle := na
        array.push(starts, drawing.begins)
    for index in array.sort_indices(starts, order.ascending)
        RangeDrawing drawing = array.get(history, index)
        bool visible = drawing.alive and not na(drawing.begins) and drawing.begins < visibleEnd and drawing.ends > recentLeft
        if visible and f_claim_range_slot()
            drawing.area := box.new(drawing.begins, drawing.hi, drawing.ends, drawing.lo, xloc=xloc.bar_time, border_color=rangeGuideColor, border_width=edgeWidth, border_style=line.style_solid, bgcolor=color.new(drawing.ink, fillFade), force_overlay=true)
            if drawing.caption != ""
                array.push(autoLabels, f_range_info(drawing.area, drawing.caption, drawing.ink, drawing.title))
            if midpoints
                drawing.middle := line.new(drawing.begins, math.avg(drawing.hi, drawing.lo), drawing.ends, math.avg(drawing.hi, drawing.lo), xloc=xloc.bar_time, color=color.new(drawing.ink, 30), style=line.style_dotted, force_overlay=true)
    0

f_prune() =>
    if array.size(history) > rangeKeep
        RangeDrawing old = array.shift(history)
        box.delete(old.area)
        line.delete(old.upper)
        line.delete(old.lower)
        line.delete(old.middle)
        // State and history share this object reference. Mark it dead so a
        // long active range never tries to update an evicted drawing.
        old.alive := false
    0

f_finish(RangeSpec spec, RangeState state) =>
    if not na(state.start) and not state.done
        state.partial := state.partial or na(state.lastDataEnd) or state.lastDataEnd < state.finish
        state.done := true
        int visibleEnd = nz(headClose, headOpen + int(chartSeconds * 1000))
        if not na(state.drawing) and state.drawing.alive and state.finish <= visibleEnd
            f_capture_scheduled(state.drawing, spec, state, state.finish)
    0

f_sample(int t, int tc, float h, float l, float c, int dailyStart, int dailyFinish, int tradingDow, bool sampleConfirmed) =>
    if (observeEight or showFocus) and t >= observationLeft
        f_watch(watchAM, t, tc, h, l, c, sampleConfirmed, 8, 0)
        f_watch(watchPM, t, tc, h, l, c, sampleConfirmed, 20, 3)
    if array.size(specs) > 0 and tc > calculationLeft and t < calculationRight
        for i = 0 to array.size(specs) - 1
            RangeSpec spec = array.get(specs, i)
            RangeState state = array.get(states, i)
            if not na(state.finish) and t >= state.finish
                f_finish(spec, state)
            [s0, e0] = f_window(t, spec.firstHour, spec.lastHour)
            int s = s0
            int e = e0
            bool weekdayOK = true
            if spec.monday
                if mondayClock == "Exchange trading day"
                    s := dailyStart
                    e := dailyFinish
                    weekdayOK := tradingDow == dayofweek.monday
                else
                    weekdayOK := dayofweek(t, TZ) == dayofweek.monday
            bool inside = weekdayOK and t >= s and t < e
            bool eligible = s < nz(headClose, headOpen + int(chartSeconds * 1000)) and e >= calculationLeft
            if inside and eligible
                if na(state.start) or state.start != s
                    state.start := s
                    state.finish := e
                    state.hi := h
                    state.lo := l
                    state.partial := t > s
                    state.done := false
                    state.drawing := na
                else
                    state.hi := math.max(state.hi, h)
                    state.lo := math.min(state.lo, l)
                    state.partial := state.partial or (not na(state.lastDataEnd) and t > state.lastDataEnd)
                state.lastDataEnd := tc
                int rightX = math.min(tc, e)
                if barstate.isrealtime
                    rightX := math.min(rightX, timenow)
                int visibleEnd = nz(headClose, headOpen + int(chartSeconds * 1000))
                // Retain scheduled drawings at the available main head. Their
                // mutable price state remains independent of display retention.
                bool visible = e >= recentLeft and tc <= visibleEnd
                if visible
                    if na(state.drawing) or not state.drawing.alive
                        state.drawing := RangeDrawing.new(na, na, na, na)
                        array.push(history, state.drawing)
                        f_prune()
                    f_capture_scheduled(state.drawing, spec, state, rightX)
                if tc >= e and sampleConfirmed
                    f_finish(spec, state)
    0

// Use chart OHLC only when the entire chart bar lies within one wall-clock
// hour. Every intraday GTOP boundary is on that clock, so no price leaks across
// boundaries. Otherwise process ALL available intrabars, not a single sample.
int nextClockHour = f_stamp(time, 0, hour(time, TZ) + 1)
bool nativeSafe = chartSeconds <= 3600 and time_close <= nextClockHour
bool inCalculation = time_close > calculationLeft and time < calculationRight
bool needsSamples = intradayClock and (inCalculation or ((observeEight or showFocus) and time_close > observationLeft))
// Missing-sample notice covers the retained recent window. Range partialness
// is independent and is never cleared by expiration of this display evidence.
var array<int> missingTimes = array.new<int>()
while array.size(missingTimes) > 0 and array.first(missingTimes) < recentLeft
    array.shift(missingTimes)
while array.size(missingTimes) > 0 and array.last(missingTimes) > headOpen
    array.pop(missingTimes)
if needsSamples
    if nativeSafe
        f_sample(time, time_close, high, low, close, time("1D"), time_close("1D"), dayofweek(time_tradingday, "UTC"), barstate.isconfirmed)
    else if array.size(specs) > 0 or observeEight or showFocus
        string sampleTF = chartSeconds % 300 == 0 ? "5" : "1"
        [sampleT, sampleTC, sampleH, sampleL, sampleC, dailyS, dailyE, tradingD] = request.security_lower_tf(syminfo.tickerid, sampleTF, [time, time_close, high, low, close, time("1D"), time_close("1D"), dayofweek(time_tradingday, "UTC")], calc_bars_count=100000)
        if array.size(sampleT) > 0
            for j = 0 to array.size(sampleT) - 1
                f_sample(array.get(sampleT, j), array.get(sampleTC, j), array.get(sampleH, j), array.get(sampleL, j), array.get(sampleC, j), array.get(dailyS, j), array.get(dailyE, j), array.get(tradingD, j), barstate.isconfirmed or j < array.size(sampleT) - 1)
        else if not barstate.isrealtime
            if inCalculation and time >= recentLeft and (array.size(missingTimes) == 0 or array.last(missingTimes) != time)
                array.push(missingTimes, time)
            for state in states
                if not na(state.start) and not state.done
                    state.partial := true
            if not na(watchAM.start) and time < watchAM.finish + 10800000
                watchAM.partial := true
            if not na(watchPM.start) and time < watchPM.finish + 10800000
                watchPM.partial := true

alertcondition(observeEight and array.get(observations, 0), "8 AM buy-side swept", "GTOP: price exceeded the 8 AM range high during Day Shift on {{ticker}}. A sweep alone is not entry confirmation.")
alertcondition(observeEight and array.get(observations, 1), "8 AM sell-side swept", "GTOP: price exceeded the 8 AM range low during Day Shift on {{ticker}}. A sweep alone is not entry confirmation.")
alertcondition(observeEight and array.get(observations, 2), "8 AM range invalidated: hourly close", "GTOP: a completed hourly candle closed outside the 8 AM range on {{ticker}}. That 8 AM range is invalidated; review the next chronological range.")
alertcondition(observeEight and array.get(observations, 3), "8 PM buy-side swept", "GTOP: price exceeded the 8 PM range high during Nightshift on {{ticker}}. A sweep alone is not entry confirmation.")
alertcondition(observeEight and array.get(observations, 4), "8 PM sell-side swept", "GTOP: price exceeded the 8 PM range low during Nightshift on {{ticker}}. A sweep alone is not entry confirmation.")
alertcondition(observeEight and array.get(observations, 5), "8 PM range invalidated: hourly close", "GTOP: a completed hourly candle closed outside the 8 PM range on {{ticker}}. That 8 PM range is invalidated; review the next chronological range.")

// RIBBON ---------------------------------------------------------------------
// True time coordinates align with candles; price coordinates keep this slim
// strip inside the main chart. The clock never changes the underlying OHLC.
float visibleRange = math.max(nz(visibleHigh, high) - nz(visibleLow, low), syminfo.mintick * 50)
float ribbonHeight = visibleRange * stripHeight / 100.0 * (showShifts and showH4Ribbon ? 2.0 : 1.0)
float ribbonBottom = nz(ribbonLow, nz(visibleLow, low)) - visibleRange * stripGap / 100.0 - ribbonHeight
int rightClockHour = hour(headOpen, TZ)
int currentBlockEnd = f_stamp(headOpen, 0, rightClockHour < 9 ? 9 : rightClockHour < 12 ? 12 : rightClockHour < 21 ? 21 : 24)
int ribbonRight = nz(headClose, headOpen + int(chartSeconds * 1000))
ribbonRight := projectClock ? f_stamp(headOpen, 1, 0) : finishCurrentBlock ? math.max(ribbonRight, currentBlockEnd) : ribbonRight
f_y(float rowPosition) =>
    ribbonBottom + ribbonHeight * rowPosition

// Binary search counts actual visible bars, so weekends/session gaps do not
// distort the label density. This only controls text, never range prices.
f_visible_position(int t) =>
    int lo = 0
    int hi = array.size(visibleTimes)
    while lo < hi
        int mid = int(math.floor((lo + hi) / 2.0))
        if array.get(visibleTimes, mid) < t
            lo := mid + 1
        else
            hi := mid
    float result = 0.0
    if lo > 0
        int previous = lo - 1
        int starts = array.get(visibleTimes, previous)
        int ends = array.get(visibleCloses, previous)
        result := previous + math.min(1.0, math.max(0.0, (t - starts) / math.max(1.0, ends - starts)))
    if array.size(visibleCloses) > 0 and t > array.last(visibleCloses)
        result := array.size(visibleCloses) + (t - array.last(visibleCloses)) / (chartSeconds * 1000.0)
    result

f_short_title(string title) =>
    switch title
        "Human Max" => "Human Max"
        "Dayshift" => "Dayshift"
        "Nightshift" => "Nightshift"
        "Asia Expansion" => "ASIA"
        "London Lunch" => "LONDON"
        "New York AM / GCT" => "NY AM"
        "New York PM" => "NY PM"
        "CBDR + Early Asia" => "CBDR"
        "Asia Open" => "OPEN"
        => title

// Exact half-open window matching uses the original calendar boundaries, not
// viewport clipping or fixed 24-hour arithmetic. Only the main shift row calls it.
f_picked_shift_color(int s, int e, string title, color fallback) =>
    color result = fallback
    for slot = 0 to array.size(shiftPoints) - 1
        int point = array.get(shiftPoints, slot)
        string choice = array.get(shiftChoices, slot)
        if choice != "Off" and point > 0 and point >= s and point < e
            result := choice == "Custom" ? array.get(shiftColors, slot) : choice == "Bullish" ? bullColor : choice == "Bearish" ? bearColor : title == "Dayshift" ? dayNeutral : title == "Nightshift" ? nightNeutral : neutralColor
    result

// Dated choices affect one occurrence. Existing saved dot annotations retain
// their overlap priority until the member turns that slot Off. Off/Default and the master toggle never erase inputs.
f_dated_shift_color(int anchor, string title, string hours, color fallback) =>
    color result = fallback
    if not na(ribbonDate) and f_day(anchor) == ribbonDate
        bool early = hours == "12-9 AM"
        string choice = title == "Dayshift" ? ribbonDayChoice : title == "Nightshift" ? ribbonNightChoice : early ? ribbonEarlyChoice : ribbonLateChoice
        color custom = title == "Dayshift" ? ribbonDayCustom : title == "Nightshift" ? ribbonNightCustom : early ? ribbonEarlyCustom : ribbonLateCustom
        if choice != "Default"
            result := choice == "Custom" ? custom : choice == "Bullish" ? bullColor : choice == "Bearish" ? bearColor : title == "Dayshift" ? dayNeutral : title == "Nightshift" ? nightNeutral : neutralColor
    result

type RibbonSlot
    int firstHour
    int lastHour
    string title
    string hours
    string bias
    bool shift
    bool enabled = true

var array<RibbonSlot> ribbonSlots = array.from(RibbonSlot.new(0, 9, "Human Max", "12-9 AM", earlyBias, true, showEarly), RibbonSlot.new(9, 12, "Dayshift", "9 AM-12 PM", dayBias, true), RibbonSlot.new(12, 21, "Human Max", "12-9 PM", offBias, true), RibbonSlot.new(21, 24, "Nightshift", "9 PM-12 AM", nightBias, true), RibbonSlot.new(1, 5, "Asia Expansion", "1-5 AM", h4aBias, false), RibbonSlot.new(5, 9, "London Lunch", "5-9 AM", h4bBias, false), RibbonSlot.new(9, 13, "New York AM / GCT", "9 AM-1 PM", gctBias, false), RibbonSlot.new(13, 17, "New York PM", "1-5 PM", h4dBias, false), RibbonSlot.new(17, 21, "CBDR + Early Asia", "5-9 PM", h4eBias, false), RibbonSlot.new(21, 25, "Asia Open", "9 PM-1 AM", h4fBias, false))

f_ribbon(int s, int e, float top, float bottom, string title, string hours, string bias, int anchor) =>
    bool shiftRow = title == "Dayshift" or title == "Human Max" or title == "Nightshift"
    int row = shiftRow ? 0 : 1
    int leftX = math.max(s, shiftRow ? ribbonLeft : recentLeft)
    int rightX = math.min(e, ribbonRight)
    float leftPosition = rightX > leftX ? f_visible_position(leftX) : 0.0
    float rightPosition = rightX > leftX ? f_visible_position(rightX) : 0.0
    if rightX > leftX and rightPosition > leftPosition
        color ink = f_ink(bias, anchor)
        bool neutralSlot = bias == "Neutral" or (biasScope == "Selected date" and f_day(anchor) != f_day(biasDate))
        if neutralSlot
            ink := title == "Dayshift" ? dayNeutral : title == "Nightshift" ? nightNeutral : neutralColor
        // Explicit one-occurrence choices take priority; Default leaves legacy behavior intact.
        string recentBias = shiftRow ? f_recent_bias(anchor, title, hours) : "Default"
        if recentBias != "Default"
            ink := recentBias == "Bullish" ? bullColor : recentBias == "Bearish" ? bearColor : title == "Dayshift" ? dayNeutral : title == "Nightshift" ? nightNeutral : neutralColor
        if shiftRow
            ink := customShiftColors ? f_picked_shift_color(s, e, title, f_dated_shift_color(anchor, title, hours, ink)) : title == "Dayshift" ? dayNeutral : title == "Nightshift" ? nightNeutral : neutralColor
        box previous = array.get(lastRibbonByRow, row)
        // Only merge the compact name-only view; optional hour captions retain
        // their separate real time windows. Never merge different manual colors.
        bool joinPrevious = false
        if not ribbonTimes and not na(previous) and array.get(lastRibbonTitle, row) == title and array.get(lastRibbonInk, row) == ink
            int previousRight = box.get_right(previous)
            joinPrevious := leftX >= previousRight and leftPosition <= f_visible_position(previousRight)
        if joinPrevious
            leftX := box.get_left(previous)
            leftPosition := f_visible_position(leftX)
        float widthShare = (rightPosition - leftPosition) / math.max(1.0, array.size(visibleTimes))
        string displayTitle = title == "Human Max" ? "Human Max\n(Go Touch Grass, Be Human)" : title
        string caption = displayTitle + (ribbonTimes ? "\n" + hours : "")
        if autoRibbonLabels and widthShare < 0.07 and title != "Human Max"
            caption := widthShare < 0.025 ? "" : f_short_title(title) + (ribbonTimes and widthShare >= 0.055 ? "\n" + hours : "")
        if joinPrevious
            box.set_right(previous, rightX)
            box.set_text(previous, caption)
        else
            box b = box.new(leftX, f_y(top), rightX, f_y(bottom), xloc=xloc.bar_time, bgcolor=color.new(ink, ribbonFade), border_color=color.new(ribbonText, 65), border_width=1, text=caption, text_color=ribbonText, text_size=ribbonFont, text_halign=text.align_center, text_valign=text.align_center, text_wrap=text.wrap_auto, text_formatting=boldRibbon ? text.format_bold : text.format_none, force_overlay=true)
            array.push(ribbons, b)
            array.set(lastRibbonByRow, row, b)
            array.set(lastRibbonTitle, row, title)
            array.set(lastRibbonInk, row, ink)
    0

f_accent(int s, int e, float bottom) =>
    int leftX = math.max(s, ribbonLeft)
    int rightX = math.min(e, ribbonRight)
    if rightX > leftX and f_visible_position(rightX) > f_visible_position(leftX)
        box b = box.new(leftX, f_y(bottom + 0.035), rightX, f_y(bottom), xloc=xloc.bar_time, bgcolor=nineColor, border_color=color.new(nineColor, 100), force_overlay=true)
        array.push(ribbons, b)
    0

f_watch_text(EightWatch watch, string name) =>
    string watchCaption = name + ": waiting for range"
    if not na(watch.start)
        string dateText = str.format_time(watch.start, "MMM d", TZ)
        string status = watch.partial ? "PARTIAL data" : watch.invalidated ? "invalidated: H1 close " + watch.invalidationSide : not watch.ready ? "forming" : watch.upperSwept and watch.lowerSwept ? "both sides swept" : watch.upperSwept ? "buy-side swept" : watch.lowerSwept ? "sell-side swept" : "no sweep observed"
        watchCaption := name + " (" + dateText + ")\n" + status
    watchCaption

var box contextBox = na
var line objectiveLine = na
var label objectiveEye = na

var table notice = table.new(position.bottom_left, 1, 1)
var table focus = table.new(f_note_free_position(position.bottom_center, position.middle_left), 1, 3, force_overlay=true)
if barstate.islast
    box.delete(contextBox)
    line.delete(objectiveLine)
    label.delete(objectiveEye)
    contextBox := na
    objectiveLine := na
    objectiveEye := na
    int visibleEnd = nz(headClose, headOpen + int(chartSeconds * 1000))
    f_watermark()
    f_clear_active()
    // Panel selection resolves before drawing; both use the exact same range object.
    f_show_evidence()
    if autoOn
        // A single drawing callsite preserves source-array identity and order.
        // Construct fresh references each render; do not cache request snapshots.
        array<ActiveDrawLayer> drawLayers = array.from(ActiveDrawLayer.new(visibleChart, autoHourColor), ActiveDrawLayer.new(visibleM3, autoHourColor), ActiveDrawLayer.new(visibleM5, autoHourColor), ActiveDrawLayer.new(visibleM15, autoH4Color), ActiveDrawLayer.new(visibleHourly, autoHourColor), ActiveDrawLayer.new(visibleH4, autoH4Color), ActiveDrawLayer.new(visibleDaily, autoDayColor, true), ActiveDrawLayer.new(visibleWeekly, autoWeekColor, true), ActiveDrawLayer.new(visibleMonthly, autoMonthColor, true), ActiveDrawLayer.new(visible3M, autoMonthColor), ActiveDrawLayer.new(visible6M, autoMonthColor), ActiveDrawLayer.new(visible12M, autoMonthColor))
        // Spotlight gets one slot first; then the existing active/forming/history order.
        for drawPhase = 0 to 3
            int historyPass = drawPhase == 0 ? -2 : drawPhase == 1 ? 0 : drawPhase == 2 ? 2 : 1
            for layerIndex = 0 to (historyPass == -2 ? 0 : array.size(drawLayers) - 1)
                // Shift H1 and GTOP H4 history have first claim on remaining
                // slots; current/lower intraday archives cannot hide them.
                int drawIndex = historyPass == 1 ? (layerIndex < 2 ? layerIndex + 4 : layerIndex < 6 ? layerIndex - 2 : layerIndex) : layerIndex
                ActiveDrawLayer layer = historyPass == -2 ? ActiveDrawLayer.new(spotlightSelection, spotlightInk) : array.get(drawLayers, drawIndex)
                if historyPass != 2 or layer.formingPass
                    f_draw_active(layer.ranges, layer.ink, visibleEnd, historyPass)
    f_render_stack(visibleEnd)
    bool contextValid = not stackOn and contextSource != "Off" and not na(selectedContextHigh) and not na(selectedContextLow) and selectedContextHigh > selectedContextLow and selectedContextStart < visibleEnd and not na(selectedContextFinish) and selectedContextFinish > selectedContextStart
    if autoOn and contextValid and f_claim_range_slot()
        contextBox := box.new(selectedContextStart, selectedContextHigh, selectedContextFinish, selectedContextLow, xloc=xloc.bar_time, border_color=rangeGuideColor, border_width=1, bgcolor=color.new(contextColor, contextFade), force_overlay=true)
        array.push(autoLabels, f_range_info(contextBox, "Context | " + contextSource, color.new(targetColor, 15), "Context | " + contextSource))
    f_render_scheduled(visibleEnd)
    if array.size(ribbons) > 0
        for ribbon in ribbons
            box.delete(ribbon)
        array.clear(ribbons)
    array.fill(lastRibbonByRow, na)
    array.fill(lastRibbonTitle, "")
    array.fill(lastRibbonInk, na)
    float shiftTop = 0.99
    float shiftBottom = showH4Ribbon ? 0.99 - 0.96 * mainRowShare / 100.0 : 0.01
    float h4Top = showShifts ? shiftBottom - 0.025 : 0.99
    // Include the preceding evening so Asia Open remains continuous at 00:00.
    for k = -1 to visibleDays - 1
        int anchor = f_stamp(recentLeft, k, 0)
        if showShifts and ribbonChart
            for slot in ribbonSlots
                if slot.enabled and (slot.shift or showH4Ribbon)
                    f_ribbon(f_stamp(anchor, 0, slot.firstHour), f_stamp(anchor, 0, slot.lastHour), slot.shift ? shiftTop : h4Top, slot.shift ? shiftBottom : 0.01, slot.title, slot.hours, slot.bias, anchor)
                if slot.shift and slot.firstHour == 21 and emphasizeNine
                    f_accent(f_stamp(anchor, 0, 9), f_stamp(anchor, 0, 10), shiftBottom)
                    f_accent(f_stamp(anchor, 0, 21), f_stamp(anchor, 0, 22), shiftBottom)
    float objective = na
    int objectiveStart = na
    box objectiveArea = na
    string objectiveBaseCaption = ""
    string objectiveTitle = ""
    if targetSide != "Off"
        if targetSource == "Gray context" and contextValid and not na(contextBox)
            objective := targetSide == "High (buy-side)" ? selectedContextHigh : selectedContextLow
            objectiveStart := selectedContextFinish
            objectiveArea := contextBox
            objectiveBaseCaption := "Context | " + contextSource
            objectiveTitle := "Context | " + contextSource
        else if array.size(specs) > 0
            for i = 0 to array.size(specs) - 1
                RangeSpec spec = array.get(specs, i)
                RangeState state = array.get(states, i)
                if spec.title == targetSource and state.done and not state.partial and state.finish <= visibleEnd and not na(state.drawing) and not na(state.drawing.area)
                    objective := targetSide == "High (buy-side)" ? state.hi : state.lo
                    objectiveStart := state.finish
                    objectiveArea := state.drawing.area
                    objectiveBaseCaption := state.drawing.caption
                    objectiveTitle := state.drawing.title
        if autoOn and not na(objective)
            int objectiveEnd = visibleEnd + targetHours * 3600000
            objectiveLine := line.new(nz(objectiveStart, recentLeft), objective, objectiveEnd, objective, xloc=xloc.bar_time, color=rangeGuideColor, width=1, style=line.style_dashed, force_overlay=true)
            string objectiveCaption = "👀 " + targetSource + (targetSide == "High (buy-side)" ? " high" : " low")
            objectiveEye := f_dol_eye(objectiveLine, targetColor, objectiveTitle + "\n" + objectiveCaption + " | " + str.tostring(objective, format.mintick) + "\nManually selected objective; delivery is not automatically verified.")
            string existingCaption = objectiveBaseCaption
            if targetSource == "Gray context" or rangeLabels
                f_range_info(objectiveArea, existingCaption + (existingCaption == "" ? "" : "\n") + objectiveCaption + " | " + str.tostring(objective, format.mintick), targetColor, objectiveTitle)
    f_layout_range_titles()
    string warning = ""
    if selectH4 and not h4ChartMode and chartSeconds == 14400 and f_h4_misaligned(time, time_close)
        [gtopStart, gtopEnd] = f_gtop_h4_window(time)
        warning := "H4 candles differ · Chart " + f_h4_window_text(time, time_close) + " · GTOP " + f_h4_window_text(gtopStart, gtopEnd)
    if showShifts and ribbonChart and str.trim(ribbonDateText) != "" and na(ribbonDate)
        warning += (warning == "" ? "" : "\n") + "Ribbon date: use YYYY-MM-DD (1970-2200)."
    if showShifts and ribbonChart and na(recentReference)
        warning += (warning == "" ? "" : "\n") + "Advanced ribbon colors: enter a valid reference date as YYYY-MM-DD (1970-2200)."
    if autoOn and autoScope == "Manual layers" and chartSeconds > 3600 and autoH1
        warning += (warning == "" ? "" : "\n") + "Hourly shift CRTs: use H1 or lower. Context layers remain available."
    if autoOn and defaultLayers and parentChoice != "Automatic" and not parentValid
        warning += (warning == "" ? "" : "\n") + "Higher layer override must be above the chart TF. Showing the current layer only."

    if autoOn and not stackOn and contextSource == "Manual bounds" and not contextValid
        warning += (warning == "" ? "" : "\n") + "Set a valid manual context high, low, start and end time (end must follow start)."
    if autoOn and targetSide != "Off" and na(objective)
        warning += (warning == "" ? "" : "\n") + "👀 Objective unavailable: enable the selected range and wait for a complete, non-PARTIAL range."
    if autoOn and array.size(missingTimes) > 0
        warning += (warning == "" ? "" : "\n") + "Some recent intrabar history unavailable: affected ranges may be missing/PARTIAL. Use an aligned 1m-60m chart."
    // Final drawing pass only; no source scans, replay or loading-progress claim.
    string statusText = not rangeStatusOn ? "" : not autoOn ? "Range boxes off" : "Evaluated · " + str.tostring(array.size(autoBoxes)) + " automatic ranges drawn"
    string noticeText = statusText + (warning == "" ? "" : (statusText == "" ? "" : "\n") + warning)
    string statusDetail = rangeStatusOn ? "Drawing count only, excluding manual/context/scheduled boxes. Zero may reflect history bounds. Confirmed and forming evidence differ. Hover titles for facts." : ""
    table.set_position(notice, f_note_free_position(rangeStatusOn ? position.top_center : chartSeconds == 14400 ? position.bottom_center : position.bottom_left, position.middle_right))
    table.cell(notice, 0, 0, noticeText, text_color=color.rgb(231, 179, 90), text_size=size.tiny, bgcolor=noticeText == "" ? color.new(color.black, 100) : color.new(color.black, 15), tooltip=statusDetail)
    table.clear(focus, 0, 0, 0, 2)
    if showFocus
        table.cell(focus, 0, 0, "GTOP rules " + GTOP_RULESET_VERSION + " | latest chart bar\n" + str.format_time(time, "MMM d HH:mm", TZ), text_color=color.white, text_size=size.small, bgcolor=color.rgb(45, 54, 66))
        table.cell(focus, 0, 1, f_watch_text(watchAM, "8 AM"), text_color=color.white, text_size=size.small, bgcolor=color.new(neutralColor, 15))
        table.cell(focus, 0, 2, f_watch_text(watchPM, "8 PM"), text_color=color.white, text_size=size.small, bgcolor=color.new(neutralColor, 15))
