bool autoH4 = input.bool(false, "H4 (selected source)", inline="layers2", group=G_AUTO, active=autoScope == "Manual layers")
bool autoH1 = input.bool(false, "Hourly shift CRT", inline="layers2", group=G_AUTO, active=autoScope == "Manual layers")
bool autoM15 = input.bool(false, "M15", inline="layers3", group=G_AUTO, active=autoScope == "Manual layers")
bool autoM5 = input.bool(false, "M5", inline="layers3", group=G_AUTO, active=autoScope == "Manual layers")
bool autoM3 = input.bool(false, "M3 (3 minutes)", inline="layers3", group=G_AUTO, active=autoScope == "Manual layers")
bool autoChart = input.bool(false, "Other chart timeframes", inline="layers3", group=G_AUTO, tooltip="These layer toggles apply only in Manual layers mode. Layers lower than the chart are omitted. Other chart TFs means the current native chart TF outside the named ladder; the H4 source setting selects a single H4 layer.", active=autoScope == "Manual layers")
// autoLookback detail: Bounds available source history, not all history. H4 uses covered windows from the H4 source setting. H1 independently considers completed 08–11 and 20–23 GTOP hours. Waiting candidates stay hidden until qualified, including a later purge after the shift; pending ranges persist within this source-hour bound. Native session evidence and repeated boundary timing distinguish ordinary closures; inconsistent coverage stays unverified.
int autoLookback = input.int(120, "Source ranges to consider per layer", minval=12, maxval=240, group=G_AUTO, tooltip="Source-history bound. H1 origins: 08–11 and 20–23 NY; they may qualify later, outside the shift. H4 follows its source setting. Missing or inconsistent coverage stays unverified.")
// autoKeep detail: Applies AFTER the purge-and-pending-DOL test. The oldest surviving relevant ranges keep priority; newer untouched candles never displace them. Raise this to show more concurrent relevant ranges. H1 qualified anchors can coexist within and across shifts. This per-layer cap still limits their visible count.
int autoKeep = input.int(3, "Relevant ranges per context layer (oldest first)", minval=1, maxval=8, group=G_AUTO, tooltip="Per-layer cap after qualification. Oldest relevant ranges keep priority. H1 ranges may coexist within/across shifts; untouched candles do not displace them.")
bool autoDol = input.bool(true, "Extend draw on liquidity only", group=G_AUTO, tooltip="Extends the pending opposite extreme after a one-side purge. Untouched ranges stay hidden; completed archives receive no DOL extension. History may show their fixed source boxes. No paired high/low extensions.")
